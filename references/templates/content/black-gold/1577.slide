<Slide>
  {/* black-gold/1577 里程碑之旅：金色主线 + 五个时间节点 + 底部标语 */}
  <Box style={{ height: 720, width: 1280, background: '#000000', padding: 'xxl xl', alignItems: 'center', justifyContent: 'center' }}>
    <Text style={{ fontSize: 'title', color: '#FBBF24', bold: true, marginBottom: 'xl' }}>{/* {{替换：标题}} */}里程碑之旅</Text>
    {/* 时间轴 */}
    <Box style={{ width: '100%', position: 'relative', marginBottom: 'xl' }}>
      {/* 中央金色主线 */}
      <Box style={{ position: 'absolute', left: 40, right: 40, top: 52, height: 4, background: 'linear-gradient(90deg, #CA8A04 0%, #D97706 50%, #CA8A04 100%)' }} />
      <Box style={{ flexDirection: 'row', justifyContent: 'space-between' }}>
        {[
          ['01', '起航', '2020', 96, false],
          ['02', '突破', '2021', 104, false],
          ['03', '巅峰', '2022', 120, true],
          ['04', '领航', '2023', 104, false],
          ['05', '传奇', '2024+', 96, false],
        ].map((x, i) => (
          <Box key={i} style={{ alignItems: 'center' }}>
            <Box style={{ width: x[3], height: x[3], borderRadius: x[3] / 2, background: 'linear-gradient(135deg, #FBBF24 0%, #D97706 100%)', border: '4px solid #000000', alignItems: 'center', justifyContent: 'center', boxShadow: '0 16px 48px rgba(0,0,0,0.28)' }}>
              <Box style={{ position: 'absolute', width: x[3] - 16, height: x[3] - 16, borderRadius: (x[3] - 16) / 2, border: '2px solid rgba(253,230,138,0.5)' }} />
              {i === 2 && <Emoji name="👑" style={{ position: 'absolute', top: -28, width: 28, height: 28 }} />}
              <Text style={{ fontSize: 'card', color: '#000000', bold: true }}>{/* {{替换：编号}} */}{x[0]}</Text>
            </Box>
            <Box style={{ background: x[4] ? 'linear-gradient(135deg, rgba(113,63,18,0.8) 0%, rgba(120,53,15,0.8) 100%)' : 'rgba(0,0,0,0.8)', border: x[4] ? '4px solid #EAB308' : '1px solid rgba(202,138,4,0.3)', borderRadius: 'sm', padding: 'xs md', marginTop: 'sm', alignItems: 'center', boxShadow: x[4] ? '0 12px 36px rgba(0,0,0,0.22)' : undefined }}>
              <Text style={{ fontSize: 'body', color: x[4] ? '#FDE68A' : '#FBBF24', bold: true }}>{/* {{替换：里程碑名}} */}{x[1]}</Text>
              <Text style={{ fontSize: 'label', color: x[4] ? '#FBBF24' : '#9CA3AF', bold: x[4] }}>{/* {{替换：年份}} */}{x[2]}</Text>
            </Box>
          </Box>
        ))}
      </Box>
    </Box>
    {/* 底部标语 */}
    <Text style={{ fontSize: 'body', color: '#FBBF24', letterSpacing: 2 }}>{/* {{替换：标语}} */}每一步都铸就辉煌 · 每一刻都书写传奇</Text>
  </Box>
</Slide>
