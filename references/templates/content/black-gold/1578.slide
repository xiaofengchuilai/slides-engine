<Slide>
  {/* black-gold/1578 臻选尊享系列：三张会员卡扇形排布 + 底部说明 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #111827 0%, #000000 50%, #111827 100%)', padding: 'xl', alignItems: 'center', justifyContent: 'center' }}>
    <Text style={{ fontSize: 'title', color: '#FBBF24', bold: true, marginBottom: 'lg' }}>{/* {{替换：标题}} */}臻选尊享系列</Text>
    {/* 三张卡片（绝对定位重叠扇形） */}
    <Box style={{ position: 'relative', width: 1080, height: 400, marginBottom: 'lg' }}>
      {/* 左侧白金卡 */}
      <Box style={{ position: 'absolute', left: 60, top: 30, width: 300, height: 340, background: 'linear-gradient(135deg, #1F2937 0%, #000000 100%)', borderRadius: 'md', border: '3px solid rgba(202,138,4,0.5)', padding: 'lg', flexDirection: 'column', justifyContent: 'space-between', boxShadow: '0 16px 48px rgba(0,0,0,0.28)', rotate: -12 }}>
        <Box>
          <Box style={{ width: 48, height: 32, background: 'linear-gradient(135deg, #FBBF24 0%, #D97706 100%)', borderRadius: 'sm', marginBottom: 'md' }} />
          <Text style={{ fontSize: 'label', color: '#FBBF24', letterSpacing: 1, marginBottom: 'xs' }}>{/* {{替换：卡类型}} */}PLATINUM MEMBER</Text>
          <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>{/* {{替换：卡名}} */}白金会员</Text>
        </Box>
        <Box>
          <Text style={{ fontSize: 'label', color: '#FBBF24', letterSpacing: 1, marginBottom: 'sm' }}>{/* {{替换：卡号}} */}**** **** **** 1001</Text>
          <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
            <Box>
              <Text style={{ fontSize: 'label', color: '#6B7280', marginBottom: 'xs' }}>{/* {{替换：起始标签}} */}SINCE</Text>
              <Text style={{ fontSize: 'body', color: '#FFFFFF' }}>{/* {{替换：起始值}} */}2020</Text>
            </Box>
            <FAIcon name="gem" style={{ fill: '#FBBF24', width: 22, height: 22 }} />
          </Box>
        </Box>
      </Box>
      {/* 中央钻石卡 */}
      <Box style={{ position: 'absolute', left: 390, top: 0, width: 320, height: 400, background: 'linear-gradient(135deg, #CA8A04 0%, #B45309 50%, #92400E 100%)', borderRadius: 'md', border: '4px solid #FBBF24', padding: 'lg', flexDirection: 'column', justifyContent: 'space-between', boxShadow: '0 16px 48px rgba(0,0,0,0.28)' }}>
        <Box>
          <Emoji name="👑" style={{ width: 36, height: 36, marginBottom: 'xs' }} />
          <Text style={{ fontSize: 'label', color: '#FEF3C7', letterSpacing: 1, marginBottom: 'xs' }}>{/* {{替换：卡类型}} */}DIAMOND ELITE</Text>
          <Text style={{ fontSize: 'title', color: '#000000', bold: true }}>{/* {{替换：卡名}} */}钻石尊享</Text>
        </Box>
        <Box>
          <Text style={{ fontSize: 'card', color: '#000000', letterSpacing: 1, marginBottom: 'sm' }}>{/* {{替换：卡号}} */}**** **** **** 0001</Text>
          <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
            <Box>
              <Text style={{ fontSize: 'label', color: '#78350F', marginBottom: 'xs' }}>{/* {{替换：有效期标签}} */}VALID THRU</Text>
              <Text style={{ fontSize: 'card', color: '#000000', bold: true }}>{/* {{替换：有效期值}} */}LIFETIME</Text>
            </Box>
            <Emoji name="💎" style={{ width: 26, height: 26 }} />
          </Box>
        </Box>
      </Box>
      {/* 右侧黄金卡 */}
      <Box style={{ position: 'absolute', right: 60, top: 30, width: 300, height: 340, background: 'linear-gradient(135deg, #1F2937 0%, #000000 100%)', borderRadius: 'md', border: '3px solid rgba(202,138,4,0.5)', padding: 'lg', flexDirection: 'column', justifyContent: 'space-between', boxShadow: '0 16px 48px rgba(0,0,0,0.28)', rotate: 12 }}>
        <Box>
          <Box style={{ width: 48, height: 32, background: 'linear-gradient(135deg, #FBBF24 0%, #D97706 100%)', borderRadius: 'sm', marginBottom: 'md' }} />
          <Text style={{ fontSize: 'label', color: '#FBBF24', letterSpacing: 1, marginBottom: 'xs' }}>{/* {{替换：卡类型}} */}GOLD MEMBER</Text>
          <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>{/* {{替换：卡名}} */}黄金会员</Text>
        </Box>
        <Box>
          <Text style={{ fontSize: 'label', color: '#FBBF24', letterSpacing: 1, marginBottom: 'sm' }}>{/* {{替换：卡号}} */}**** **** **** 2001</Text>
          <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
            <Box>
              <Text style={{ fontSize: 'label', color: '#6B7280', marginBottom: 'xs' }}>{/* {{替换：起始标签}} */}SINCE</Text>
              <Text style={{ fontSize: 'body', color: '#FFFFFF' }}>{/* {{替换：起始值}} */}2021</Text>
            </Box>
            <FAIcon name="star" style={{ fill: '#FBBF24', width: 22, height: 22 }} />
          </Box>
        </Box>
      </Box>
    </Box>
    {/* 底部说明 */}
    <Text style={{ fontSize: 'body', color: '#FBBF24', letterSpacing: 2 }}>{/* {{替换：底部说明}} */}三重尊享体验 · 专属身份象征</Text>
  </Box>
</Slide>
