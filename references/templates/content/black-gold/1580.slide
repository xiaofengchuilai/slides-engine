<Slide>
  {/* black-gold/1580 价值平衡之道：天平 + 左右托盘 + 底部说明 */}
  <Box style={{ height: 720, width: 1280, background: '#000000', padding: 'xl', alignItems: 'center', justifyContent: 'center' }}>
    <Text style={{ fontSize: 'title', color: '#FBBF24', bold: true, marginBottom: 'xl' }}>{/* {{替换：标题}} */}价值平衡之道</Text>
    {/* 天平整体 */}
    <Box style={{ position: 'relative', width: 860, height: 380, marginBottom: 'xl' }}>
      {/* 顶部支点 */}
      <Box style={{ position: 'absolute', top: 0, left: '50%', width: 56, height: 56, borderRadius: 28, background: 'linear-gradient(135deg, #FBBF24 0%, #D97706 100%)', border: '4px solid #FCD34D', alignItems: 'center', justifyContent: 'center', marginLeft: -28, boxShadow: '0 12px 36px rgba(0,0,0,0.22)' }}>
        <Box style={{ width: 24, height: 24, borderRadius: 12, background: '#000000' }} />
      </Box>
      {/* 横梁 */}
      <Box style={{ position: 'absolute', top: 28, left: 60, right: 60, height: 8, background: 'linear-gradient(90deg, #CA8A04 0%, #D97706 50%, #CA8A04 100%)', borderRadius: 4, boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }} />
      {/* 竖杆 */}
      <Box style={{ position: 'absolute', top: 56, left: '50%', width: 12, height: 120, background: 'linear-gradient(180deg, #FBBF24 0%, #D97706 100%)', borderRadius: 6, marginLeft: -6, boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }} />
      {/* 底座 */}
      <Box style={{ position: 'absolute', top: 172, left: '50%', width: 176, height: 28, background: 'linear-gradient(90deg, #CA8A04 0%, #D97706 100%)', borderRadius: 'sm', marginLeft: -88, boxShadow: '0 12px 36px rgba(0,0,0,0.22)' }}>
        <Box style={{ margin: 4, height: 20, background: 'linear-gradient(90deg, #FBBF24 0%, #D97706 100%)', borderRadius: 2 }} />
      </Box>
      {/* 左侧托盘 */}
      <Box style={{ position: 'absolute', left: 0, top: 32, alignItems: 'center' }}>
        <Box style={{ width: 8, height: 32, background: 'linear-gradient(180deg, #FBBF24 0%, #D97706 100%)' }} />
        <Box style={{ width: 16, height: 16, borderRadius: 8, border: '4px solid #FBBF24', background: '#000000' }} />
        <Box style={{ width: 8, height: 32, background: 'linear-gradient(180deg, #FBBF24 0%, #D97706 100%)' }} />
        <Box style={{ width: 208, height: 160, borderRadius: 104, background: 'linear-gradient(135deg, #CA8A04 0%, #92400E 100%)', border: '4px solid #FBBF24', alignItems: 'center', justifyContent: 'center', boxShadow: '0 16px 48px rgba(0,0,0,0.28)' }}>
          <Emoji name="⚖️" style={{ width: 32, height: 32, marginBottom: 'xs' }} />
          <Text style={{ fontSize: 'card', color: '#000000', bold: true }}>{/* {{替换：左托盘名}} */}品质</Text>
          <Text style={{ fontSize: 'label', color: '#78350F' }}>{/* {{替换：左托盘副名}} */}Quality</Text>
        </Box>
      </Box>
      {/* 右侧托盘 */}
      <Box style={{ position: 'absolute', right: 0, top: 32, alignItems: 'center' }}>
        <Box style={{ width: 8, height: 32, background: 'linear-gradient(180deg, #FBBF24 0%, #D97706 100%)' }} />
        <Box style={{ width: 16, height: 16, borderRadius: 8, border: '4px solid #FBBF24', background: '#000000' }} />
        <Box style={{ width: 8, height: 32, background: 'linear-gradient(180deg, #FBBF24 0%, #D97706 100%)' }} />
        <Box style={{ width: 208, height: 160, borderRadius: 104, background: 'linear-gradient(135deg, #CA8A04 0%, #92400E 100%)', border: '4px solid #FBBF24', alignItems: 'center', justifyContent: 'center', boxShadow: '0 16px 48px rgba(0,0,0,0.28)' }}>
          <Emoji name="💰" style={{ width: 32, height: 32, marginBottom: 'xs' }} />
          <Text style={{ fontSize: 'card', color: '#000000', bold: true }}>{/* {{替换：右托盘名}} */}价值</Text>
          <Text style={{ fontSize: 'label', color: '#78350F' }}>{/* {{替换：右托盘副名}} */}Value</Text>
        </Box>
      </Box>
    </Box>
    {/* 底部说明 */}
    <Box style={{ alignItems: 'center' }}>
      <Text style={{ fontSize: 'body', color: '#FBBF24', letterSpacing: 2, marginBottom: 'xs' }}>{/* {{替换：标语}} */}品质与价值的完美平衡</Text>
      <Text style={{ fontSize: 'label', color: '#9CA3AF' }}>{/* {{替换：说明}} */}在追求卓越的道路上，我们始终坚持价值与品质并重的原则</Text>
    </Box>
  </Box>
</Slide>
