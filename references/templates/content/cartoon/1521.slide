<Slide>
  {/* cartoon/1521 创意思维的秘密：标题卡 + 四宫格 + 金句 + 小贴士 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FCE7F3 0%, #F3E8FF 50%, #DBEAFE 100%)', padding: 'xl', gap: 'lg' }}>
    {/* 标题卡 */}
    <Box style={{ background: '#FFFFFF', borderRadius: 'lg', padding: 'lg', boxShadow: '0 16px 48px rgba(0,0,0,0.28)', rotate: 1 }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'md', marginBottom: 'sm' }}>
        <Emoji name="🎨" style={{ width: 36, height: 36 }} />
        <Text style={{ fontSize: 'title', color: '#9333EA', bold: true }}>{/* {{替换：标题}} */}创意思维的秘密</Text>
      </Box>
      <Text style={{ fontSize: 'body', color: '#374151', lineHeight: 1.6, marginBottom: 'xs' }}>{/* {{替换：正文1}} */}创意不是天才的专利，而是每个人都可以培养的能力！🌟 研究表明，创造力与大脑的发散性思维密切相关。</Text>
      <Text style={{ fontSize: 'body', color: '#374151', lineHeight: 1.6 }}>{/* {{替换：正文2}} */}就像小朋友画画一样，不要害怕犯错，勇敢地尝试各种可能性！✨</Text>
    </Box>
    {/* 四宫格 + 金句 */}
    <Box style={{ flexDirection: 'row', gap: 'lg', flex: 1 }}>
      <Box style={{ flex: 1, flexDirection: 'column', gap: 'md' }}>
        {[
          ['头脑风暴', '不批判，尽情发散想法', 'linear-gradient(135deg, #F472B6 0%, #F9A8D4 100%)', '💭'],
          ['跨界思考', '从不同领域找灵感', 'linear-gradient(135deg, #A855F7 0%, #C4B5FD 100%)', '🔄'],
          ['快速原型', '动手做出来试试看', 'linear-gradient(135deg, #60A5FA 0%, #93C5FD 100%)', '✏️'],
          ['反复迭代', '不断改进和优化', 'linear-gradient(135deg, #34D399 0%, #6EE7B7 100%)', '🎯'],
        ].map((x, i) => (
          <Box key={i} style={{ flex: 1, background: x[2], borderRadius: 'md', padding: 'sm', boxShadow: '0 8px 24px rgba(0,0,0,0.18)', justifyContent: 'center' }}>
            <Emoji name={x[3]} style={{ width: 24, height: 24, marginBottom: 6 }} />
            <Text style={{ fontSize: 'card', color: '#1F2937', bold: true, marginBottom: 4 }}>{/* {{替换：方法名}} */}{x[0]}</Text>
            <Text style={{ fontSize: 'label', color: '#374151' }}>{/* {{替换：方法描述}} */}{x[1]}</Text>
          </Box>
        ))}
      </Box>
      <Box style={{ width: 400, background: 'linear-gradient(135deg, #FCD34D 0%, #FDBA74 100%)', borderRadius: 'lg', padding: 'xl', justifyContent: 'center', boxShadow: '0 16px 48px rgba(0,0,0,0.28)', rotate: -2 }}>
        <Emoji name="🌈" style={{ position: 'absolute', top: 8, right: 8, width: 56, height: 56, opacity: 0.25 }} />
        <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true, lineHeight: 1.5, marginBottom: 'md' }}>{/* {{替换：金句}} */}"想象力比知识更重要！"</Text>
        <Text style={{ fontSize: 'label', color: '#78350F', bold: true }}>{/* {{替换：署名}} */}— 爱因斯坦</Text>
      </Box>
    </Box>
    {/* 小贴士 */}
    <Box style={{ background: 'rgba(255,255,255,0.8)', borderRadius: 'md', border: '2px dashed #C4B5FD', padding: 'md', flexDirection: 'row', alignItems: 'center', gap: 'md' }}>
      <Emoji name="📚" style={{ width: 26, height: 26 }} />
      <Box style={{ flex: 1 }}>
        <Text style={{ fontSize: 'body', color: '#9333EA', bold: true }}>{/* {{替换：小贴士标签}} */}小贴士：</Text>
        <Text style={{ fontSize: 'body', color: '#4B5563' }}>{/* {{替换：小贴士内容}} */}每天花10分钟做创意小练习，可以有效提升创造力哦！</Text>
      </Box>
      <Emoji name="✨" style={{ width: 26, height: 26 }} />
    </Box>
  </Box>
</Slide>
