<Slide>
  {/* cartoon/1525 超级英雄养成计划：标题条 + 三步卡片 + 结论条 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #EFF6FF 0%, #F5F3FF 50%, #FDF2F8 100%)', padding: 'xl', gap: 'lg' }}>
    {/* 标题区域 */}
    <Box style={{ background: 'linear-gradient(90deg, #6366F1 0%, #8B5CF6 50%, #EC4899 100%)', borderRadius: 'lg', padding: 'lg', alignItems: 'center', boxShadow: '0 8px 24px rgba(0,0,0,0.18)', position: 'relative' }}>
      <Emoji name="💥" style={{ position: 'absolute', top: 12, left: 20, width: 40, height: 40, opacity: 0.3 }} />
      <Emoji name="⚡" style={{ position: 'absolute', bottom: 12, right: 20, width: 40, height: 40, opacity: 0.3 }} />
      <Text style={{ fontSize: 'title', color: '#FFFFFF', bold: true }}>{/* {{替换：标题}} */}超级英雄养成计划！🦸</Text>
    </Box>
    {/* 三个步骤卡片 */}
    <Box style={{ flexDirection: 'row', gap: 'lg', flex: 1 }}>
      {[
        ['第一步', '锻炼身体！每天坚持运动30分钟', '体力 +100', 'linear-gradient(135deg, #60A5FA 0%, #2563EB 100%)', '#3B82F6', '💪'],
        ['第二步', '学习新知识！保持好奇心和求知欲', '智力 +100', 'linear-gradient(135deg, #A78BFA 0%, #7C3AED 100%)', '#8B5CF6', '🧠'],
        ['第三步', '关爱他人！帮助身边的小伙伴', '爱心 +100', 'linear-gradient(135deg, #F472B6 0%, #DB2777 100%)', '#EC4899', '❤️'],
      ].map((x, i) => (
        <Box key={i} style={{ flex: 1, background: '#FFFFFF', borderRadius: 'lg', padding: 'lg', alignItems: 'center', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
          <Box style={{ width: 72, height: 72, borderRadius: 36, background: x[3], alignItems: 'center', justifyContent: 'center', marginBottom: 'md', boxShadow: '0 4px 12px rgba(0,0,0,0.15)' }}>
            <Emoji name={x[5]} style={{ width: 34, height: 34 }} />
          </Box>
          <Box style={{ width: '100%', background: 'linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%)', borderRadius: 'md', padding: 'md', alignItems: 'center', marginBottom: 'md' }}>
            <Text style={{ fontSize: 'card', color: x[4], bold: true, marginBottom: 'xs' }}>{/* {{替换：步骤名}} */}{x[0]}</Text>
            <Text style={{ fontSize: 'label', color: '#374151', textAlign: 'center', lineHeight: 1.6 }}>{/* {{替换：步骤描述}} */}{x[1].split('！')[0]}！<br />{x[1].split('！')[1]}</Text>
          </Box>
          <Box style={{ background: 'linear-gradient(90deg, ' + x[4] + ' 0%, ' + x[4] + ' 100%)', borderRadius: 20, padding: 'xs xl' }}>
            <Text style={{ fontSize: 'label', color: '#FFFFFF', bold: true }}>{/* {{替换：数值}} */}{x[2]}</Text>
          </Box>
        </Box>
      ))}
    </Box>
    {/* 结论区域 */}
    <Box style={{ background: 'linear-gradient(90deg, #FBBF24 0%, #FB923C 50%, #F87171 100%)', borderRadius: 'lg', padding: 'lg', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', boxShadow: '0 8px 24px rgba(0,0,0,0.18)', position: 'relative' }}>
      <Box style={{ flex: 1 }}>
        <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true, marginBottom: 'xs' }}>{/* {{替换：结论标题}} */}恭喜你！完成三项修炼</Text>
        <Text style={{ fontSize: 'body', color: 'rgba(255,255,255,0.95)' }}>{/* {{替换：结论副句}} */}你已经成为一名超级英雄啦！🎉✨</Text>
      </Box>
      <Box style={{ background: 'rgba(255,255,255,0.95)', borderRadius: 'md', padding: 'md', alignItems: 'center', boxShadow: '0 4px 12px rgba(0,0,0,0.15)' }}>
        <Emoji name="🏆" style={{ width: 36, height: 36, marginBottom: 'xs' }} />
        <Text style={{ fontSize: 'label', color: '#EA580C', bold: true }}>{/* {{替换：成就}} */}成就达成</Text>
      </Box>
    </Box>
  </Box>
</Slide>
