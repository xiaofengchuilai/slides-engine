<Slide>
  {/* cartoon/1527 美好的一天：手绘标题 + 四时段卡片 + 底部总结 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FFFBEB 0%, #FFF7ED 50%, #FEF9C3 100%)', padding: 'xl', gap: 'md' }}>
    {/* 手绘标题 */}
    <Box style={{ alignItems: 'center', marginBottom: 'sm' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', marginBottom: 'xs' }}>
        <Emoji name="☀️" style={{ width: 32, height: 32 }} />
        <Text style={{ fontSize: 'title', color: '#1F2937', bold: true }}>{/* {{替换：标题}} */}美好的一天</Text>
        <Emoji name="☀️" style={{ width: 32, height: 32 }} />
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'md' }}>
        <Box style={{ width: 72, height: 3, background: '#FB923C', borderRadius: 2 }} />
        <Text style={{ fontSize: 'body', color: '#EA580C', bold: true }}>{/* {{替换：副标题}} */}用画笔记录生活</Text>
        <Box style={{ width: 72, height: 3, background: '#FB923C', borderRadius: 2 }} />
      </Box>
    </Box>
    {/* 四时段卡片 */}
    <Box style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 'lg', flex: 1 }}>
      {[
        ['1', '早晨 7:00', '阳光透过窗帘洒进来，新的一天开始啦！', ['☕ 喝咖啡', '📰 看新闻'], '#EA580C', '#FFEDD5', '🌅', -1],
        ['2', '上午 10:00', '工作效率最高的时候，专注完成重要任务～', ['💻 写代码', '📊 开会'], '#2563EB', '#DBEAFE', '💼', 1],
        ['3', '下午 15:00', '午餐后的小憩，再来杯下午茶恢复元气！', ['🍰 下午茶', '💬 聊天'], '#059669', '#D1FAE5', '🍱', 1],
        ['4', '晚上 20:00', '放松的时光，做自己喜欢的事情～', ['📚 阅读', '🎮 游戏'], '#7C3AED', '#EDE9FE', '🌙', -1],
      ].map((x, i) => (
        <Box key={i} style={{ width: 598, background: '#FFFFFF', borderRadius: 'lg', padding: 'lg', flexDirection: 'row', alignItems: 'flex-start', gap: 'md', boxShadow: '0 12px 36px rgba(0,0,0,0.22)', rotate: x[7] }}>
          <Box style={{ position: 'absolute', top: -12, right: -12, width: 44, height: 44, borderRadius: 22, background: x[4], alignItems: 'center', justifyContent: 'center', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
            <Text style={{ fontSize: 'body', color: '#FFFFFF', bold: true }}>{/* {{替换：编号}} */}{x[0]}</Text>
          </Box>
          <Box style={{ width: 56, height: 56, borderRadius: 28, background: x[5], alignItems: 'center', justifyContent: 'center' }}>
            <Emoji name={x[6]} style={{ width: 30, height: 30 }} />
          </Box>
          <Box style={{ flex: 1 }}>
            <Text style={{ fontSize: 'card', color: x[4], bold: true, marginBottom: 'xs' }}>{/* {{替换：时段}} */}{x[1]}</Text>
            <Text style={{ fontSize: 'label', color: '#374151', lineHeight: 1.6, marginBottom: 'xs' }}>{/* {{替换：描述}} */}{x[2]}</Text>
            <Box style={{ flexDirection: 'row', gap: 'sm' }}>
              {x[3].map((t, ti) => (
                <Box key={ti} style={{ background: x[5], borderRadius: 16, padding: 'xs md' }}>
                  <Text style={{ fontSize: 'label', color: x[4], bold: true }}>{/* {{替换：标签}} */}{t}</Text>
                </Box>
              ))}
            </Box>
          </Box>
        </Box>
      ))}
    </Box>
    {/* 底部总结 */}
    <Box style={{ background: 'linear-gradient(90deg, #F9A8D4 0%, #FDE68A 50%, #67E8F9 100%)', borderRadius: 'lg', padding: 'md', alignItems: 'center', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
      <Text style={{ fontSize: 'card', color: '#1F2937', bold: true }}>{/* {{替换：总结语}} */}✨ 每一天都值得用心记录 ✨</Text>
    </Box>
  </Box>
</Slide>
