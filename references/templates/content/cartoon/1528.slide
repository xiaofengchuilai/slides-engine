<Slide>
  {/* cartoon/1528 成长之路：四步圆环流程 + 三要素卡 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #EDE9FE 0%, #FAF5FF 50%, #FCE7F3 100%)', padding: 'xl' }}>
    {/* 标题 */}
    <Box style={{ alignItems: 'center', marginBottom: 'xl' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', marginBottom: 'xs' }}>
        <Text style={{ fontSize: 'title', color: '#7C3AED', bold: true }}>{/* {{替换：标题}} */}成长之路</Text>
        <Emoji name="🚀" style={{ width: 36, height: 36 }} />
      </Box>
      <Text style={{ fontSize: 'body', color: '#4B5563', bold: true }}>{/* {{替换：副标题}} */}一步一个脚印，向梦想前进</Text>
    </Box>
    {/* 四步流程 */}
    <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', marginBottom: 'xl', padding: 'md xl' }}>
      {[
        ['设定目标', '明确方向', 'linear-gradient(135deg, #F87171 0%, #EC4899 100%)', '🎯'],
        ['制定计划', '合理规划', 'linear-gradient(135deg, #FB923C 0%, #FBBF24 100%)', '📋'],
        ['努力执行', '坚持不懈', 'linear-gradient(135deg, #4ADE80 0%, #10B981 100%)', '💪'],
        ['达成目标', '收获成果', 'linear-gradient(135deg, #60A5FA 0%, #06B6D4 100%)', '🏆'],
      ].map((x, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center' }}>
          <Box style={{ alignItems: 'center' }}>
            <Box style={{ width: 108, height: 108, borderRadius: 54, background: x[2], alignItems: 'center', justifyContent: 'center', marginBottom: 'sm', boxShadow: '0 16px 48px rgba(0,0,0,0.28)' }}>
              <Emoji name={x[3]} style={{ width: 48, height: 48 }} />
            </Box>
            <Text style={{ fontSize: 'card', color: '#1F2937', bold: true }}>{/* {{替换：步骤名}} */}{x[0]}</Text>
            <Text style={{ fontSize: 'label', color: '#4B5563' }}>{/* {{替换：步骤说明}} */}{x[1]}</Text>
          </Box>
          {i < 3 && <Box style={{ padding: 'xs' }}><FAIcon name="arrow-right" style={{ fill: '#A855F7', width: 28, height: 28 }} /></Box>}
        </Box>
      ))}
    </Box>
    {/* 三要素卡 */}
    <Box style={{ flexDirection: 'row', gap: 'lg', justifyContent: 'center' }}>
      {[
        ['思考', '多角度分析问题，找到最优解决方案', '#A855F7', '#F3E8FF', '💡'],
        ['行动', '立即开始，用行动验证想法的可行性', '#EC4899', '#FCE7F3', '🔥'],
        ['成长', '持续学习改进，不断突破自我', '#6366F1', '#E0E7FF', '📈'],
      ].map((x, i) => (
        <Box key={i} style={{ width: 360, background: 'rgba(255,255,255,0.8)', borderRadius: 'md', padding: 'lg', boxShadow: '0 12px 36px rgba(0,0,0,0.22)' }}>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'md', marginBottom: 'sm' }}>
            <Box style={{ width: 52, height: 52, borderRadius: 26, background: x[3], alignItems: 'center', justifyContent: 'center' }}>
              <Emoji name={x[4]} style={{ width: 26, height: 26 }} />
            </Box>
            <Text style={{ fontSize: 'card', color: x[2], bold: true }}>{/* {{替换：要素名}} */}{x[0]}</Text>
          </Box>
          <Text style={{ fontSize: 'body', color: '#374151', lineHeight: 1.6 }}>{/* {{替换：要素描述}} */}{x[1]}</Text>
        </Box>
      ))}
    </Box>
  </Box>
</Slide>
