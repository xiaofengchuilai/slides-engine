<Slide>
  {/* chinese/1625 左文右双图·饮食文化：左文（标题+导语+三要点）+ 右双图 */}
  <Box style={{ height: 720, width: 1280, background: '#FAF9F6', padding: 'xxl xl', flexDirection: 'row', alignItems: 'center', gap: 'xl' }}>
    {/* 左文字区 */}
    <Box style={{ width: '50%', gap: 'lg' }}>
      <Text style={{ fontSize: 'title', color: '#7A1F12', bold: true }}>{/* {{替换：主标题}} */}饮食文化</Text>
      <Box style={{ width: 80, height: 2, background: 'rgba(168, 24, 16, 0.3)' }} />
      <Text style={{ fontSize: 'body', color: 'text', lineHeight: 1.8 }}>{/* {{替换：导语}} */}
        中国饮食文化源远流长，讲究色、香、味、形、器的和谐统一，体现“民以食为天”的生活哲学。
      </Text>
      <Box style={{ gap: 'md' }}>
        {['八大菜系，风味各异', '药食同源，养生保健', '礼仪讲究，文化传承'].map((x, i) => (
          <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm' }}>
            <Box style={{ width: 4, height: 24, background: 'rgba(168, 24, 16, 0.3)' }} />
            <Text style={{ fontSize: 'body', color: 'text' }}>{x}</Text>
          </Box>
        ))}
      </Box>
    </Box>
    {/* 右双图区 */}
    <Box style={{ flex: 1, flexDirection: 'column', gap: 'lg', height: '100%', justifyContent: 'center' }}>
      <Box style={{ flex: 1, alignItems: 'center', justifyContent: 'center' }}>
        {/* {{图片：有图填 assets/images/food.png，无图删掉整个 <Image>}} */}
        <Image src="assets/images/food.png" style={{ objectFit: 'cover', width: '100%', height: 240 }} />
      </Box>
      <Box style={{ flex: 1, alignItems: 'center', justifyContent: 'center' }}>
        {/* {{图片：有图填 assets/images/tea.png，无图删掉整个 <Image>}} */}
        <Image src="assets/images/tea.png" style={{ objectFit: 'cover', width: '100%', height: 240 }} />
      </Box>
    </Box>
    {/* 功能文字 */}
    <Text style={{ fontSize: 'label', color: 'muted', position: 'absolute', left: 80, bottom: 24 }}>{/* {{替换：来源}} */}UNESCO人类非物质文化遗产 · 中国饮食文化</Text>
  </Box>
</Slide>
