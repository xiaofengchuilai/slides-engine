<Slide>
  {/* chinese/1627 图文·左文右三图：左侧主题区 + 右侧三列双图网格 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(90deg, #FAF9F6 0%, #F5F3ED 100%)', padding: 'xxl xl' }}>
    <Box style={{ flex: 1, flexDirection: 'row', gap: 'xl', alignItems: 'stretch' }}>
      {/* 左侧文字区 */}
      <Box style={{ width: 400, justifyContent: 'center', gap: 'lg' }}>
        <Box>
          <Text style={{ fontSize: 'title', color: '#8B4513', bold: true, marginBottom: 'sm', fontFamily: 'serif' }}>{/* {{替换：标题}} */}民间艺术</Text>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', marginBottom: 'sm' }}>
            <Box style={{ width: 64, height: 2, background: '#8B4513', opacity: 0.7 }} />
            <Box style={{ width: 8, height: 8, borderRadius: 8, background: '#8B4513' }} />
          </Box>
          <Text style={{ fontSize: 'label', color: '#8A8A8A', letterSpacing: 1 }}>Folk Arts of China</Text>
        </Box>
        <Box style={{ gap: 'lg' }}>
          <Text style={{ fontSize: 'body', color: '#4A4A4A', lineHeight: 1.7 }}>
            {/* {{替换：导语}} */}中国民间艺术源远流长，形式多样，承载着劳动人民的智慧与情感，是非物质文化遗产的重要组成部分。
          </Text>
          <Box style={{ gap: 'sm' }}>
            {['传统手工技艺', '世代传承创新', '文化遗产保护'].map((x, i) => (
              <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm' }}>
                <Box style={{ width: 8, height: 8, borderRadius: 8, background: '#8B4513' }} />
                <Text style={{ fontSize: 'body', color: '#4B5563', fontFamily: 'serif' }}>{/* {{替换：x}} */}{x}</Text>
              </Box>
            ))}
          </Box>
        </Box>
      </Box>
      {/* 右侧三列双图网格 */}
      <Box style={{ flex: 1, flexDirection: 'row', gap: 'lg' }}>
        {[['剪纸', '陶瓷'], ['皮影', '编织'], ['刺绣', '年画']].map((col, i) => (
          <Box key={i} style={{ flex: 1, flexDirection: 'column', gap: 'md' }}>
            {col.map((alt, j) => (
              <Box key={j} style={{ flex: 1, borderRadius: 'sm', background: '#FFFFFF', alignItems: 'center', justifyContent: 'center', border: '1px solid #E5E7EB' }}>
                {/* {{图片：有图填 assets/images/xxx.png，无图删掉整个 <Image>}} */}
                <Image src="assets/images/chinese-1627.png" style={{ width: '100%', height: '100%', objectFit: 'cover' }} />
                <Text style={{ fontSize: 'label', color: '#8A8A8A' }}>{alt}</Text>
              </Box>
            ))}
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
  {/* 底部功能文字 */}
  <Box style={{ position: 'absolute', bottom: 24, right: 80, alignItems: 'flex-end' }}>
    <Text style={{ fontSize: 'label', color: '#9CA3AF' }}>非物质文化遗产保护项目 · 中国民间文艺家协会</Text>
  </Box>
</Slide>
