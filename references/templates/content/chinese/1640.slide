<Slide>
  {/* chinese/1640 纯文字·横向诗意布局：左标题区 + 右三诗句 + 印章降级 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(90deg, #FAF9F6 0%, #F5F3ED 50%, #FAF9F6 100%)', padding: 'xxl xl' }}>
    <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: 'xl' }}>
      {/* 左侧标题区 */}
      <Box style={{ width: 224, gap: 'md' }}>
        <Box>
          <Text style={{ fontSize: 'title', color: '#8B4513', bold: true, fontFamily: 'serif', lineHeight: 1.3, marginBottom: 'md' }}>{/* {{替换：标题}} */}道法自然</Text>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm' }}>
            <Box style={{ width: 48, height: 2, background: '#8B4513', opacity: 0.7 }} />
            <Box style={{ width: 8, height: 8, borderRadius: 8, background: '#8B4513' }} />
          </Box>
        </Box>
        <Box style={{ marginTop: 'sm' }}>
          <Text style={{ fontSize: 'label', color: '#8A8A8A', letterSpacing: 1 }}>道家哲学思想</Text>
          <Text style={{ fontSize: 'label', color: '#9CA3AF', marginTop: 'xs' }}>《庄子·知北游》</Text>
        </Box>
      </Box>
      {/* 右侧诗句区 */}
      <Box style={{ flex: 1, gap: 'lg' }}>
        {[
          ['一', '天地有大美而不言'],
          ['二', '四时有明法而不议'],
          ['三', '万物有成理而不说'],
        ].map((x, i) => (
          <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 'lg' }}>
            <Box style={{ width: 36, height: 36, borderRadius: 36, background: '#8B4513', opacity: 0.08, alignItems: 'center', justifyContent: 'center' }}>
              <Text style={{ fontSize: 'label', color: '#8B4513', fontFamily: 'serif', bold: true }}>{x[0]}</Text>
            </Box>
            <Text style={{ fontSize: 'kpi', color: '#4A4A4A', fontFamily: 'serif', lineHeight: 1.4 }}>{/* {{替换：x[1]}} */}{x[1]}</Text>
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
  {/* 印章装饰（降级为简约红块） */}
  <Box style={{ position: 'absolute', top: 64, right: 64, width: 48, height: 48, background: '#C41E3A', alignItems: 'center', justifyContent: 'center' }}>
    <Text style={{ fontSize: 'label', color: '#FFFFFF', bold: true, fontFamily: 'serif' }}>道</Text>
  </Box>
  {/* 底部功能文字 */}
  <Box style={{ position: 'absolute', bottom: 24, left: 0, right: 0, alignItems: 'center' }}>
    <Text style={{ fontSize: 'label', color: '#9CA3AF' }}>道家哲学思想 · 《庄子》</Text>
  </Box>
</Slide>
