<Slide>
  {/* educational/1647 家庭经典共读·亲子导读：标题 + 三栏(原文/译文/亲子讨论) + 家长导读建议 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FEF2F2 0%, #FEE2E2 100%)', padding: 'xxl xl', gap: 'lg' }}>
    <Box style={{ alignItems: 'center', gap: 'xs' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'md' }}>
        <Emoji name="📚" style={{ width: 34, height: 34 }} />
        <Text style={{ fontSize: 'title', color: '#881337', fontFamily: 'serif', bold: true }}>{/* {{替换：标题}} */}《论语·学而篇》</Text>
        <Text style={{ fontSize: 34 }}>👨👩👧</Text>
      </Box>
      <Text style={{ fontSize: 'body', color: '#BE123C', letterSpacing: 2 }}>{/* {{替换：副标题}} */}家庭经典共读 · 第一课</Text>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'row', gap: 'lg' }}>
      {[
        ['原', '经典原文', ['子曰："学而时习之，不亦说乎？', '有朋自远方来，不亦乐乎？', '人不知而不愠，不亦君子乎？"']],
        ['译', '白话译文', ['孔子说："学了知识并且按时复习，不也很愉快吗？', '有志同道合的朋友从远方来，不也很快乐吗？', '别人不了解自己也不生气，不也是有德行的君子吗？"']],
        ['问', '亲子讨论', ['问题1: 你喜欢复习功课吗？为什么？', '问题2: 有好朋友来你会做什么？', '问题3: 如果别人不理解你，你会怎么办？']],
      ].map((x, i) => (
        <Box key={i} style={{ flex: 1, background: 'rgba(255,255,255,0.85)', border: '2px solid #FECDD3', borderRadius: 'md', padding: 'lg' }}>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', marginBottom: 'md' }}>
            <Box style={{ width: 32, height: 32, background: '#FFE4E6', borderRadius: 'sm', alignItems: 'center', justifyContent: 'center' }}>
              <Text style={{ fontSize: 'body', color: '#BE123C', bold: true }}>{/* {{替换：标签字}} */}{x[0]}</Text>
            </Box>
            <Text style={{ fontSize: 'card', color: '#9F1239', bold: true }}>{/* {{替换：栏标题}} */}{x[1]}</Text>
          </Box>
          <Box style={{ gap: 'md' }}>
            {x[2].map((t, ti) => (
              <Box key={ti} style={i === 2 ? { background: '#FFF1F2', borderRadius: 'sm', padding: 'sm' } : {}}>
                <Text style={{ fontSize: i === 0 ? 'card' : 'body', color: '#374151', fontFamily: i === 0 ? 'serif' : 'sans', lineHeight: 1.7 }}>{/* {{替换：内容}} */}{t}</Text>
              </Box>
            ))}
          </Box>
        </Box>
      ))}
    </Box>
    <Box style={{ background: 'linear-gradient(90deg, #FFF1F2 0%, #FDF2F8 100%)', flexDirection: 'row', alignItems: 'flex-start', padding: 'md', borderRadius: 'md' }}>
      <Box style={{ width: 4, height: 64, background: '#F43F5E', borderRadius: 2, marginRight: 'md' }} />
      <Box style={{ flex: 1 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', marginBottom: 'sm' }}>
          <FAIcon name="chalkboard-teacher" style={{ fill: '#9F1239', width: 18, height: 18 }} />
          <Text style={{ fontSize: 'body', color: '#881337', bold: true }}>{/* {{替换：标题}} */}家长导读建议</Text>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 'lg' }}>
          {[
            ['① 分角色朗读', '家长读"子曰"，孩子读引号内容'],
            ['② 联系生活', '结合孩子学习、交友的实际经历'],
            ['③ 每日一句', '选一句作为本周家庭格言'],
          ].map((x, i) => (
            <Box key={i} style={{ flex: 1 }}>
              <Text style={{ fontSize: 'body', color: '#BE123C', bold: true }}>{/* {{替换：建议名}} */}{x[0]}</Text>
              <Text style={{ fontSize: 'label', color: '#4B5563', marginTop: 'xs' }}>{/* {{替换：建议说明}} */}{x[1]}</Text>
            </Box>
          ))}
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
