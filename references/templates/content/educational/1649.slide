<Slide>
  {/* educational/1649 易错字辨析·形近字：标题 + 3字卡(己/已/巳) + 记忆口诀 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FFF7ED 0%, #FFEDD5 100%)', padding: 'xxl xl', gap: 'lg' }}>
    <Box style={{ alignItems: 'center', gap: 'xs' }}>
      <Text style={{ fontSize: 'title', color: '#7C2D12', bold: true }}>{/* {{替换：标题}} */}易错字辨析 · 形近字</Text>
      <Text style={{ fontSize: 'body', color: '#C2410C' }}>{/* {{替换：副标题}} */}"己" vs "已" vs "巳"</Text>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'row', gap: 'lg' }}>
      {[
        ['第一个字', '己', '左不出头', 'jǐ', '自己、自身', ['自己', '知己', '克己'], '#DC2626'],
        ['第二个字', '已', '左边出头', 'yǐ', '已经、停止', ['已经', '早已', '已知'], '#2563EB'],
        ['第三个字', '巳', '全部出头', 'sì', '地支第六位(蛇)', ['巳时', '巳蛇', '己巳年'], '#16A34A'],
      ].map((x, i) => (
        <Box key={i} style={{ flex: 1, background: '#FFFFFF', border: '2px solid #FDBA74', borderRadius: 'md', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
          <Box style={{ background: `linear-gradient(135deg, ${x[6]} 0%, ${x[6]} 100%)`, padding: 'xs', alignItems: 'center' }}>
            <Text style={{ fontSize: 'label', color: '#FFFFFF', bold: true }}>{/* {{替换：序号}} */}{x[0]}</Text>
          </Box>
          <Box style={{ padding: 'lg', gap: 'sm' }}>
            <Box style={{ height: 96, background: '#FFF7ED', border: '2px solid #FDBA74', borderRadius: 'md', alignItems: 'center', justifyContent: 'center', position: 'relative' }}>
              <Text style={{ fontSize: 'kpi', color: x[6], fontFamily: 'serif', bold: true }}>{/* {{替换：字}} */}{x[1]}</Text>
              <Box style={{ position: 'absolute', bottom: 6, right: 6, background: x[6], borderRadius: 4, padding: 'xs sm' }}>
                <Text style={{ fontSize: 10, color: '#FFFFFF', bold: true }}>{/* {{替换：提示}} */}{x[2]}</Text>
              </Box>
            </Box>
            <Box style={{ gap: 'xs' }}>
              <Box style={{ background: x[6], borderRadius: 'sm', padding: 'sm', opacity: 0.08 }}>
                <Text style={{ fontSize: 10, color: x[6], bold: true }}>读音:</Text>
                <Text style={{ fontSize: 'card', color: x[6], bold: true }}>{/* {{替换：读音}} */}{x[3]}</Text>
              </Box>
              <Box style={{ background: x[6], borderRadius: 'sm', padding: 'sm', opacity: 0.08 }}>
                <Text style={{ fontSize: 10, color: x[6], bold: true }}>意思:</Text>
                <Text style={{ fontSize: 'body', color: '#374151' }}>{/* {{替换：意思}} */}{x[4]}</Text>
              </Box>
              <Box style={{ background: x[6], borderRadius: 'sm', padding: 'sm', opacity: 0.08 }}>
                <Text style={{ fontSize: 10, color: x[6], bold: true }}>组词:</Text>
                <Box style={{ flexDirection: 'row', gap: 'xs', flexWrap: 'wrap', marginTop: 'xs' }}>
                  {x[5].map((w, wi) => (
                    <Box key={wi} style={{ padding: 'xs sm', background: '#FFFFFF', border: `1px solid ${x[6]}`, borderRadius: 'sm' }}>
                      <Text style={{ fontSize: 'label', color: '#374151' }}>{/* {{替换：组词}} */}{w}</Text>
                    </Box>
                  ))}
                </Box>
              </Box>
            </Box>
          </Box>
        </Box>
      ))}
    </Box>
    <Box style={{ background: 'linear-gradient(90deg, #FFEDD5 0%, #FEF3C7 50%, #FEF9C3 100%)', border: '2px solid #FDBA74', borderRadius: 'md', padding: 'md', alignItems: 'center' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', marginBottom: 'xs' }}>
        <Emoji name="🎯" style={{ width: 18, height: 18 }} />
        <Text style={{ fontSize: 'body', color: '#7C2D12', bold: true }}>{/* {{替换：标题}} */}记忆口诀</Text>
        <Emoji name="🎯" style={{ width: 18, height: 18 }} />
      </Box>
      <Box style={{ flexDirection: 'row', gap: 'md', alignItems: 'center' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'xs' }}>
          <Text style={{ fontSize: 'body', color: '#7C2D12', fontFamily: 'serif' }}>左不出头是</Text>
          <Text style={{ fontSize: 'card', color: '#DC2626', bold: true, fontFamily: 'serif' }}>己</Text>
          <Text style={{ fontSize: 'body', color: '#7C2D12', fontFamily: 'serif' }}>自己，</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'xs' }}>
          <Text style={{ fontSize: 'body', color: '#7C2D12', fontFamily: 'serif' }}>左边出头是</Text>
          <Text style={{ fontSize: 'card', color: '#2563EB', bold: true, fontFamily: 'serif' }}>已</Text>
          <Text style={{ fontSize: 'body', color: '#7C2D12', fontFamily: 'serif' }}>已经，</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'xs' }}>
          <Text style={{ fontSize: 'body', color: '#7C2D12', fontFamily: 'serif' }}>全都出头是</Text>
          <Text style={{ fontSize: 'card', color: '#16A34A', bold: true, fontFamily: 'serif' }}>巳</Text>
          <Text style={{ fontSize: 'body', color: '#7C2D12', fontFamily: 'serif' }}>巳蛇。</Text>
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
