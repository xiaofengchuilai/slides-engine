<Slide>
  {/* educational/1652 HTML入门·标签学习：深色 + 标题 + 6标签卡(两列) */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #18181B 0%, #27272A 100%)', padding: 'xxl xl', gap: 'lg' }}>
    <Box style={{ alignItems: 'center', gap: 'xs' }}>
      <Text style={{ fontSize: 'title', color: '#FFFFFF', bold: true, fontFamily: 'monospace' }}>{/* {{替换：标题}} */}HTML 入门</Text>
      <Text style={{ fontSize: 'body', color: '#FB923C', fontFamily: 'monospace' }}>{/* {{替换：副标题}} */}常用标签学习</Text>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'row', gap: 'lg' }}>
      {[0, 3].map(col => (
        <Box key={col} style={{ flex: 1, gap: 'lg' }}>
          {[
            ['<h1> 标题标签', '<h1>我是一级标题</h1>', '用于定义标题，h1到h6，数字越小标题越大'],
            ['<p> 段落标签', '<p>这是一段文字</p>', '用于定义段落，浏览器会自动添加间距'],
            ['<a> 链接标签', '<a href="网址">点击跳转</a>', '用于创建超链接，href属性指定跳转地址'],
            ['<img> 图片标签', '<img src="图片地址" alt="描述">', '用于插入图片，src是图片路径，alt是备用文字'],
            ['<div> 容器标签', '<div>内容区域</div>', '用于分组和布局，是最常用的容器标签'],
            ['<ul> 列表标签', '<ul><li>列表项1</li><li>列表项2</li></ul>', '用于创建无序列表，每项用li标签包裹'],
          ].slice(col, col + 3).map((x, i) => (
            <Box key={i} style={{ background: '#27272A', border: '1px solid #3F3F46', borderRadius: 'md', padding: 'lg', gap: 'sm' }}>
              <Text style={{ fontSize: 'body', color: '#FB923C', bold: true, fontFamily: 'monospace' }}>{/* {{替换：标签名}} */}{x[0]}</Text>
              <Box style={{ background: '#18181B', borderRadius: 'sm', padding: 'sm' }}>
                <Text style={{ fontSize: 'body', color: '#34D399', fontFamily: 'monospace', lineHeight: 1.6 }}>{/* {{替换：代码}} */}{x[1]}</Text>
              </Box>
              <Text style={{ fontSize: 'label', color: '#A1A1AA' }}>{/* {{替换：说明}} */}{x[2]}</Text>
            </Box>
          ))}
        </Box>
      ))}
    </Box>
  </Box>
</Slide>
