<Slide>
  {/* educational/1660 CSS基础·盒模型：深色 + 左侧盒模型分层可视化 + 右侧4属性说明 + 底部公式 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #0F172A 0%, #1E1B4B 50%, #0F172A 100%)', padding: 'xxl xl', gap: 'md' }}>
    <Box style={{ alignItems: 'center', gap: 'xs' }}>
      <Text style={{ fontSize: 'label', color: '#22D3EE', fontFamily: 'monospace', letterSpacing: 3, marginBottom: 'xs' }}>{/* {{替换：副标题}} */}CSS FUNDAMENTALS</Text>
      <Text style={{ fontSize: 'title', color: '#FFFFFF', bold: true, fontFamily: 'monospace' }}>{/* {{替换：标题}} */}盒模型 Box Model</Text>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'row', gap: 'xl', alignItems: 'center' }}>
      {/* 左侧：盒模型分层可视化 */}
      <Box style={{ flex: 1, alignItems: 'center', justifyContent: 'center' }}>
        <Box style={{ border: '2px dashed #FB923C', borderRadius: 'md', padding: 'lg' }}>
          <Box style={{ position: 'absolute', top: -20, left: 24, background: '#0F172A', padding: 'xs sm', borderRadius: 'sm' }}>
            <Text style={{ fontSize: 'label', color: '#FB923C', fontFamily: 'monospace', bold: true }}>margin</Text>
          </Box>
          <Box style={{ border: '3px solid #4ADE80', borderRadius: 'sm', padding: 'lg' }}>
            <Box style={{ position: 'absolute', top: -16, left: 24, background: '#0F172A', padding: 'xs sm', borderRadius: 'sm' }}>
              <Text style={{ fontSize: 'label', color: '#4ADE80', fontFamily: 'monospace', bold: true }}>border</Text>
            </Box>
            <Box style={{ border: '1px solid rgba(168,85,247,0.3)', borderRadius: 'sm', padding: 'md' }}>
              <Box style={{ position: 'absolute', top: -14, left: 24, background: '#0F172A', padding: 'xs sm', borderRadius: 'sm' }}>
                <Text style={{ fontSize: 'label', color: '#C084FC', fontFamily: 'monospace', bold: true }}>padding</Text>
              </Box>
              <Box style={{ width: 180, height: 100, background: 'linear-gradient(135deg, #06B6D4 0%, #0891B2 100%)', borderRadius: 'sm', alignItems: 'center', justifyContent: 'center', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
                <Text style={{ fontSize: 'body', color: '#FFFFFF', bold: true, fontFamily: 'monospace' }}>content</Text>
                <Text style={{ fontSize: 'label', color: 'rgba(255,255,255,0.8)', fontFamily: 'monospace' }}>200 × 120</Text>
              </Box>
            </Box>
          </Box>
        </Box>
      </Box>
      {/* 右侧：属性说明卡片 */}
      <Box style={{ width: 480, gap: 'md' }}>
        {[
          ['content', '内容区域', '元素的实际内容，如文字、图片等', 'width: 200px; height: 120px;', '#22D3EE'],
          ['padding', '内边距', '内容与边框之间的透明空间', 'padding: 16px;', '#C084FC'],
          ['border', '边框', '围绕 padding 和 content 的边界线', 'border: 3px solid #4ade80;', '#4ADE80'],
          ['margin', '外边距', '元素与其他元素之间的透明间隔', 'margin: 20px;', '#FB923C'],
        ].map((x, i) => (
          <Box key={i} style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 'md', background: 'rgba(255,255,255,0.04)', border: `1px solid ${x[4]}55`, borderRadius: 'sm', padding: 'sm' }}>
            <Box style={{ width: 12, height: 12, borderRadius: 6, background: x[4], marginTop: 5 }} />
            <Box style={{ flex: 1 }}>
              <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 'sm', marginBottom: 'xs' }}>
                <Text style={{ fontSize: 'card', color: x[4], bold: true, fontFamily: 'monospace' }}>{/* {{替换：属性名}} */}{x[0]}</Text>
                <Text style={{ fontSize: 'label', color: '#9CA3AF' }}>{/* {{替换：中文名}} */}{x[1]}</Text>
              </Box>
              <Text style={{ fontSize: 'label', color: '#D1D5DB', marginBottom: 'xs' }}>{/* {{替换：说明}} */}{x[2]}</Text>
              <Box style={{ background: 'rgba(15,23,42,0.8)', borderRadius: 'sm', padding: 'xs sm' }}>
                <Text style={{ fontSize: 'label', color: x[4], fontFamily: 'monospace' }}>{/* {{替换：代码}} */}{x[3]}</Text>
              </Box>
            </Box>
          </Box>
        ))}
      </Box>
    </Box>
    {/* 底部公式 */}
    <Box style={{ alignItems: 'center' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', background: 'rgba(51,65,85,0.5)', border: '1px solid #475569', borderRadius: 'sm', padding: 'sm lg' }}>
        <Text style={{ fontSize: 'label', color: '#9CA3AF', fontFamily: 'monospace' }}>Total Width =</Text>
        <Text style={{ fontSize: 'label', color: '#FB923C', fontFamily: 'monospace' }}>margin</Text>
        <Text style={{ fontSize: 'label', color: '#6B7280' }}>+</Text>
        <Text style={{ fontSize: 'label', color: '#4ADE80', fontFamily: 'monospace' }}>border</Text>
        <Text style={{ fontSize: 'label', color: '#6B7280' }}>+</Text>
        <Text style={{ fontSize: 'label', color: '#C084FC', fontFamily: 'monospace' }}>padding</Text>
        <Text style={{ fontSize: 'label', color: '#6B7280' }}>+</Text>
        <Text style={{ fontSize: 'label', color: '#22D3EE', fontFamily: 'monospace' }}>content</Text>
        <Text style={{ fontSize: 'label', color: '#6B7280' }}>+</Text>
        <Text style={{ fontSize: 'label', color: '#C084FC', fontFamily: 'monospace' }}>padding</Text>
        <Text style={{ fontSize: 'label', color: '#6B7280' }}>+</Text>
        <Text style={{ fontSize: 'label', color: '#4ADE80', fontFamily: 'monospace' }}>border</Text>
        <Text style={{ fontSize: 'label', color: '#6B7280' }}>+</Text>
        <Text style={{ fontSize: 'label', color: '#FB923C', fontFamily: 'monospace' }}>margin</Text>
      </Box>
    </Box>
  </Box>
</Slide>
