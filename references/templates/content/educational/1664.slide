<Slide>
  {/* educational/1664 Python循环·for语句：深色 + 标题 + 左代码/运行结果 + 右 range说明/实战案例 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #1A1A2E 0%, #16213E 100%)', padding: 'xxl xl', gap: 'lg' }}>
    <Box style={{ alignItems: 'center', gap: 'xs' }}>
      <Text style={{ fontSize: 'title', color: '#34D399', bold: true, fontFamily: 'monospace' }}>{/* {{替换：标题}} */}for 循环</Text>
      <Text style={{ fontSize: 'body', color: '#94A3B8', fontFamily: 'monospace' }}>{/* {{替换：副标题}} */}重复执行代码的魔法</Text>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'row', gap: 'xl' }}>
      {/* 左侧：代码 + 运行结果 */}
      <Box style={{ flex: 1, gap: 'lg' }}>
        <Box style={{ background: 'rgba(15,23,42,0.5)', border: '1px solid #334155', borderRadius: 'md' }}>
          <Box style={{ background: '#1E293B', padding: 'xs lg', flexDirection: 'row', alignItems: 'center' }}>
            <Text style={{ fontSize: 'label', color: '#34D399', fontFamily: 'monospace' }}>{/* {{替换：标题}} */}基本语法</Text>
          </Box>
          <Box style={{ height: 1, background: '#334155' }} />
          <Box style={{ padding: 'lg', gap: 'xs' }}>
            <Text style={{ fontSize: 'body', color: '#F472B6', fontFamily: 'monospace' }}>1  for i in range(5):</Text>
            <Text style={{ fontSize: 'body', color: '#34D399', fontFamily: 'monospace' }}>2      print(i)</Text>
          </Box>
        </Box>
        <Box style={{ background: 'rgba(6,78,59,0.2)', border: '1px solid rgba(16,185,129,0.3)', borderRadius: 'md', padding: 'lg' }}>
          <Text style={{ fontSize: 'card', color: '#34D399', bold: true, fontFamily: 'monospace', marginBottom: 'sm' }}>{/* {{替换：标题}} */}运行结果</Text>
          <Box style={{ background: 'rgba(15,23,42,0.5)', borderRadius: 'sm', padding: 'md' }}>
            <Text style={{ fontSize: 'body', color: '#6EE7B7', fontFamily: 'monospace' }}>0  1  2  3  4</Text>
          </Box>
        </Box>
      </Box>
      {/* 右侧：说明区 */}
      <Box style={{ flex: 1, gap: 'lg' }}>
        <Box style={{ background: 'rgba(51,65,85,0.4)', border: '1px solid #334155', borderRadius: 'md', padding: 'lg' }}>
          <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true, marginBottom: 'md' }}>{/* {{替换：标题}} */}理解 range() 函数</Text>
          <Box style={{ gap: 'sm' }}>
            {[
              ['range(5)', '生成0,1,2,3,4 (从0开始，不包括5)'],
              ['range(1, 6)', '生成1,2,3,4,5 (从1到5)'],
              ['range(0, 10, 2)', '生成0,2,4,6,8 (步长为2)'],
            ].map((x, i) => (
              <Box key={i} style={{ background: 'rgba(15,23,42,0.5)', borderRadius: 'sm', padding: 'sm' }}>
                <Text style={{ fontSize: 'body', color: '#38BDF8', fontFamily: 'monospace', bold: true }}>{/* {{替换：函数}} */}{x[0]}</Text>
                <Text style={{ fontSize: 'label', color: '#CBD5E1', marginTop: 'xs' }}>{/* {{替换：说明}} */}{x[1]}</Text>
              </Box>
            ))}
          </Box>
        </Box>
        <Box style={{ background: 'rgba(14,165,233,0.1)', border: '1px solid rgba(14,165,233,0.3)', borderRadius: 'md', padding: 'lg' }}>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', marginBottom: 'sm' }}>
            <Emoji name="💡" style={{ width: 18, height: 18 }} />
            <Text style={{ fontSize: 'body', color: '#38BDF8', bold: true, fontFamily: 'monospace' }}>{/* {{替换：标题}} */}实战案例</Text>
          </Box>
          <Box style={{ background: 'rgba(15,23,42,0.5)', borderRadius: 'sm', padding: 'md', gap: 'xs' }}>
            <Text style={{ fontSize: 'label', color: '#94A3B8', fontFamily: 'monospace' }}># 打印9的乘法表</Text>
            <Text style={{ fontSize: 'label', color: '#F472B6', fontFamily: 'monospace' }}>for i in range(1, 10):</Text>
            <Text style={{ fontSize: 'label', color: '#34D399', fontFamily: 'monospace' }}>{'print(f"9 x {i} = {9*i}")'}</Text>
          </Box>
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
