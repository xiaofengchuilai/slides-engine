<Slide>
  {/* educational/1667 数字与数学·认识时钟：标题 + 左时钟(圆形表盘) + 右时针分针/快速认时间/小技巧 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #F8FAFC 0%, #F1F5F9 100%)', padding: 'xxl xl', gap: 'lg' }}>
    <Box style={{ alignItems: 'center', gap: 'xs' }}>
      <Text style={{ fontSize: 'title', color: '#1F2937', bold: true }}>{/* {{替换：标题}} */}认识时钟</Text>
      <Text style={{ fontSize: 'body', color: '#6B7280' }}>{/* {{替换：副标题}} */}学会看时间</Text>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'row', gap: 'xl' }}>
      {/* 左侧：时钟展示 */}
      <Box style={{ flex: 1, alignItems: 'center', justifyContent: 'center' }}>
        <Box style={{ width: 300, height: 300, borderRadius: 150, background: '#FFFFFF', border: '6px solid #CBD5E1', alignItems: 'center', justifyContent: 'center', position: 'relative', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
          <Text style={{ position: 'absolute', top: 14, left: '50%', marginLeft: -10, fontSize: 'title', color: '#374151', bold: true }}>12</Text>
          <Text style={{ position: 'absolute', bottom: 14, left: '50%', marginLeft: -8, fontSize: 'title', color: '#374151', bold: true }}>6</Text>
          <Text style={{ position: 'absolute', left: 14, top: '50%', marginTop: -16, fontSize: 'title', color: '#374151', bold: true }}>9</Text>
          <Text style={{ position: 'absolute', right: 14, top: '50%', marginTop: -16, fontSize: 'title', color: '#374151', bold: true }}>3</Text>
          {/* 时针(短)与分针(长)：用两根粗细/长短不同的竖条模拟指针 */}
          <Box style={{ position: 'absolute', top: '50%', left: '50%', width: 5, height: 78, background: '#374151', borderRadius: 2, marginLeft: -2, marginTop: -78, rotate: 90 }} />
          <Box style={{ position: 'absolute', top: '50%', left: '50%', width: 3, height: 108, background: '#F43F5E', borderRadius: 2, marginLeft: -1, marginTop: -108 }} />
          <Box style={{ width: 12, height: 12, borderRadius: 6, background: '#374151' }} />
        </Box>
      </Box>
      {/* 右侧：说明区 */}
      <Box style={{ flex: 1, gap: 'md' }}>
        <Box style={{ background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 'md', padding: 'lg' }}>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', marginBottom: 'md' }}>
            <Emoji name="📍" style={{ width: 20, height: 20 }} />
            <Text style={{ fontSize: 'card', color: '#1F2937', bold: true }}>{/* {{替换：标题}} */}时针与分针</Text>
          </Box>
          <Box style={{ gap: 'sm' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'md', background: '#F8FAFC', borderRadius: 'sm', padding: 'sm' }}>
              <Box style={{ width: 48, height: 8, background: '#374151', borderRadius: 4 }} />
              <Box>
                <Text style={{ fontSize: 'body', color: '#1F2937', bold: true }}>短针 = 时针</Text>
                <Text style={{ fontSize: 'label', color: '#6B7280' }}>{/* {{替换：说明}} */}指向几就是几点</Text>
              </Box>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'md', background: '#FFF1F2', borderRadius: 'sm', padding: 'sm' }}>
              <Box style={{ width: 72, height: 6, background: '#F43F5E', borderRadius: 3 }} />
              <Box>
                <Text style={{ fontSize: 'body', color: '#BE123C', bold: true }}>长针 = 分针</Text>
                <Text style={{ fontSize: 'label', color: '#6B7280' }}>{/* {{替换：说明}} */}走一圈是60分钟</Text>
              </Box>
            </Box>
          </Box>
        </Box>
        <Box style={{ background: '#ECFDF5', border: '1px solid #A7F3D0', borderRadius: 'md', padding: 'lg' }}>
          <Text style={{ fontSize: 'card', color: '#065F46', bold: true, marginBottom: 'sm' }}>{/* {{替换：标题}} */}快速认时间</Text>
          <Box style={{ gap: 'xs' }}>
            {[
              '分针指向12 → 整点',
              '分针指向6 → 半点(30分)',
              '分针指向3 → 15分',
              '分针指向9 → 45分',
            ].map((x, i) => (
              <Box key={i} style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 'sm' }}>
                <Text style={{ fontSize: 'label', color: '#059669', bold: true }}>{i + 1}.</Text>
                <Text style={{ fontSize: 'label', color: '#4B5563' }}>{/* {{替换：要点}} */}{x}</Text>
              </Box>
            ))}
          </Box>
        </Box>
        <Box style={{ background: '#FFFBEB', flexDirection: 'row', alignItems: 'center', padding: 'md', borderRadius: 'sm' }}>
          <Box style={{ width: 4, height: 40, background: '#F59E0B', borderRadius: 2, marginRight: 'md' }} />
          <Text style={{ fontSize: 'body', color: '#92400E', lineHeight: 1.6, flex: 1 }}>{/* {{替换：小技巧}} */}小技巧：时针在2和3之间，分针指向6，就是2点30分(2点半)</Text>
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
