<Slide>
  {/* educational/1670 古典文学·名著导读：标题 + 4人物卡 + 故事梗概 + 3主题标签 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FAF9F7 0%, #F3F1ED 100%)', padding: 'xxl xl', gap: 'lg' }}>
    <Box style={{ alignItems: 'center', gap: 'xs' }}>
      <Text style={{ fontSize: 'title', color: '#1F2937', fontFamily: 'serif', bold: true }}>{/* {{替换：标题}} */}《西游记》导读</Text>
      <Text style={{ fontSize: 'body', color: '#6B7280' }}>{/* {{替换：副标题}} */}明·吴承恩 · 四大名著之一</Text>
      <Box style={{ flexDirection: 'row', gap: 'md' }}>
        <Emoji name="🐵" style={{ width: 28, height: 28 }} />
        <Emoji name="🐷" style={{ width: 28, height: 28 }} />
        <Emoji name="🏇" style={{ width: 28, height: 28 }} />
      </Box>
    </Box>
    <Box style={{ flexDirection: 'row', gap: 'md' }}>
      {[
        ['孙悟空', '齐天大圣', '机智勇敢', '神通广大', '勇气与智慧', '#D97706', 'rgba(217,119,6,0.08)', '🐵'],
        ['猪八戒', '天蓬元帅', '憨厚可爱', '力大无穷', '人性弱点', '#DB2777', 'rgba(219,39,119,0.08)', '🐷'],
        ['沙悟净', '卷帘大将', '忠厚老实', '任劳任怨', '忠诚品质', '#0284C7', 'rgba(2,132,199,0.08)', '🏇'],
        ['唐僧', '金蝉子转世', '慈悲为怀', '意志坚定', '理想信念', '#7C3AED', 'rgba(124,58,237,0.08)', '🧙'],
      ].map((x, i) => (
        <Box key={i} style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 'md', padding: 'lg', alignItems: 'center' }}>
          <Emoji name={x[7]} style={{ width: 36, height: 36, marginBottom: 'sm' }} />
          <Text style={{ fontSize: 'card', color: x[5], bold: true, marginBottom: 'xs' }}>{/* {{替换：人物}} */}{x[0]}</Text>
          <Text style={{ fontSize: 'label', color: x[5], bold: true, marginBottom: 'sm' }}>{/* {{替换：称号}} */}{x[1]}</Text>
          <Text style={{ fontSize: 'label', color: '#4B5563' }}>{/* {{替换：品质1}} */}{x[2]}</Text>
          <Text style={{ fontSize: 'label', color: '#4B5563' }}>{/* {{替换：品质2}} */}{x[3]}</Text>
          <Box style={{ background: x[6], borderRadius: 'sm', padding: 'xs', marginTop: 'sm' }}>
            <Text style={{ fontSize: 'label', color: x[5], bold: true }}>{/* {{替换：代表}} */}代表: {x[4]}</Text>
          </Box>
        </Box>
      ))}
    </Box>
    <Box style={{ background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 'md', padding: 'lg' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', marginBottom: 'sm' }}>
        <Emoji name="📚" style={{ width: 18, height: 18 }} />
        <Text style={{ fontSize: 'card', color: '#1F2937', bold: true }}>{/* {{替换：标题}} */}故事梗概</Text>
      </Box>
      <Text style={{ fontSize: 'body', color: '#4B5563', lineHeight: 1.8 }}>{/* {{替换：梗概}} */}唐僧师徒四人历经九九八十一难，从东土大唐前往西天取经的故事。孙悟空大闹天宫后被如来佛祖压在五行山下，五百年后被唐僧救出，成为取经路上的大弟子。一路上降妖除魔，最终到达灵山，取得真经，修成正果。</Text>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'row', gap: 'md' }}>
      {[
        ['81难', '九九归真', '🏔'],
        ['降妖除魔', '惩恶扬善', '⚔'],
        ['修成正果', '坚持不懈', '🏆'],
      ].map((x, i) => (
        <Box key={i} style={{ flex: 1, background: '#F8FAFC', border: '1px solid #E5E7EB', borderRadius: 'md', padding: 'lg', alignItems: 'center', justifyContent: 'center' }}>
          <Emoji name={x[2]} style={{ width: 24, height: 24, marginBottom: 'sm' }} />
          <Text style={{ fontSize: 'card', color: '#1F2937', bold: true }}>{/* {{替换：主题}} */}{x[0]}</Text>
          <Text style={{ fontSize: 'label', color: '#6B7280', marginTop: 'xs' }}>{/* {{替换：说明}} */}{x[1]}</Text>
        </Box>
      ))}
    </Box>
  </Box>
</Slide>
