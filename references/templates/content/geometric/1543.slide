<Slide>
  {/* geometric/1543 蜂巢结构：深色底 + 六边形网格 3-4-3 错位排列（10 个六边形） */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #0F172A 0%, #4C1D95 50%, #0F172A 100%)', padding: 'xxl xl', alignItems: 'center', justifyContent: 'center' }}>
    <Text style={{ fontSize: 'title', color: '#FFFFFF', bold: true, textAlign: 'center', marginBottom: 'sm' }}>{/* {{替换：页面标题}} */}蜂巢结构</Text>
    <Text style={{ fontSize: 'body', color: '#DDD6FE', textAlign: 'center', marginBottom: 'xl' }}>{/* {{替换：副标题}} */}六边形网格系统的完美对称与空间利用</Text>
    <Box style={{ position: 'relative', width: 711, height: 400 }}>
      {[
        [121, 0, '01', '稳定性', 'linear-gradient(135deg, #06B6D4 0%, #2563EB 100%)'],
        [283, 0, '02', '高效性', 'linear-gradient(135deg, #A855F7 0%, #DB2777 100%)'],
        [445, 0, '03', '扩展性', 'linear-gradient(135deg, #F59E0B 0%, #EA580C 100%)'],
        [40, 119, '04', '连接性', 'linear-gradient(135deg, #22C55E 0%, #059669 100%)'],
        [202, 119, '05', '协同性', 'linear-gradient(135deg, #F43F5E 0%, #DC2626 100%)'],
        [364, 119, '06', '优化性', 'linear-gradient(135deg, #6366F1 0%, #3B82F6 100%)'],
        [526, 119, '07', '适应性', 'linear-gradient(135deg, #14B8A6 0%, #0891B2 100%)'],
        [121, 238, '08', '持续性', 'linear-gradient(135deg, #8B5CF6 0%, #9333EA 100%)'],
        [283, 238, '09', '创新性', 'linear-gradient(135deg, #D946EF 0%, #EC4899 100%)'],
        [445, 238, '10', '完整性', 'linear-gradient(135deg, #84CC16 0%, #16A34A 100%)'],
      ].map((h, i) => (
        <Box key={i} style={{ position: 'absolute', left: h[0], top: h[1], width: 144, height: 158, alignItems: 'center', justifyContent: 'center' }}>
          <Shape type="hexagon" style={{ position: 'absolute', top: 0, left: 0, width: 144, height: 158, fill: h[4], boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }} />
          <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true, marginBottom: 'xs' }}>{/* {{替换：编号}} */}{h[2]}</Text>
          <Text style={{ fontSize: 'label', color: '#FFFFFF' }}>{/* {{替换：名称}} */}{h[3]}</Text>
        </Box>
      ))}
    </Box>
  </Box>
</Slide>
