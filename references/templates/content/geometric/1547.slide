<Slide>
  {/* geometric/1547 螺旋演进：深色底 + 起点/Step1-6/终点 沿螺旋路径排布 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #111827 0%, #1E1B4B 50%, #111827 100%)', padding: 'xl', alignItems: 'center', justifyContent: 'center' }}>
    <Text style={{ fontSize: 'title', color: '#FFFFFF', bold: true, textAlign: 'center', marginBottom: 'xs' }}>{/* {{替换：页面标题}} */}螺旋演进</Text>
    <Text style={{ fontSize: 'body', color: '#D1D5DB', textAlign: 'center', marginBottom: 'lg' }}>{/* {{替换：副标题}} */}从起点到终点的渐进式发展路径</Text>
    {/* 螺旋画布 1000x480 居中 */}
    <Box style={{ position: 'relative', width: 1000, height: 480, marginLeft: 140 }}>
      {/* 起点 - 中心 */}
      <Box style={{ position: 'absolute', left: 385, top: 165, width: 112, height: 112, borderRadius: 56, background: 'linear-gradient(135deg, #4F46E5 0%, #9333EA 100%)', border: '4px solid #FFFFFF', alignItems: 'center', justifyContent: 'center', boxShadow: '0 16px 48px rgba(0,0,0,0.28)' }}>
        <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>起点</Text>
        <Text style={{ fontSize: 'label', color: '#FFFFFF' }}>Start</Text>
      </Box>
      {/* Step 1 - 右上 */}
      <Box style={{ position: 'absolute', left: 470, top: 80, width: 100, height: 100, background: 'linear-gradient(135deg, #3B82F6 0%, #06B6D4 100%)', borderRadius: 'sm', alignItems: 'center', justifyContent: 'center', boxShadow: '0 12px 36px rgba(0,0,0,0.22)', rotate: 12 }}>
        <Text style={{ fontSize: 'body', color: '#FFFFFF', bold: true }}>Step 1</Text>
        <Text style={{ fontSize: 'label', color: '#FFFFFF' }}>探索</Text>
      </Box>
      {/* Step 2 - 右上角圆 */}
      <Box style={{ position: 'absolute', left: 620, top: 20, width: 108, height: 108, borderRadius: 54, background: 'linear-gradient(135deg, #06B6D4 0%, #14B8A6 100%)', alignItems: 'center', justifyContent: 'center', boxShadow: '0 12px 36px rgba(0,0,0,0.22)' }}>
        <Text style={{ fontSize: 'body', color: '#FFFFFF', bold: true }}>Step 2</Text>
        <Text style={{ fontSize: 'label', color: '#FFFFFF' }}>研究</Text>
      </Box>
      {/* Step 3 - 右侧八角 */}
      <Box style={{ position: 'absolute', left: 800, top: 130, width: 108, height: 108, alignItems: 'center', justifyContent: 'center' }}>
        <Shape type="octagon" style={{ position: 'absolute', top: 0, left: 0, width: 108, height: 108, fill: '#10B981', boxShadow: '0 12px 36px rgba(0,0,0,0.22)' }} />
        <Text style={{ fontSize: 'body', color: '#FFFFFF', bold: true }}>Step 3</Text>
        <Text style={{ fontSize: 'label', color: '#FFFFFF' }}>开发</Text>
      </Box>
      {/* Step 4 - 右下菱形 */}
      <Box style={{ position: 'absolute', left: 720, top: 330, width: 108, height: 108, alignItems: 'center', justifyContent: 'center' }}>
        <Shape type="diamond" style={{ position: 'absolute', top: 0, left: 0, width: 108, height: 108, fill: '#F59E0B', boxShadow: '0 12px 36px rgba(0,0,0,0.22)', rotate: 45 }} />
        <Text style={{ fontSize: 'body', color: '#FFFFFF', bold: true }}>Step 4</Text>
        <Text style={{ fontSize: 'label', color: '#FFFFFF' }}>测试</Text>
      </Box>
      {/* Step 5 - 下方圆 */}
      <Box style={{ position: 'absolute', left: 390, top: 360, width: 124, height: 124, borderRadius: 62, background: 'linear-gradient(135deg, #F43F5E 0%, #EC4899 100%)', alignItems: 'center', justifyContent: 'center', boxShadow: '0 12px 36px rgba(0,0,0,0.22)' }}>
        <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>Step 5</Text>
        <Text style={{ fontSize: 'label', color: '#FFFFFF' }}>部署</Text>
      </Box>
      {/* Step 6 - 左侧五边形 */}
      <Box style={{ position: 'absolute', left: 110, top: 110, width: 108, height: 108, alignItems: 'center', justifyContent: 'center' }}>
        <Shape type="pentagon" style={{ position: 'absolute', top: 0, left: 0, width: 108, height: 108, fill: '#8B5CF6', boxShadow: '0 12px 36px rgba(0,0,0,0.22)' }} />
        <Text style={{ fontSize: 'body', color: '#FFFFFF', bold: true }}>Step 6</Text>
        <Text style={{ fontSize: 'label', color: '#FFFFFF' }}>监控</Text>
      </Box>
      {/* 终点 - 顶部偏左 */}
      <Box style={{ position: 'absolute', left: 290, top: 0, width: 128, height: 128, borderRadius: 'lg', background: 'linear-gradient(135deg, #D946EF 0%, #8B5CF6 50%, #4F46E5 100%)', border: '4px solid #FFFFFF', alignItems: 'center', justifyContent: 'center', boxShadow: '0 16px 48px rgba(0,0,0,0.28)' }}>
        <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true, marginBottom: 'xs' }}>终点</Text>
        <Text style={{ fontSize: 'label', color: '#FFFFFF' }}>Success</Text>
      </Box>
    </Box>
  </Box>
</Slide>
