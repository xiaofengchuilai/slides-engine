<Slide>
  {/* literary/1557 诗意栖居：禅窗 + 三联屏风 + 底部禅语 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #ECFDF5 0%, #F0FDF4 50%, #F0FDFA 100%)', padding: 'xl xxl' }}>
    <Box style={{ flex: 1, flexDirection: 'column', gap: 'md' }}>
      {/* 顶部：禅窗 + 标题 */}
      <Box style={{ alignItems: 'center', gap: 'sm' }}>
        <Box style={{ width: 120, height: 120, borderRadius: 60, border: '8px solid #065F46', background: 'linear-gradient(135deg, #FFFFFF 0%, #F9FAFB 100%)', alignItems: 'center', justifyContent: 'center', boxShadow: '0 16px 48px rgba(0,0,0,0.28)' }}>
          <Box style={{ position: 'absolute', width: 92, height: 92, borderRadius: 46, border: '2px solid #059669' }} />
          <Emoji name="🌿" style={{ width: 42, height: 42 }} />
        </Box>
        <Text style={{ fontSize: 'title', color: '#064E3B', fontFamily: 'serif', letterSpacing: 3 }}>{/* {{替换：主标题}} */}诗意栖居</Text>
      </Box>
      {/* 三联屏风 */}
      <Box style={{ flexDirection: 'row', gap: 'lg', flex: 1 }}>
        <Box style={{ flex: 1, background: '#FFFFFF', borderRadius: 'sm', padding: 'lg', alignItems: 'center', boxShadow: '0 12px 36px rgba(0,0,0,0.22)' }}>
          <Box style={{ width: '100%', height: 4, background: '#059669', borderRadius: 2, marginBottom: 'md' }} />
          <Emoji name="🎋" style={{ width: 38, height: 38, marginBottom: 'sm' }} />
          <Text style={{ fontSize: 'kpi', color: '#065F46', fontFamily: 'serif' }}>竹</Text>
          <Text style={{ fontSize: 'card', color: '#1F2937', fontFamily: 'serif', bold: true, marginTop: 'sm', marginBottom: 'sm' }}>{/* {{替换：屏风名}} */}宁静</Text>
          <Box style={{ height: 1, width: 80, background: '#6EE7B7', marginBottom: 'sm' }} />
          <Text style={{ fontSize: 'label', color: '#4B5563', textAlign: 'center', lineHeight: 1.7 }}>{/* {{替换：屏风内容}} */}心静则万物皆静<br />内观自省之道</Text>
        </Box>
        <Box style={{ flex: 1.2, background: 'linear-gradient(135deg, #ECFDF5 0%, #F0FDFA 100%)', borderRadius: 'sm', padding: 'lg', alignItems: 'center', border: '4px solid #047857', boxShadow: '0 16px 48px rgba(0,0,0,0.28)' }}>
          <Box style={{ width: 96, height: 22, background: '#064E3B', borderRadius: 11, marginBottom: 'md' }} />
          <Text style={{ fontSize: 'card', color: '#1F2937', fontFamily: 'serif', textAlign: 'center', lineHeight: 1.7, marginBottom: 'sm' }}>{/* {{替换：主屏引用}} */}"人诗意地<br />栖居在<br />大地上"</Text>
          <Box style={{ flexDirection: 'row', gap: 'xs', marginBottom: 'sm' }}>
            <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#059669' }} />
            <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#059669' }} />
            <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#059669' }} />
          </Box>
          <Text style={{ fontSize: 'label', color: '#4B5563', textAlign: 'center', lineHeight: 1.7 }}>{/* {{替换：主屏内容}} */}追寻内心的宁静<br />在诗意中找到<br />生活的真谛</Text>
        </Box>
        <Box style={{ flex: 1, background: '#FFFFFF', borderRadius: 'sm', padding: 'lg', alignItems: 'center', boxShadow: '0 12px 36px rgba(0,0,0,0.22)' }}>
          <Box style={{ width: '100%', height: 4, background: '#059669', borderRadius: 2, marginBottom: 'md' }} />
          <Emoji name="🍃" style={{ width: 38, height: 38, marginBottom: 'sm' }} />
          <Text style={{ fontSize: 'kpi', color: '#065F46', fontFamily: 'serif' }}>叶</Text>
          <Text style={{ fontSize: 'card', color: '#1F2937', fontFamily: 'serif', bold: true, marginTop: 'sm', marginBottom: 'sm' }}>{/* {{替换：屏风名}} */}自然</Text>
          <Box style={{ height: 1, width: 80, background: '#6EE7B7', marginBottom: 'sm' }} />
          <Text style={{ fontSize: 'label', color: '#4B5563', textAlign: 'center', lineHeight: 1.7 }}>{/* {{替换：屏风内容}} */}天人合一境界<br />与自然共生息</Text>
        </Box>
      </Box>
      {/* 底部禅语 */}
      <Box style={{ alignItems: 'center' }}>
        <Box style={{ background: 'rgba(6,78,59,0.1)', borderRadius: 24, padding: 'sm xl', border: '1px solid #059669' }}>
          <Text style={{ fontSize: 'body', color: '#064E3B', fontFamily: 'serif', letterSpacing: 1 }}>{/* {{替换：禅语}} */}一花一世界，一叶一菩提</Text>
        </Box>
      </Box>
      {/* 装饰竹叶（旋转） */}
      <Box style={{ position: 'absolute', top: 48, right: 64, opacity: 0.25, rotate: 12 }}>
        <Emoji name="🎋" style={{ width: 40, height: 40 }} />
      </Box>
      <Box style={{ position: 'absolute', bottom: 64, left: 48, opacity: 0.25, rotate: -12 }}>
        <Emoji name="🍃" style={{ width: 36, height: 36 }} />
      </Box>
    </Box>
  </Box>
</Slide>
