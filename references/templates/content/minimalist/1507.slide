<Slide>
  {/* minimalist/1507 产品特性：左 3 条特性（竖条锚点）+ 右大字集成方案 */}
  <Box style={{ height: 720, width: 1280, background: 'bg', padding: 'xxl xl', flexDirection: 'row', gap: 'xxl', alignItems: 'center' }}>
    <Box style={{ flex: 1 }}>
      <Text style={{ fontSize: 'title', color: 'text', bold: true, marginBottom: 'xl' }}>{/* {{替换：区块标题}} */}产品特性</Text>
      <Box style={{ gap: 'xl' }}>
        {[
          ['高性能', '采用先进的架构设计，响应速度提升300%，支持百万级并发访问。', '#0F172A'],
          ['易扩展', '模块化设计，支持灵活配置和快速扩展，满足不同业务场景需求。', '#CBD5E1'],
          ['强安全', '多层安全防护机制，通过国际权威安全认证，保障数据安全。', '#CBD5E1'],
        ].map((f, i) => (
          <Box key={i} style={{ flexDirection: 'row', gap: 'md' }}>
            <Box style={{ width: 4, background: f[2], borderRadius: 2, alignSelf: 'stretch' }} />
            <Box style={{ flex: 1 }}>
              <Text style={{ fontSize: 'card', color: 'text', bold: true }}>{/* {{替换：特性名}} */}{f[0]}</Text>
              <Text style={{ fontSize: 'body', color: 'muted', lineHeight: 1.6, marginTop: 'xs' }}>{/* {{替换：特性说明}} */}{f[1]}</Text>
            </Box>
          </Box>
        ))}
      </Box>
    </Box>
    <Box style={{ flex: 1, alignItems: 'center', justifyContent: 'center' }}>
      <Box style={{ alignItems: 'center' }}>
        <Text style={{ fontSize: 120, color: '#E2E8F0', bold: true, lineHeight: 1 }}>+</Text>
        <Text style={{ fontSize: 'card', color: 'text', marginTop: 'md' }}>{/* {{替换：主标语}} */}集成解决方案</Text>
        <Text style={{ fontSize: 'body', color: 'muted', marginTop: 'md' }}>{/* {{替换：副标语}} */}一站式服务平台</Text>
      </Box>
    </Box>
  </Box>
</Slide>
