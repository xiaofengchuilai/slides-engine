<Slide>
  {/* minimalist/1601 左文右图：核心观点 + 标题 + 数据，右侧错位双图 + 浮动标签 */}
  <Box style={{ height: 720, width: 1280, background: 'bg', padding: 'xxl xl' }}>
    <Box style={{ flexDirection: 'row', gap: 'xxl', flex: 1 }}>
      {/* 左列 40% */}
      <Box style={{ flex: 2, justifyContent: 'space-between' }}>
        <Box>
          <Box style={{ background: 'primary', padding: 'xs md', borderRadius: 'sm', alignSelf: 'flex-start', marginBottom: 'lg' }}>
            <Text style={{ fontSize: 'label', color: '#FFFFFF' }}>核心观点</Text>
          </Box>
          <Text style={{ fontSize: 'title', color: 'text', marginBottom: 'lg', lineHeight: 1.3 }}>{/* {{标题}} */}敏捷组织转型的五大支柱</Text>
          <Text style={{ fontSize: 'body', color: 'text', lineHeight: 1.6 }}>{/* {{段落}} */}传统组织架构已无法适应快速变化的市场环境。敏捷转型需要从文化、结构、流程、人才和技术五个维度系统性推进。</Text>
        </Box>
        <Box>
          <Box style={{ flexDirection: 'row', alignItems: 'flex-end', gap: 'sm' }}>
            <Text style={{ fontSize: 'kpi', color: 'text', bold: true, lineHeight: 1 }}>{/* {{数据}} */}82%</Text>
            <Text style={{ fontSize: 'body', color: 'muted', marginBottom: 'xs' }}>企业认为敏捷转型至关重要</Text>
          </Box>
          <Text style={{ fontSize: 'label', color: 'muted', marginTop: 'xs' }}>*数据来源：麦肯锡《2024全球组织转型报告》</Text>
        </Box>
      </Box>
      {/* 右列 60% */}
      <Box style={{ flex: 3, position: 'relative' }}>
        {/* 主图 */}
        <Box style={{ width: '85%', height: 260, alignSelf: 'flex-end', borderRadius: 'md', background: 'cardBg', marginBottom: 'lg' }}>
          {/* {{图片：组织架构对比图，有图填 assets/images/1601_main.png，无图删掉整个 <Image>}} */}
          <Image src="assets/images/1601_main.png" style={{ width: '100%', height: '100%', objectFit: 'contain' }} />
        </Box>
        {/* 小图深色块 */}
        <Box style={{ width: '55%', height: 200, background: 'primary', borderRadius: 'md', alignSelf: 'flex-start', alignItems: 'center', justifyContent: 'center', boxShadow: '0 12px 36px rgba(0,0,0,0.22)' }}>
          <Text style={{ fontSize: 'body', color: '#FFFFFF' }}>转型路径图</Text>
        </Box>
        {/* 浮动标签 */}
        <Box style={{ position: 'absolute', bottom: 4, right: 8, background: 'bg', padding: 'sm lg', borderRadius: 'sm', border: '1px solid #E5E7EB', boxShadow: '0 16px 48px rgba(0,0,0,0.28)' }}>
          <Text style={{ fontSize: 'label', color: 'muted' }}>平均转型周期</Text>
          <Box style={{ flexDirection: 'row', alignItems: 'flex-end', gap: 'xs' }}>
            <Text style={{ fontSize: 'kpi', color: 'text', bold: true, lineHeight: 1 }}>18</Text>
            <Text style={{ fontSize: 'body', color: 'muted' }}>个月</Text>
          </Box>
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
