<Slide>
  {/* minimalist/1604 不对称分栏：左窄列(标题+01/02条目) + 右宽列(主图+小卡片+浮动标签) */}
  <Box style={{ height: 720, width: 1280, background: 'bg', padding: 'xxl xl' }}>
    <Box style={{ flexDirection: 'row', gap: 'xxl', flex: 1 }}>
      {/* 左窄列 35% */}
      <Box style={{ flex: 2, justifyContent: 'space-between' }}>
        <Box>
          <Box style={{ width: 48, height: 4, background: 'primary', marginBottom: 'md' }} />
          <Text style={{ fontSize: 'title', color: 'text', marginBottom: 'md' }}>{/* {{标题}} */}品牌价值体系</Text>
          <Text style={{ fontSize: 'body', color: 'muted', marginBottom: 'xl' }}>Brand Value System</Text>
          <Box style={{ gap: 'lg' }}>
            {[
              ['01', '使命愿景', '明确企业存在的意义和长远目标，为团队指引方向。'],
              ['02', '核心价值观', '塑造企业文化，凝聚团队共识，形成行为准则。'],
            ].map((x, i) => (
              <Box key={i}>
                <Text style={{ fontSize: 'kpi', color: '#E5E7EB', lineHeight: 1, marginBottom: 'xs' }}>{x[0]}</Text>
                <Text style={{ fontSize: 'card', color: 'text', bold: true, marginBottom: 'xs' }}>{/* {{条目标题}} */}{x[1]}</Text>
                <Text style={{ fontSize: 'body', color: 'muted', lineHeight: 1.6 }}>{/* {{条目说明}} */}{x[2]}</Text>
              </Box>
            ))}
          </Box>
        </Box>
        <Box style={{ background: 'cardBg', padding: 'md', borderRadius: 'sm', boxShadow: '0 12px 36px rgba(0,0,0,0.22)' }}>
          <Text style={{ fontSize: 'body', color: 'text', bold: true, marginBottom: 'xs' }}>参考框架</Text>
          <Text style={{ fontSize: 'label', color: 'muted', lineHeight: 1.5 }}>基于Simon Sinek《从Why开始》理论体系构建</Text>
        </Box>
      </Box>
      {/* 右宽列 65% */}
      <Box style={{ flex: 3, position: 'relative' }}>
        {/* 主图：偏上偏右 */}
        <Box style={{ width: '85%', height: 240, alignSelf: 'flex-end', borderRadius: 'md', background: 'cardBg', marginBottom: 'xl', boxShadow: '0 12px 36px rgba(0,0,0,0.22)' }}>
          {/* {{图片：品牌架构图，有图填 assets/images/1604_main.png，无图删掉整个 <Image>}} */}
          <Image src="assets/images/1604_main.png" style={{ width: '100%', height: '100%', objectFit: 'contain' }} />
        </Box>
        {/* 小卡片：偏下偏左 */}
        <Box style={{ width: '78%', alignSelf: 'flex-start', background: 'bg', padding: 'xl', borderRadius: 'md', border: '1px solid #E5E7EB', flexDirection: 'row', gap: 'md', boxShadow: '0 12px 36px rgba(0,0,0,0.22)' }}>
          <Box style={{ width: 64, height: 64, background: 'primary', borderRadius: 'md', alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>95%</Text>
          </Box>
          <Box style={{ flex: 1 }}>
            <Text style={{ fontSize: 'card', color: 'text', bold: true, marginBottom: 'xs' }}>品牌认知度</Text>
            <Text style={{ fontSize: 'body', color: 'muted', lineHeight: 1.5 }}>{/* {{描述}} */}在目标客群中的品牌认知度达到95%，位居行业前三。</Text>
            <Text style={{ fontSize: 'label', color: 'muted', marginTop: 'xs' }}>*数据来源：第三方品牌调研，2024年Q3</Text>
          </Box>
        </Box>
        {/* 浮动标签 */}
        <Box style={{ position: 'absolute', bottom: 8, right: 8, background: 'primary', padding: 'sm md', borderRadius: 'sm', flexDirection: 'row' }}>
          <Text style={{ fontSize: 'label', color: '#FFFFFF' }}>连续3年荣获</Text>
          <Text style={{ fontSize: 'label', color: '#FFFFFF', bold: true }}>最佳雇主品牌</Text>
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
