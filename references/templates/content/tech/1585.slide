<Slide>
  {/* tech/1585 立体数据矩阵：三层递进卡 + 箭头连接 + 底部统计 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #0F172A 0%, #1E3A8A 100%)', padding: 'xl', alignItems: 'center' }}>
    {/* 网格背景装饰 */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, flexDirection: 'row', justifyContent: 'space-between', opacity: 0.05 }}>
      {[0, 1, 2, 3, 4, 5, 6, 7, 8].map((i) => (
        <Box key={i} style={{ width: 1, height: 720, background: '#22D3EE' }} />
      ))}
    </Box>
    <Text style={{ fontSize: 'title', color: '#22D3EE', bold: true, textAlign: 'center', marginBottom: 'xl' }}>{/* {{标题}} */}立体数据矩阵</Text>
    <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 'xl', alignSelf: 'stretch' }}>
      {[
        { title: 'Layer 1', sub: 'Input', color: '#22D3EE', icon: 'database' },
        { title: 'Layer 2', sub: 'Process', color: '#C084FC', icon: 'cogs' },
        { title: 'Layer 3', sub: 'Output', color: '#34D399', icon: 'chart-line' },
      ].map((x, i) => (
        <Box key={x.title} style={{ flexDirection: 'row', alignItems: 'center', gap: 'xl', flex: 1, justifyContent: 'center' }}>
          <Box style={{ width: 190, height: 190, border: `2px solid ${x.color}`, borderRadius: 'md', background: `linear-gradient(135deg, ${x.color}33 0%, #0F172A 100%)`, alignItems: 'center', justifyContent: 'center' }}>
            <FAIcon name={x.icon} style={{ fill: x.color, width: 38, height: 38, marginBottom: 'sm' }} />
            <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>{x.title}</Text>
            <Text style={{ fontSize: 'body', color: x.color, marginTop: 'xs' }}>{x.sub}</Text>
          </Box>
          {i < 2 && (
            <Box style={{ width: 44, height: 3, background: x.color, opacity: 0.5 }} />
          )}
        </Box>
      ))}
    </Box>
    <Box style={{ flexDirection: 'row', justifyContent: 'center', gap: 'xxl', marginTop: 'lg' }}>
      {[
        { val: '256', label: 'Nodes', color: '#22D3EE' },
        { val: '1024', label: 'Connections', color: '#C084FC' },
        { val: '99.9%', label: 'Accuracy', color: '#34D399' },
      ].map((x) => (
        <Box key={x.label} style={{ alignItems: 'center' }}>
          <Text style={{ fontSize: 'kpi', color: x.color, bold: true, lineHeight: 1.1, marginBottom: 'xs' }}>{x.val}</Text>
          <Text style={{ fontSize: 'body', color: '#94A3B8' }}>{x.label}</Text>
        </Box>
      ))}
    </Box>
  </Box>
</Slide>
