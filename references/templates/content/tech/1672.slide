    <Box style={{ flex: 1, position: 'relative' }}>
      {/* 中心图片（可选结构） */}
      {/* {{图片：有图填 assets/images/arch.png，无图删掉整个 <Image>}} */}
      <Image src="assets/images/arch.png" style={{ width: 420, height: 280, objectFit: 'cover', position: 'absolute', top: 130, left: 340 }} />
      {/* 四角能力卡 */}
      <Box style={{ position: 'absolute', top: 0, left: 0, width: 340 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', marginBottom: 'sm' }}>
          <Box style={{ width: 32, height: 32, borderRadius: 16, background: 'primary', alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 'label', color: '#FFFFFF', bold: true }}>1</Text>
          </Box>
          <Text style={{ fontSize: 'card', color: 'text', bold: true }}>高性能计算引擎</Text>
        </Box>
        <Text style={{ fontSize: 'body', color: 'muted', lineHeight: 1.6 }}>采用向量化执行与列式存储技术，查询性能提升10倍以上，支持PB级数据秒级响应。</Text>
      </Box>
      <Box style={{ position: 'absolute', top: 0, right: 0, width: 340 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', marginBottom: 'sm' }}>
          <Box style={{ width: 32, height: 32, borderRadius: 16, background: 'primary', alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 'label', color: '#FFFFFF', bold: true }}>2</Text>
          </Box>
          <Text style={{ fontSize: 'card', color: 'text', bold: true }}>智能调度系统</Text>
        </Box>
        <Text style={{ fontSize: 'body', color: 'muted', lineHeight: 1.6 }}>基于机器学习的资源调度算法，自动优化任务分配，资源利用率提升40%。</Text>
      </Box>
      <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 340 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', marginBottom: 'sm' }}>
          <Box style={{ width: 32, height: 32, borderRadius: 16, background: 'primary', alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 'label', color: '#FFFFFF', bold: true }}>3</Text>
          </Box>
          <Text style={{ fontSize: 'card', color: 'text', bold: true }}>弹性扩展架构</Text>
        </Box>
        <Text style={{ fontSize: 'body', color: 'muted', lineHeight: 1.6 }}>支持水平扩展与垂直扩展，可根据业务负载自动伸缩，确保系统稳定运行。</Text>
      </Box>
      <Box style={{ position: 'absolute', bottom: 0, right: 0, width: 340 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', marginBottom: 'sm' }}>
          <Box style={{ width: 32, height: 32, borderRadius: 16, background: 'primary', alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 'label', color: '#FFFFFF', bold: true }}>4</Text>
          </Box>
          <Text style={{ fontSize: 'card', color: 'text', bold: true }}>安全防护体系</Text>
        </Box>
        <Text style={{ fontSize: 'body', color: 'muted', lineHeight: 1.6 }}>多层次安全机制，包括数据加密、访问控制、审计日志，满足等保三级要求。</Text>
