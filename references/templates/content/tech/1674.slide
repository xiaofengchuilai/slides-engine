<Slide>
  {/* tech/1674 平台核心功能模块：左主区 + 右两个功能块 */}
  <Box style={{ height: 720, width: 1280, background: 'bg', padding: 'xxl xl' }}>
    <Text style={{ fontSize: 'title', color: 'text', bold: true, marginBottom: 'lg' }}>{/* {{标题}} */}平台核心功能模块</Text>
    <Box style={{ flex: 1, flexDirection: 'row', gap: 'xl' }}>
      {/* 左侧主区域 */}
      <Box style={{ width: 560 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', marginBottom: 'sm' }}>
          <Box style={{ width: 40, height: 40, borderRadius: 'sm', background: 'primary', alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 'body', color: '#FFFFFF', bold: true }}>01</Text>
          </Box>
          <Text style={{ fontSize: 'title', color: 'text', bold: true }}>实时数据分析</Text>
        </Box>
        <Text style={{ fontSize: 'body', color: 'muted', lineHeight: 1.6, marginBottom: 'md' }}>基于流式计算引擎，实现毫秒级数据处理与分析，支持复杂事件处理、实时指标计算、异常检测等场景。</Text>
        {/* {{图片：有图填 assets/images/realtime.png，无图删掉整个 <Image>}} */}
        <Image src="assets/images/realtime.png" style={{ width: '100%', height: 240, objectFit: 'cover' }} />
        <Box style={{ flexDirection: 'row', gap: 'sm', marginTop: 'md', flexWrap: 'wrap' }}>
          {['流式计算', 'CEP处理', '实时告警'].map((t) => (
            <Box key={t} style={{ background: 'cardBg', borderRadius: 'sm', padding: 'xs lg' }}>
              <Text style={{ fontSize: 'label', color: 'muted' }}>{t}</Text>
            </Box>
          ))}
        </Box>
      </Box>
      {/* 右侧内容 */}
      <Box style={{ flex: 1, gap: 'xl', justifyContent: 'space-between' }}>
        <Box>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', marginBottom: 'sm' }}>
            <Box style={{ width: 32, height: 32, borderRadius: 'sm', background: 'primary', alignItems: 'center', justifyContent: 'center' }}>
              <Text style={{ fontSize: 'label', color: '#FFFFFF', bold: true }}>02</Text>
            </Box>
            <Text style={{ fontSize: 'card', color: 'text', bold: true }}>智能报表引擎</Text>
          </Box>
          <Text style={{ fontSize: 'body', color: 'muted', lineHeight: 1.6, marginBottom: 'sm' }}>拖拽式报表设计器，支持50+图表类型，自动生成数据洞察建议，让数据分析更简单高效。</Text>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'md' }}>
            <Text style={{ fontSize: 'label', color: 'muted' }}>报表生成效率</Text>
            <Text style={{ fontSize: 'kpi', color: 'text', bold: true }}>3x</Text>
          </Box>
        </Box>
        <Box>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', marginBottom: 'sm' }}>
            <Box style={{ width: 32, height: 32, borderRadius: 'sm', background: 'primary', alignItems: 'center', justifyContent: 'center' }}>
              <Text style={{ fontSize: 'label', color: '#FFFFFF', bold: true }}>03</Text>
            </Box>
            <Text style={{ fontSize: 'card', color: 'text', bold: true }}>数据资产管理</Text>
          </Box>
          <Text style={{ fontSize: 'body', color: 'muted', lineHeight: 1.6, marginBottom: 'sm' }}>全生命周期数据资产管理，包括元数据管理、数据血缘、数据质量监控，构建企业数据资产目录。</Text>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'md' }}>
            <Text style={{ fontSize: 'label', color: 'muted' }}>数据资产覆盖率</Text>
            <Text style={{ fontSize: 'kpi', color: 'text', bold: true }}>95%</Text>
          </Box>
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
