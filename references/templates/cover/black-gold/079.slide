    <Box style={{ position: 'absolute', top: 0, left: 640, width: 2, height: 720, background: '#EAB308', opacity: 0.1 }} />
    <Box style={{ position: 'absolute', top: 0, left: 960, width: 2, height: 720, background: '#EAB308', opacity: 0.1 }} />
    {/* 主内容区 */}
    <Box style={{ alignItems: 'center', maxWidth: 900 }}>
      <Box style={{ border: '1px solid #EAB308', background: 'rgba(234,179,8,0.05)', padding: 'sm xl', marginBottom: 'xl' }}>
