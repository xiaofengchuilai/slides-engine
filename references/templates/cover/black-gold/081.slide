<Slide>
  {/* black-gold/081 几何拼接：灰底 + 四角金框方块 + 金字标题 + 三段金线 + 副标题 + 落款 */}
  <Box style={{ height: 720, width: 1280, background: '#1F2937', alignItems: 'center', justifyContent: 'center' }}>
    {/* 几何装饰（四角金框方块，不旋转） */}
    <Box style={{ position: 'absolute', top: 64, left: 64, width: 128, height: 128, border: '2px solid #EAB308', opacity: 0.3, rotate: 45 }} />
    <Box style={{ position: 'absolute', top: 128, right: 96, width: 96, height: 96, border: '2px solid #EAB308', opacity: 0.3, rotate: -12 }} />
    <Box style={{ position: 'absolute', bottom: 80, left: 128, width: 112, height: 112, border: '2px solid #EAB308', opacity: 0.3, rotate: 12 }} />
    <Box style={{ position: 'absolute', bottom: 96, right: 80, width: 144, height: 144, border: '2px solid #EAB308', opacity: 0.3, rotate: -45 }} />
    {/* 主内容区 */}
    <Box style={{ alignItems: 'center', maxWidth: 900 }}>
      <Text style={{ fontSize: 'hero', color: '#EAB308', bold: true, marginBottom: 'xl' }}>{/* {{替换：主标题}} */}精品酒店管理</Text>
      {/* 三段金线 */}
      <Box style={{ flexDirection: 'row', gap: 'lg', marginBottom: 'xl' }}>
        <Box style={{ width: 96, height: 2, background: '#EAB308' }} />
        <Box style={{ width: 48, height: 2, background: '#EAB308' }} />
        <Box style={{ width: 64, height: 2, background: '#EAB308' }} />
      </Box>
      <Text style={{ fontSize: 'card', color: '#CA8A04', marginBottom: 'xxl' }}>{/* {{替换：副标题}} */}极致服务·奢华体验·品质生活</Text>
      <Text style={{ fontSize: 'body', color: '#9CA3AF' }}>{/* {{替换：落款}} */}酒店事业部 | 运营标准发布</Text>
    </Box>
  </Box>
</Slide>
