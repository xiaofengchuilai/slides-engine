<Slide>
  {/* black-gold/086 璀璨水晶：深黑渐变底 + 菱形水晶 + 闪光点 + 金字标题 + 副标题 + 菱形装饰 + 落款 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(180deg, #1A1A1A 0%, #000000 100%)', alignItems: 'center', justifyContent: 'center' }}>
    {/* 水晶装饰（右上/左下，降级为金框菱形） */}
    <Box style={{ position: 'absolute', top: 80, right: 128, width: 96, height: 96, background: 'rgba(234,179,8,0.3)', opacity: 0.3, borderRadius: 16 }}>
      <Box style={{ position: 'absolute', top: 8, left: 8, right: 8, bottom: 8, border: '1px solid #EAB308', borderRadius: 12 }} />
    </Box>
    <Box style={{ position: 'absolute', bottom: 96, left: 96, width: 80, height: 80, background: 'rgba(212,175,55,0.3)', opacity: 0.25, borderRadius: 14 }}>
      <Box style={{ position: 'absolute', top: 6, left: 6, right: 6, bottom: 6, border: '1px solid #D4AF37', borderRadius: 10 }} />
    </Box>
    {/* 闪光点 */}
    <Box style={{ position: 'absolute', top: 128, left: 192, width: 8, height: 8, borderRadius: 4, background: '#EAB308', boxShadow: '0 0 20px #ffd700, 0 0 40px rgba(255,215,0,0.5)' }} />
    <Box style={{ position: 'absolute', bottom: 160, right: 224, width: 8, height: 8, borderRadius: 4, background: '#EAB308', boxShadow: '0 0 20px #ffd700, 0 0 40px rgba(255,215,0,0.5)' }} />
    {/* 主内容区 */}
    <Box style={{ alignItems: 'center', maxWidth: 900 }}>
      <Text style={{ fontSize: 'hero', color: '#EAB308', bold: true, marginBottom: 'xl' }}>{/* {{替换：主标题}} */}高端晚宴邀请</Text>
      <Text style={{ fontSize: 'card', color: '#D4AF37', marginBottom: 'xl' }}>{/* {{替换：副标题}} */}珍馐美馔·名流雅集·尊贵时光</Text>
      {/* 菱形装饰组（旋转方块） */}
      <Box style={{ flexDirection: 'row', gap: 'sm', marginBottom: 'xl' }}>
        <Box style={{ width: 28, height: 28, background: 'rgba(234,179,8,0.2)', border: '1px solid #EAB308', rotate: 45 }} />
        <Box style={{ width: 28, height: 28, background: 'rgba(234,179,8,0.15)', border: '1px solid #D4AF37', rotate: 45 }} />
        <Box style={{ width: 28, height: 28, background: 'rgba(234,179,8,0.2)', border: '1px solid #EAB308', rotate: 45 }} />
      </Box>
      <Text style={{ fontSize: 'body', color: '#9CA3AF' }}>{/* {{替换：落款}} */}公关事务部 | 年度答谢晚宴</Text>
    </Box>
  </Box>
</Slide>
