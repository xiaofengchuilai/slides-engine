<Slide>
  {/* black-gold/158 璀璨流光：深黑渐变底 + 金色光晕 + 装饰线 + 金字标题 + 金线 + 副标题 + 落款 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #0A0A0A 0%, #1A1410 50%, #0F0F0F 100%)', alignItems: 'center', justifyContent: 'center' }}>
    {/* 金色光晕（右上/左下） */}
    <Box style={{ position: 'absolute', top: 0, right: 100, width: 280, height: 280, borderRadius: 140, background: 'rgba(255,215,0,0.12)' }} />
    <Box style={{ position: 'absolute', bottom: 0, left: 100, width: 250, height: 250, borderRadius: 125, background: 'rgba(218,165,32,0.1)' }} />
    {/* 主内容区 */}
    <Box style={{ alignItems: 'center', maxWidth: 900 }}>
      {/* 金色装饰线：短线 + 金点 */}
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'md', marginBottom: 'xl' }}>
        <Box style={{ width: 40, height: 2, background: 'rgba(255,215,0,0.6)' }} />
        <Box style={{ width: 12, height: 12, borderRadius: 6, background: '#FFD700', boxShadow: '0 0 12px rgba(255,215,0,0.6)' }} />
        <Box style={{ width: 40, height: 2, background: 'rgba(255,215,0,0.6)' }} />
      </Box>
      <Text style={{ fontSize: 'hero', color: '#EAB308', bold: true, letterSpacing: 4, marginBottom: 'xl' }}>{/* {{替换：主标题}} */}尊享会员盛典</Text>
      <Box style={{ width: 360, height: 4, background: 'linear-gradient(90deg, rgba(255,215,0,0) 0%, rgba(255,215,0,0.5) 50%, rgba(255,215,0,0) 100%)', borderRadius: 2, marginBottom: 'xl', boxShadow: '0 0 15px rgba(255,215,0,0.5)' }} />
      <Text style={{ fontSize: 'card', color: '#C9A961', letterSpacing: 2, marginBottom: 'xxl' }}>{/* {{替换：副标题}} */}璀璨流光·尊贵礼遇</Text>
      <Text style={{ fontSize: 'body', color: '#B8956F' }}>{/* {{替换：落款}} */}会员服务中心 | 年度答谢晚宴</Text>
    </Box>
  </Box>
</Slide>
