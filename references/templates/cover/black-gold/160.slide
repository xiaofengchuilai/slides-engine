<Slide>
  {/* black-gold/160 金辉熠熠：深黑渐变底 + 大光晕 + 顶部金饰 + 金字标题 + 金线 + 副标题 + 落款 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(180deg, #1A1410 0%, #0D0B08 55%, #000000 100%)', alignItems: 'center', justifyContent: 'center' }}>
    {/* 大范围光晕（右上/左下） */}
    <Box style={{ position: 'absolute', top: 0, right: 0, width: 500, height: 500, borderRadius: 250, background: 'rgba(255,215,0,0.07)' }} />
    <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 450, height: 450, borderRadius: 225, background: 'rgba(184,134,11,0.05)' }} />
    {/* 主内容区 */}
    <Box style={{ alignItems: 'center', maxWidth: 900 }}>
      {/* 金色顶部装饰：弧线 + 金点 */}
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', marginBottom: 'xl' }}>
        <Box style={{ width: 56, height: 2, borderRadius: 1, background: 'rgba(255,215,0,0.5)' }} />
        <Box style={{ width: 12, height: 12, borderRadius: 6, background: 'rgba(255,223,77,0.8)', boxShadow: '0 0 10px rgba(255,215,0,0.6)' }} />
      </Box>
      <Text style={{ fontSize: 'hero', color: '#EAB308', bold: true, letterSpacing: 4, marginBottom: 'xl' }}>{/* {{替换：主标题}} */}年度盛典晚宴</Text>
      {/* 金色底部装饰线 */}
      <Box style={{ width: 380, height: 5, background: 'linear-gradient(90deg, rgba(255,215,0,0) 0%, rgba(255,215,0,0.6) 50%, rgba(255,215,0,0) 100%)', borderRadius: 2, marginBottom: 'xl', boxShadow: '0 0 15px rgba(255,215,0,0.4)' }} />
      <Text style={{ fontSize: 'card', color: '#C9A961', letterSpacing: 2, marginBottom: 'xxl' }}>{/* {{替换：副标题}} */}金辉熠熠·璀璨夺目</Text>
      <Text style={{ fontSize: 'body', color: '#B8956F' }}>{/* {{替换：落款}} */}集团总部 | 新春答谢盛会</Text>
    </Box>
  </Box>
</Slide>
