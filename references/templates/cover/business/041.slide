<Slide>
  {/* cover/business/041 商务风-蓝色专业：深蓝渐变底 + 左上竖条 + 主标题 + 副标题 + 落款 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #1E3A8A 0%, #0F172A 100%)', padding: 'xxl xl', justifyContent: 'center' }}>
    {/* 装饰：右上光晕 + 左下大圆 + 右下小圆（纯几何，不用 blur） */}
    <Box style={{ position: 'absolute', top: 0, right: 0, width: 640, height: 720, background: '#3B82F6', opacity: 0.08 }} />
    <Box style={{ position: 'absolute', left: 0, bottom: 0, width: 500, height: 500, borderRadius: 250, background: '#3B82F6', opacity: 0.05 }} />
    <Box style={{ position: 'absolute', right: 40, bottom: 40, width: 300, height: 300, borderRadius: 150, background: '#3B82F6', opacity: 0.06 }} />
    {/* 内容区 */}
    <Box style={{ maxWidth: 1100 }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'xl', marginBottom: 40 }}>
        {/* 竖条（原 border-l-4，用细条替代） */}
        <Box style={{ width: 3, height: 96, background: '#3B82F6' }} />
        <Box>
          <Text style={{ fontSize: 16, color: '#60A5FA', bold: true, letterSpacing: 4, marginBottom: 'sm' }}>{/* {{替换：顶部英文标签}} */}BUSINESS REPORT 2025</Text>
          <Text style={{ fontSize: 72, color: '#FFFFFF', bold: true, lineHeight: 1.1 }}>{/* {{替换：主标题}} */}企业年度财务分析</Text>
        </Box>
      </Box>
      <Text style={{ fontSize: 24, color: '#D1D5DB', marginBottom: 40, marginLeft: 36 }}>{/* {{替换：副标题}} */}深度解析市场趋势与战略规划</Text>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'lg', marginLeft: 36 }}>
        <Box style={{ width: 12, height: 12, borderRadius: 6, background: '#3B82F6' }} />
        <Text style={{ fontSize: 16, color: '#9CA3AF' }}>{/* {{替换：部门}} */}财务部</Text>
        {/* 竖分隔线 */}
        <Box style={{ width: 1, height: 20, background: '#4B5563' }} />
        <Text style={{ fontSize: 16, color: '#9CA3AF' }}>{/* {{替换：日期}} */}2025年1月</Text>
      </Box>
    </Box>
  </Box>
</Slide>
