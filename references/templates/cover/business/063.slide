<Slide>
  {/* business/063 白底左文 + 右侧斜切色块（clip-path 引擎不支持 → 降级为右侧全高渐变块 + 左下 L 角饰） */}
  <Box style={{ width: 1280, height: 720, background: 'bg', position: 'relative' }}>
    {/* 右侧渐变块（原 2/5 斜切 → 全高竖向渐变，保留右上角切角视觉：用圆角右顶角） */}
    <Box style={{ position: 'absolute', top: 0, right: 0, width: 512, height: 720, background: 'linear-gradient(135deg, #2563EB 0%, #4338CA 100%)' }} />
    {/* 左下角饰（竖条+横条拼 L） */}
    <Box style={{ position: 'absolute', bottom: 0, left: 0, flexDirection: 'column' }}>
      <Box style={{ width: 4, height: 160, background: '#2563EB' }} />
      <Box style={{ width: 160, height: 4, background: '#2563EB' }} />
    </Box>
    {/* 主内容区 */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, justifyContent: 'center', padding: 'xxl xl' }}>
      <Box style={{ maxWidth: 640 }}>
        <Text style={{ fontSize: 'hero', color: 'text', bold: true, lineHeight: 1.2, marginBottom: 'xl' }}>{/* {{主标题}} */}供应链优化</Text>
        {/* 三级横条装饰 */}
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', marginBottom: 'xl' }}>
          <Box style={{ width: 96, height: 6, background: '#2563EB', borderRadius: 3 }} />
          <Box style={{ width: 48, height: 6, background: '#60A5FA', borderRadius: 3 }} />
          <Box style={{ width: 24, height: 6, background: '#93C5FD', borderRadius: 3 }} />
        </Box>
        <Text style={{ fontSize: 'body', color: 'muted', lineHeight: 1.5, marginBottom: 'xxl' }}>{/* {{副标题}} */}降本增效·敏捷响应·智能协同</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'lg' }}>
          <Text style={{ fontSize: 'label', color: 'text', letterSpacing: 1 }}>{/* {{落款一}} */}供应链管理部</Text>
          <Text style={{ fontSize: 'body', color: 'text', opacity: 0.5 }}>·</Text>
          <Text style={{ fontSize: 'label', color: 'text', letterSpacing: 1 }}>{/* {{落款二}} */}运营效率报告</Text>
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
