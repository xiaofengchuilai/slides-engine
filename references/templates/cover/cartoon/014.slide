<Slide>
  {/* cartoon/014 波点背景：粉紫渐变底 + 白卡 + 紫色边框 + 大标题 + 图标装饰 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FBCFE8 0%, #E9D5FF 100%)', alignItems: 'center', justifyContent: 'center' }}>
    {/* 波点装饰（顶部/底部圆点，替代径向渐变背景） */}
    <Box style={{ position: 'absolute', top: 64, right: 64, width: 24, height: 24, borderRadius: 12, background: 'rgba(255,255,255,0.6)' }} />
    <Box style={{ position: 'absolute', top: 112, right: 120, width: 16, height: 16, borderRadius: 8, background: 'rgba(255,255,255,0.5)' }} />
    <Box style={{ position: 'absolute', bottom: 64, left: 64, width: 24, height: 24, borderRadius: 12, background: 'rgba(255,255,255,0.6)' }} />
    <Box style={{ position: 'absolute', bottom: 120, left: 120, width: 14, height: 14, borderRadius: 7, background: 'rgba(255,255,255,0.5)' }} />
    {/* 齿轮装饰（右上，Emoji ⚙️） */}
    <Emoji name="⚙️" style={{ position: 'absolute', top: 72, right: 64, width: 48, height: 48, opacity: 0.8 }} />
    {/* 星星装饰（左下，Emoji 💫） */}
    <Emoji name="💫" style={{ position: 'absolute', bottom: 72, left: 64, width: 48, height: 48, opacity: 0.8 }} />
    {/* 主卡 */}
    <Box style={{ background: 'rgba(255,255,255,0.9)', borderRadius: 'lg', border: '8px solid #C084FC', padding: 'xxl', alignItems: 'center', boxShadow: '0 16px 48px rgba(0,0,0,0.28)' }}>
      <Text style={{ fontSize: 'hero', color: '#9333EA', bold: true, marginBottom: 'xl' }}>{/* {{替换：主标题}} */}创意工坊</Text>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'md' }}>
        <Emoji name="🎨" style={{ width: 28, height: 28 }} />
        <Text style={{ fontSize: 'card', color: '#374151', bold: true }}>{/* {{替换：副标题}} */}Creative Workshop</Text>
        <Emoji name="✨" style={{ width: 28, height: 28 }} />
      </Box>
    </Box>
  </Box>
</Slide>
