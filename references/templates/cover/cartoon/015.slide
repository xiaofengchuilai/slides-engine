    {/* NEW 徽章（右上红圆角标签，旋转 12°） */}
    <Box style={{ position: 'absolute', top: 96, right: 128, background: '#EF4444', borderRadius: 999, padding: 'md xl', rotate: 12, boxShadow: '0 12px 36px rgba(0,0,0,0.22)' }}>
      <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>NEW!</Text>
    </Box>
    {/* 爆炸星光装饰（左上/右下黄色多边形，降级为圆角色块） */}
