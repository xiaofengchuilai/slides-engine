    <Box style={{ position: 'absolute', bottom: 96, right: 96, width: 56, height: 56, borderRadius: 14, background: '#FBBF24', opacity: 0.6 }} />
    {/* 主卡 */}
    <Box style={{ background: '#FFFFFF', borderRadius: 'lg', border: '10px solid #FB923C', padding: 'xxl', alignItems: 'center', boxShadow: '0 16px 48px rgba(0,0,0,0.28)' }}>
      <Emoji name="🎉" style={{ width: 72, height: 72, marginBottom: 'xl' }} />
      <Text style={{ fontSize: 'hero', color: '#EA580C', bold: true, marginBottom: 'xl' }}>{/* {{替换：主标题}} */}儿童节特辑</Text>
