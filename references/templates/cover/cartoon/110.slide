<Slide>
  {/* cartoon/110 笑脸太阳：橙渐变底 + 太阳圆 + 光芒 + 爱心 + 大标题 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FFEDD5 0%, #FDBA74 100%)', alignItems: 'center', justifyContent: 'center' }}>
    {/* 太阳装饰（右上：黄圆 + 光芒线） */}
    <Box style={{ position: 'absolute', top: 48, right: 80, width: 112, height: 112, borderRadius: 56, background: '#F59E0B', alignItems: 'center', justifyContent: 'center' }}>
      <FAIcon name="smile" style={{ fill: '#1F2937', width: 48, height: 48 }} />
    </Box>
    {/* 太阳光芒（右上，旋转光线） */}
    <Box style={{ position: 'absolute', top: 16, right: 132, width: 4, height: 20, background: '#F59E0B', rotate: -45 }} />
    <Box style={{ position: 'absolute', bottom: 176, right: 132, width: 4, height: 20, background: '#F59E0B', rotate: -45 }} />
    <Box style={{ position: 'absolute', top: 96, right: 48, width: 20, height: 4, background: '#F59E0B', rotate: 45 }} />
    <Box style={{ position: 'absolute', top: 96, right: 216, width: 20, height: 4, background: '#F59E0B', rotate: 45 }} />
    {/* 爱心装饰（左下，红色圆点替代爱心形） */}
    <Box style={{ position: 'absolute', bottom: 112, left: 144, width: 40, height: 40, borderRadius: 20, background: '#F87171', opacity: 0.7 }} />
    {/* 主内容区 */}
    <Box style={{ alignItems: 'center', maxWidth: 900 }}>
      <Text style={{ fontSize: 'hero', color: '#E11D48', bold: true, marginBottom: 'xxl' }}>{/* {{替换：主标题}} */}阳光心态课</Text>
      <Text style={{ fontSize: 'card', color: '#B45309', bold: true, marginBottom: 'xxl' }}>{/* {{替换：副标题}} */}积极向上·快乐每天</Text>
      <Text style={{ fontSize: 'body', color: '#374151', bold: true }}>{/* {{替换：落款}} */}心理健康中心 | 正能量分享</Text>
    </Box>
  </Box>
</Slide>
