    <Box style={{ position: 'absolute', top: 78, left: 432, width: 416, height: 20, borderRadius: 20, background: '#4ADE80' }} />
    <Box style={{ position: 'absolute', top: 96, left: 446, width: 388, height: 16, borderRadius: 16, background: '#60A5FA' }} />
    <Box style={{ position: 'absolute', top: 110, left: 460, width: 360, height: 12, borderRadius: 12, background: '#C084FC' }} />
    {/* 云朵装饰（左下） */}
    <Box style={{ position: 'absolute', bottom: 112, left: 144, flexDirection: 'row', alignItems: 'flex-end' }}>
      <Box style={{ width: 48, height: 36, borderRadius: 24, background: '#FFFFFF' }} />
      <Box style={{ width: 56, height: 44, borderRadius: 28, background: '#FFFFFF', marginLeft: -12 }} />
      <Box style={{ width: 44, height: 32, borderRadius: 22, background: '#FFFFFF', marginLeft: -12 }} />
    </Box>
