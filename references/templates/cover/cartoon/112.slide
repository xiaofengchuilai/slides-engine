    <Box style={{ position: 'absolute', top: 0, left: 390, width: 500, height: 32, borderRadius: 32, background: '#F87171' }} />
    <Box style={{ position: 'absolute', top: 30, left: 404, width: 472, height: 28, borderRadius: 28, background: '#FB923C' }} />
