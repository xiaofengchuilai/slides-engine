    <Box style={{ position: 'absolute', bottom: 144, right: 176, flexDirection: 'row', alignItems: 'flex-end' }}>
      <Box style={{ width: 44, height: 32, borderRadius: 22, background: '#FFFFFF' }} />
      <Box style={{ width: 56, height: 40, borderRadius: 28, background: '#FFFFFF', marginLeft: -8 }} />
