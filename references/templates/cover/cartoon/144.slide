<Slide>
  {/* cartoon/144 糖果乐园：粉黄绿渐变底 + 彩色圆点 + 大标题 + 白色胶囊卡 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #F9A8D4 0%, #FEF08A 50%, #BBF7D0 100%)', alignItems: 'center', justifyContent: 'center' }}>
    {/* 糖果圆点装饰 */}
    <Box style={{ position: 'absolute', top: 96, left: 144, width: 64, height: 64, borderRadius: 32, background: '#F472B6', opacity: 0.7 }} />
    <Box style={{ position: 'absolute', top: 160, right: 176, width: 48, height: 48, borderRadius: 24, background: '#FACC15', opacity: 0.6 }} />
    <Box style={{ position: 'absolute', bottom: 144, left: 208, width: 56, height: 56, borderRadius: 28, background: '#4ADE80', opacity: 0.65 }} />
    <Box style={{ position: 'absolute', bottom: 112, right: 144, width: 40, height: 40, borderRadius: 20, background: '#C084FC', opacity: 0.55 }} />
    {/* 主内容区 */}
    <Box style={{ alignItems: 'center', maxWidth: 900 }}>
      <Text style={{ fontSize: 'hero', color: '#EC4899', bold: true, marginBottom: 'xl' }}>{/* {{替换：主标题}} */}缤纷糖果屋</Text>
      <Text style={{ fontSize: 'card', color: '#9333EA', bold: true, marginBottom: 'xxl' }}>{/* {{替换：副标题}} */}甜蜜世界·童话乐园</Text>
      {/* 白色胶囊卡 */}
      <Box style={{ background: 'rgba(255,255,255,0.9)', borderRadius: 999, padding: 'md xl', alignItems: 'center', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
        <Text style={{ fontSize: 'body', color: '#EC4899', bold: true }}>{/* {{替换：主办方}} */}儿童乐园</Text>
        <Text style={{ fontSize: 'label', color: '#6B7280' }}>{/* {{替换：活动}} */}主题活动介绍</Text>
      </Box>
    </Box>
  </Box>
</Slide>
