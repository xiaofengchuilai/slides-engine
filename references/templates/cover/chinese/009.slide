<Slide>
  {/* chinese/009 水墨山水：米色渐变底 + 远山色块 + 飞鸟线条 + 竹条 + 印章 + 标题 + 落款 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(180deg, #F5F3ED 0%, #E8E4D9 100%)', alignItems: 'center', justifyContent: 'center' }}>
    {/* 水墨晕染：左上/右上浅灰圆（降级为低透明度圆形） */}
    <Box style={{ position: 'absolute', top: 40, right: 80, width: 256, height: 256, borderRadius: 128, background: '#4A5568', opacity: 0.08 }} />
    <Box style={{ position: 'absolute', top: 160, left: 40, width: 160, height: 160, borderRadius: 80, background: '#4A5568', opacity: 0.06 }} />
    {/* 远山层叠：底部三层山形色块（降级为梯形/弧形条） */}
    <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 1280, height: 220, background: '#C4C7CC', opacity: 0.3, borderRadius: 800 }} />
    <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 1280, height: 160, background: '#9CA3AF', opacity: 0.4, borderRadius: 700 }} />
    <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 1280, height: 100, background: '#6B7280', opacity: 0.5, borderRadius: 600 }} />
    {/* 竹子装饰（左边缘绿色竖条） */}
    <Box style={{ position: 'absolute', top: 0, left: 64, width: 12, height: 720, background: 'linear-gradient(180deg, #3D5A3A 0%, #2D4A2A 100%)', opacity: 0.2 }} />
    <Box style={{ position: 'absolute', top: 80, left: 88, width: 8, height: 560, background: 'linear-gradient(180deg, #4A6B4A 0%, #3D5A3A 100%)', opacity: 0.2 }} />
    {/* 主内容区 */}
    <Box style={{ alignItems: 'center' }}>
      {/* 印章（旋转 12°，红框方块） */}
      <Box style={{ width: 56, height: 56, borderRadius: 'sm', border: '2px solid #A81810', alignItems: 'center', justifyContent: 'center', opacity: 0.7, alignSelf: 'flex-end', marginBottom: 'xl', marginRight: -40, rotate: 12 }}>
        <Text style={{ fontSize: 'body', color: '#A81810', bold: true }}>印</Text>
      </Box>
      <Text style={{ fontSize: 'hero', color: '#1F2937', bold: true, letterSpacing: 12, marginBottom: 'xl' }}>{/* {{替换：主标题}} */}演示标题</Text>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'md', marginBottom: 'xl' }}>
        <Box style={{ width: 64, height: 2, background: 'linear-gradient(90deg, rgba(107,114,128,0) 0%, #6B7280 100%)' }} />
        <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#6B7280' }} />
        <Box style={{ width: 64, height: 2, background: 'linear-gradient(90deg, #6B7280 0%, rgba(107,114,128,0) 100%)' }} />
      </Box>
      <Text style={{ fontSize: 'card', color: '#4B5563', letterSpacing: 6, marginBottom: 'xl' }}>{/* {{替换：副标题}} */}副标题文字</Text>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'md' }}>
        <Text style={{ fontSize: 'body', color: '#6B7280', letterSpacing: 2 }}>{/* {{替换：汇报人}} */}汇报人：张三</Text>
        <Text style={{ fontSize: 'body', color: '#6B7280' }}>|</Text>
        <Text style={{ fontSize: 'body', color: '#6B7280', letterSpacing: 2 }}>{/* {{替换：日期}} */}二〇二五年</Text>
      </Box>
    </Box>
    {/* 右下角落款（原竖排，改横排小字） */}
    <Text style={{ position: 'absolute', bottom: 32, right: 48, fontSize: 'label', color: '#6B7280', letterSpacing: 2, opacity: 0.5 }}>{/* {{替换：落款}} */}山水有清音</Text>
  </Box>
</Slide>
