    <Box style={{ position: 'absolute', top: 80, right: 80, width: 144, height: 144, borderRadius: 72, border: '2px solid rgba(30,64,175,0.3)' }} />
    <Box style={{ position: 'absolute', top: 96, right: 96, width: 112, height: 112, borderRadius: 56, border: '2px solid rgba(29,78,216,0.2)' }} />
    <Box style={{ position: 'absolute', top: 112, right: 112, width: 80, height: 80, borderRadius: 40, border: '2px solid rgba(30,64,175,0.3)' }} />
    <Box style={{ position: 'absolute', top: 148, left: 148, width: 56, height: 2, background: 'rgba(30,64,175,0.3)' }} />
    {/* 左下圆环 */}
    <Box style={{ position: 'absolute', bottom: 112, left: 80, width: 96, height: 96, borderRadius: 48, border: '2px solid rgba(29,78,216,0.25)' }} />
