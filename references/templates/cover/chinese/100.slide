<Slide>
  {/* chinese/100 梅兰竹菊：浅米底 + 竹条/梅点装饰 + 主标题 + 副标题 + 三色点 + 落款 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FAFAF8 0%, #F5F5F1 100%)', alignItems: 'center', justifyContent: 'center' }}>
    {/* 竹叶装饰（左上，绿竖条 + 斜线，旋转 ±30°） */}
    <Box style={{ position: 'absolute', top: 80, left: 80, width: 8, height: 208, background: '#166534', opacity: 0.2 }} />
    <Box style={{ position: 'absolute', top: 128, left: 96, width: 40, height: 3, background: '#15803D', opacity: 0.2, rotate: -30 }} />
    <Box style={{ position: 'absolute', top: 192, left: 96, width: 36, height: 3, background: '#15803D', opacity: 0.2, rotate: 30 }} />
    <Box style={{ position: 'absolute', top: 80, left: 64, width: 36, height: 3, background: '#15803D', opacity: 0.2, rotate: -30 }} />
    {/* 梅花装饰（右下，红点组） */}
    <Box style={{ position: 'absolute', bottom: 112, right: 96, width: 112, height: 112, opacity: 0.25 }}>
      <Box style={{ position: 'absolute', top: 40, left: 48, width: 16, height: 16, borderRadius: 8, background: '#EF4444' }} />
      <Box style={{ position: 'absolute', top: 24, left: 48, width: 12, height: 12, borderRadius: 6, background: '#EF4444' }} />
      <Box style={{ position: 'absolute', top: 40, left: 72, width: 12, height: 12, borderRadius: 6, background: '#EF4444' }} />
      <Box style={{ position: 'absolute', top: 56, left: 48, width: 12, height: 12, borderRadius: 6, background: '#EF4444' }} />
      <Box style={{ position: 'absolute', top: 40, left: 24, width: 12, height: 12, borderRadius: 6, background: '#EF4444' }} />
    </Box>
    {/* 主内容区 */}
    <Box style={{ alignItems: 'center', maxWidth: 900 }}>
      <Text style={{ fontSize: 'hero', color: '#292524', bold: true, lineHeight: 1.3, marginBottom: 'xxl' }}>{/* {{替换：主标题}} */}君子之道</Text>
      <Text style={{ fontSize: 'card', color: '#57534E', marginBottom: 'xxl', letterSpacing: 2 }}>{/* {{替换：副标题}} */}修身立德·志存高远</Text>
      <Box style={{ flexDirection: 'row', gap: 'md', justifyContent: 'center', marginBottom: 'xl' }}>
        <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#EF4444' }} />
        <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#15803D' }} />
        <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#EF4444' }} />
      </Box>
      <Text style={{ fontSize: 'body', color: '#6B7280' }}>{/* {{替换：落款}} */}人文学院 | 传统文化讲座</Text>
    </Box>
  </Box>
</Slide>
