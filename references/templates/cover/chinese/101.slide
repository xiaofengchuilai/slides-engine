<Slide>
  {/* chinese/101 书法挥毫：浅米底 + 笔触斜线 + 墨点 + 印章 + 主标题 + 副标题 + 落款 */}
  <Box style={{ height: 720, width: 1280, background: '#FAFAF8', alignItems: 'center', justifyContent: 'center' }}>
    {/* 书法笔触装饰（右上斜线） */}
    <Box style={{ position: 'absolute', top: 144, right: 128, width: 208, height: 4, background: 'linear-gradient(90deg, rgba(17,24,39,0) 0%, rgba(17,24,39,0.15) 50%, rgba(17,24,39,0) 100%)' }} />
    <Box style={{ position: 'absolute', top: 176, right: 64, width: 256, height: 4, background: 'linear-gradient(90deg, rgba(17,24,39,0) 0%, rgba(17,24,39,0.12) 50%, rgba(17,24,39,0) 100%)' }} />
    <Box style={{ position: 'absolute', bottom: 176, left: 80, width: 192, height: 4, background: 'linear-gradient(90deg, rgba(17,24,39,0.18) 0%, rgba(17,24,39,0) 100%)' }} />
    {/* 墨点装饰 */}
    <Box style={{ position: 'absolute', top: 224, right: 208, width: 28, height: 28, borderRadius: 14, background: '#111827', opacity: 0.2 }} />
    <Box style={{ position: 'absolute', bottom: 224, left: 192, width: 20, height: 20, borderRadius: 10, background: '#111827', opacity: 0.15 }} />
    {/* 印章（红块白字，旋转 -6°） */}
    <Box style={{ position: 'absolute', top: 128, right: 112, width: 56, height: 56, background: '#A81810', border: '2px solid #7F1D1D', alignItems: 'center', justifyContent: 'center', opacity: 0.85, rotate: -6 }}>
      <Text style={{ fontSize: 'body', color: '#FFFFFF', bold: true }}>书</Text>
    </Box>
    {/* 主内容区 */}
    <Box style={{ alignItems: 'center', maxWidth: 900 }}>
      <Text style={{ fontSize: 'hero', color: '#111827', bold: true, lineHeight: 1.3, marginBottom: 'xxl' }}>{/* {{替换：主标题}} */}书法艺术赏析</Text>
      <Text style={{ fontSize: 'card', color: '#4B5563', marginBottom: 'xxl', letterSpacing: 2 }}>{/* {{替换：副标题}} */}笔走龙蛇·墨韵流芳</Text>
      <Text style={{ fontSize: 'body', color: '#6B7280' }}>{/* {{替换：落款}} */}艺术研究中心 | 书法展览开幕</Text>
    </Box>
  </Box>
</Slide>
