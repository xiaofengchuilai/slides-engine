<Slide>
  {/* chinese/103 龙凤呈祥：米金底 + 龙纹/凤纹线条 + 祥云色块 + 主标题 + 副标题 + 三短线 + 落款 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FBF3E8 0%, #F7EBDD 100%)', alignItems: 'center', justifyContent: 'center' }}>
    {/* 龙纹装饰（左上：圆环 + 斜线，旋转 -12°） */}
    <Box style={{ position: 'absolute', top: 80, left: 64, width: 192, height: 192, opacity: 0.15 }}>
      <Box style={{ position: 'absolute', top: 96, left: 38, width: 115, height: 4, background: '#A81810', borderRadius: 2, rotate: -12 }} />
      <Box style={{ position: 'absolute', top: 76, left: 28, width: 40, height: 40, borderRadius: 20, border: '3px solid #A81810' }} />
      <Box style={{ position: 'absolute', top: 130, left: 128, width: 32, height: 32, borderRadius: 16, border: '3px solid #A81810' }} />
    </Box>
    {/* 凤纹装饰（右下：三条金线） */}
    <Box style={{ position: 'absolute', bottom: 96, right: 80, width: 176, height: 176, opacity: 0.12 }}>
      <Box style={{ position: 'absolute', top: 52, left: 40, width: 96, height: 4, background: '#A81810', borderRadius: 2 }} />
      <Box style={{ position: 'absolute', top: 96, left: 56, width: 64, height: 4, background: '#A81810', borderRadius: 2 }} />
      <Box style={{ position: 'absolute', top: 120, left: 88, width: 56, height: 4, background: '#A81810', borderRadius: 2 }} />
    </Box>
    {/* 祥云装饰（左侧椭圆色块） */}
    <Box style={{ position: 'absolute', top: 344, left: 128, width: 80, height: 32, borderRadius: 16, background: 'rgba(168,24,16,0.08)' }} />
    <Box style={{ position: 'absolute', top: 356, left: 144, width: 64, height: 28, borderRadius: 14, background: 'rgba(168,24,16,0.06)' }} />
    {/* 主内容区 */}
    <Box style={{ alignItems: 'center', maxWidth: 900 }}>
      <Text style={{ fontSize: 'hero', color: '#1C1917', bold: true, lineHeight: 1.3, marginBottom: 'xxl' }}>{/* {{替换：主标题}} */}新春团拜会</Text>
      <Text style={{ fontSize: 'card', color: '#7F1D1D', marginBottom: 'xxl', letterSpacing: 2 }}>{/* {{替换：副标题}} */}龙凤呈祥·万象更新</Text>
      <Box style={{ flexDirection: 'row', gap: 'lg', justifyContent: 'center', marginBottom: 'xl' }}>
        <Box style={{ width: 48, height: 2, background: '#A81810' }} />
        <Box style={{ width: 32, height: 2, background: '#A81810' }} />
        <Box style={{ width: 48, height: 2, background: '#A81810' }} />
      </Box>
      <Text style={{ fontSize: 'body', color: '#6B7280' }}>{/* {{替换：落款}} */}总裁办公室 | 新年致辞</Text>
    </Box>
  </Box>
</Slide>
