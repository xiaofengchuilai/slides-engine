<Slide>
  {/* chinese/104 折扇雅韵：米金底 + 扇形骨线 + 印章 + 主标题 + 副标题 + 落款 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FBF3E8 0%, #E7E5E4 100%)', alignItems: 'center', justifyContent: 'center' }}>
    {/* 折扇装饰（右下：扇骨线束） */}
    <Box style={{ position: 'absolute', bottom: 80, right: 80, width: 256, height: 192, opacity: 0.2 }}>
      {[-60, -40, -20, 0, 20, 40, 60].map((deg) => (
        <Box key={deg} style={{ position: 'absolute', bottom: 0, left: 128, width: 3, height: 192, background: '#78350F' }} />
      ))}
      <Box style={{ position: 'absolute', top: 0, left: 40, width: 208, height: 4, background: '#92400E', borderRadius: 2 }} />
    </Box>
    {/* 印章（红块白字，旋转 12°） */}
    <Box style={{ position: 'absolute', top: 112, left: 112, width: 56, height: 56, background: '#A81810', border: '2px solid #7F1D1D', alignItems: 'center', justifyContent: 'center', opacity: 0.8, rotate: 12 }}>
      <Text style={{ fontSize: 'body', color: '#FFFFFF', bold: true }}>雅</Text>
    </Box>
    {/* 主内容区 */}
    <Box style={{ alignItems: 'center', maxWidth: 900 }}>
      <Text style={{ fontSize: 'hero', color: '#1C1917', bold: true, lineHeight: 1.3, marginBottom: 'xxl' }}>{/* {{替换：主标题}} */}茶道品鉴</Text>
      <Text style={{ fontSize: 'card', color: '#78350F', marginBottom: 'xxl', letterSpacing: 2 }}>{/* {{替换：副标题}} */}茶香四溢·雅韵天成</Text>
      <Text style={{ fontSize: 'body', color: '#6B7280' }}>{/* {{替换：落款}} */}茶文化协会 | 茶艺交流会</Text>
    </Box>
  </Box>
</Slide>
