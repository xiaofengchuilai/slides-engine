<Slide>
  {/* chinese/141 笔墨氤氲：米灰渐变底 + 晕染圆 + 印章 + 题字 + 装饰线 + 大标题 + 副标题 + 落款 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #F5F4F1 0%, #FBF3E8 50%, #F5F4F1 100%)', alignItems: 'center', justifyContent: 'center' }}>
    {/* 水墨晕染圆（右上/左下，低透明度） */}
    <Box style={{ position: 'absolute', top: 108, right: 256, width: 256, height: 256, borderRadius: 128, background: '#94A3B8', opacity: 0.12 }} />
    <Box style={{ position: 'absolute', bottom: 180, left: 320, width: 224, height: 224, borderRadius: 112, background: '#F59E0B', opacity: 0.1 }} />
    {/* 印章（红块白字） */}
    <Box style={{ position: 'absolute', top: 80, right: 112, width: 56, height: 56, background: '#A81810', opacity: 0.9, alignItems: 'center', justifyContent: 'center' }}>
      <Text style={{ fontSize: 'body', color: '#FFFFFF', bold: true }}>韵</Text>
    </Box>
    {/* 题字装饰（左缘竖排改横排小字） */}
    <Text style={{ position: 'absolute', top: 128, left: 96, fontSize: 'label', color: 'rgba(120,53,15,0.5)', letterSpacing: 6 }}>{/* {{替换：题字}} */}墨韵流芳</Text>
    {/* 主内容区 */}
    <Box style={{ alignItems: 'center', maxWidth: 900 }}>
      {/* 装饰线：竖短线 + 菱形 */}
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', marginBottom: 'xl' }}>
        <Box style={{ width: 4, height: 32, background: '#7F1D1D' }} />
        <Box style={{ width: 12, height: 12, background: '#B45309', rotate: 45 }} />
        <Box style={{ width: 96, height: 2, background: '#B45309' }} />
      </Box>
      <Text style={{ fontSize: 'hero', color: '#0F172A', bold: true, letterSpacing: 4, lineHeight: 1.3, marginBottom: 'xxl' }}>{/* {{替换：主标题}} */}水墨丹青</Text>
      <Text style={{ fontSize: 'card', color: '#92400E', letterSpacing: 3, marginBottom: 'xxl' }}>{/* {{替换：副标题}} */}墨分五色·神韵天成</Text>
      <Text style={{ fontSize: 'body', color: '#92400E', letterSpacing: 2 }}>{/* {{替换：落款}} */}国画研究院 | 水墨画展</Text>
    </Box>
  </Box>
</Slide>
