<Slide>
  {/* chinese/142 雅韵天成：红米渐变底 + 花纹圆环 + 印章 + 竹叶 + 梅花 + 大标题 + 副标题 + 诗句卡 + 落款 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FBEDE8 0%, #FBF3E8 55%, #F5F4F1 100%)', alignItems: 'center', justifyContent: 'center' }}>
    {/* 淡雅花纹背景：两个圆环 + 曲线（降级为圆环 + 弧线） */}
    <Box style={{ position: 'absolute', top: 140, left: 240, width: 160, height: 160, borderRadius: 80, border: '1px solid #A81810', opacity: 0.1 }} />
    <Box style={{ position: 'absolute', bottom: 120, right: 240, width: 200, height: 200, borderRadius: 100, border: '1px solid #8B4513', opacity: 0.1 }} />
    {/* 印章（红块白字，旋转 12°） */}
    <Box style={{ position: 'absolute', top: 64, right: 96, width: 48, height: 48, background: '#A81810', opacity: 0.85, alignItems: 'center', justifyContent: 'center', rotate: 12 }}>
      <Text style={{ fontSize: 'body', color: '#FFFFFF', bold: true }}>雅</Text>
    </Box>
    {/* 竹叶装饰（左下绿线条） */}
    <Box style={{ position: 'absolute', bottom: 80, left: 80, opacity: 0.3 }}>
      <Box style={{ width: 4, height: 80, background: '#166534' }} />
      <Box style={{ width: 40, height: 3, background: '#166534', marginLeft: 2 }} />
      <Box style={{ width: 40, height: 3, background: '#166534', marginTop: 8 }} />
      <Box style={{ width: 36, height: 3, background: '#166534', marginTop: 8 }} />
    </Box>
    {/* 梅花装饰（右下粉红圆点） */}
    <Box style={{ position: 'absolute', bottom: 80, right: 96, flexDirection: 'row', gap: 'sm' }}>
      <Box style={{ width: 32, height: 32, borderRadius: 16, background: 'linear-gradient(135deg, #FBCFE8 0%, #FECACA 100%)', opacity: 0.6 }} />
      <Box style={{ width: 24, height: 24, borderRadius: 12, background: 'linear-gradient(135deg, #FCE7F3 0%, #FEE2E2 100%)', opacity: 0.5 }} />
    </Box>
    {/* 主内容区 */}
    <Box style={{ alignItems: 'center', maxWidth: 900 }}>
      {/* 装饰线：短线 + 圆点 + 标签 */}
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', marginBottom: 'xl' }}>
        <Box style={{ width: 48, height: 2, background: '#7F1D1D' }} />
        <Box style={{ width: 12, height: 12, borderRadius: 6, background: '#7F1D1D' }} />
        <Text style={{ fontSize: 'label', color: '#92400E', letterSpacing: 4 }}>{/* {{替换：主题标签}} */}传统雅韵</Text>
      </Box>
      <Text style={{ fontSize: 'hero', color: '#0F172A', bold: true, letterSpacing: 4, lineHeight: 1.3, marginBottom: 'xl' }}>{/* {{替换：主标题}} */}中华美学</Text>
      <Text style={{ fontSize: 'card', color: '#92400E', letterSpacing: 3, marginBottom: 'xl' }}>{/* {{替换：副标题}} */}天人合一·意境悠远</Text>
      {/* 诗句卡（浅底圆角框，阴影） */}
      <Box style={{ background: 'rgba(255,255,255,0.6)', borderRadius: 'sm', border: '1px solid rgba(146,64,14,0.15)', padding: 'sm lg', marginBottom: 'xl', boxShadow: '0 1px 2px rgba(0,0,0,0.08)' }}>
        <Text style={{ fontSize: 'label', color: '#92400E', lineHeight: 1.8 }}>{/* {{替换：诗句}} */}天地有正气 · 古今传雅韵</Text>
      </Box>
      <Text style={{ fontSize: 'body', color: '#92400E', letterSpacing: 2 }}>{/* {{替换：落款}} */}美学研究所 | 年度学术论坛</Text>
    </Box>
  </Box>
</Slide>
