<Slide>
  {/* cover/flat 154 柔和渐变封面：淡绿渐变底 + 柔和渐变方块装饰 + 居中标题 + 白卡落款 */}
  <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, background: 'linear-gradient(135deg, #F7FEE7 0%, #ECFDF5 50%, #DCFCE7 100%)', alignItems: 'center', justifyContent: 'center' }}>
    {/* 柔和渐变方块装饰 */}
    <Box style={{ position: 'absolute', top: 112, left: 144, width: 144, height: 144, background: 'linear-gradient(135deg, #D9F99D 0%, #A7F3D0 100%)', borderRadius: 40, opacity: 0.7 }} />
    <Box style={{ position: 'absolute', top: 160, right: 176, width: 112, height: 112, background: 'linear-gradient(135deg, #A7F3D0 0%, #BBF7D0 100%)', borderRadius: 30, opacity: 0.65 }} />
    <Box style={{ position: 'absolute', bottom: 144, left: 192, width: 96, height: 96, background: 'linear-gradient(135deg, #BBF7D0 0%, #D9F99D 100%)', borderRadius: 25, opacity: 0.6 }} />
    <Box style={{ position: 'absolute', bottom: 176, right: 160, width: 80, height: 80, background: 'linear-gradient(135deg, #6EE7B7 0%, #BEF264 100%)', borderRadius: 20, opacity: 0.5 }} />
    {/* 主内容 */}
    <Box style={{ alignItems: 'center', padding: '0 xl', maxWidth: 900 }}>
      <Text style={{ fontSize: 'title', color: 'text', bold: true, marginBottom: 'md', textAlign: 'center', lineHeight: 1.2 }}>{/* {{主标题}} */}绿色环保设计</Text>
      <Text style={{ fontSize: 'card', color: 'text', marginBottom: 'lg', textAlign: 'center' }}>{/* {{副标题}} */}自然渐变·可持续理念</Text>
      {/* 白卡落款 */}
      <Box style={{ background: 'bg', borderRadius: 'md', padding: 'md xl', alignItems: 'center', boxShadow: '0 4px 12px rgba(0,0,0,0.15)' }}>
        <Text style={{ fontSize: 'body', color: '#059669', bold: true }}>{/* {{落款一}} */}环保设计组</Text>
        <Text style={{ fontSize: 'label', color: 'muted', marginTop: 'xs' }}>{/* {{落款二}} */}绿色产品指南</Text>
      </Box>
    </Box>
  </Box>
</Slide>
