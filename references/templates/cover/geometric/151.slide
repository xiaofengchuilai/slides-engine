<Slide>
  {/* cover/geometric 151 线条流动封面：淡橙渐变底 + 水平装饰线 + 白卡落款 */}
  <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, background: 'linear-gradient(135deg, #FFF7ED 0%, #FFFFFF 50%, #FFFBEB 100%)', alignItems: 'center', justifyContent: 'center' }}>
    {/* 水平装饰线 */}
    <Box style={{ position: 'absolute', top: 96, left: 128, right: 128, height: 4, background: 'linear-gradient(90deg, rgba(251,146,60,0) 0%, rgba(251,146,60,0.5) 50%, rgba(251,146,60,0) 100%)' }} />
    <Box style={{ position: 'absolute', top: 144, left: 160, right: 160, height: 2, background: 'linear-gradient(90deg, rgba(252,211,77,0) 0%, rgba(252,211,77,0.4) 50%, rgba(252,211,77,0) 100%)' }} />
    <Box style={{ position: 'absolute', bottom: 144, left: 144, right: 144, height: 4, background: 'linear-gradient(90deg, rgba(251,146,60,0) 0%, rgba(251,146,60,0.45) 50%, rgba(251,146,60,0) 100%)' }} />
    <Box style={{ position: 'absolute', bottom: 192, left: 176, right: 176, height: 2, background: 'linear-gradient(90deg, rgba(252,211,77,0) 0%, rgba(252,211,77,0.35) 50%, rgba(252,211,77,0) 100%)' }} />
    {/* 主内容 */}
    <Box style={{ alignItems: 'center', padding: '0 xl', maxWidth: 900 }}>
      <Text style={{ fontSize: 'title', color: 'text', bold: true, marginBottom: 'md', textAlign: 'center', lineHeight: 1.2 }}>{/* {{主标题}} */}动效设计原理</Text>
      <Text style={{ fontSize: 'card', color: 'muted', marginBottom: 'lg', textAlign: 'center' }}>{/* {{副标题}} */}流畅过渡·自然动感</Text>
      {/* 白卡落款（顶部主色条） */}
      <Box style={{ background: 'bg', padding: 'md xl', alignItems: 'center', boxShadow: '0 1px 2px rgba(0,0,0,0.08)' }}>
        <Box style={{ width: 96, height: 3, background: '#F97316' }} />
