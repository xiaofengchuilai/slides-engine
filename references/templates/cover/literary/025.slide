<Slide>
  {/* cover/literary/025 文艺风-信笺风格：浅米橙渐变底 + 信纸卡 + 引言 + 主标题 + 分隔线 + 副标题 */}
  <Box style={{ width: 1280, height: 720, background: 'linear-gradient(135deg, #FFFBEB 0%, #FFF7ED 100%)', justifyContent: 'center', alignItems: 'center' }}>
    {/* 信纸卡 */}
    <Box style={{ background: '#FFFFFF', opacity: 0.8, borderRadius: 'md', padding: 'xxl', maxWidth: 800, justifyContent: 'center', alignItems: 'center', boxShadow: '0 16px 48px rgba(0,0,0,0.28)' }}>
      <Emoji name="✉" style={{ width: 32, height: 32, alignSelf: 'center', marginBottom: 'sm' }} />
      <Text style={{ fontSize: 'card', color: '#B45309', fontFamily: 'serif', marginBottom: 'lg', textAlign: 'center' }}>{/* {{替换：引言}} */}"Dear Reader,"</Text>
      <Text style={{ fontSize: 'hero', color: '#111827', fontFamily: 'serif', letterSpacing: 2, textAlign: 'center', marginBottom: 'xl' }}>{/* {{替换：主标题}} */}温柔书信</Text>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'md', marginBottom: 'lg' }}>
        <Box style={{ width: 48, height: 1, background: '#D97706' }} />
        <FAIcon name="envelope" style={{ fill: '#D97706', width: 20, height: 20 }} />
        <Box style={{ width: 48, height: 1, background: '#D97706' }} />
      </Box>
      <Text style={{ fontSize: 'body', color: '#374151', fontWeight: 300, fontFamily: 'serif', textAlign: 'center' }}>{/* {{替换：副标题}} */}Letters of Tenderness</Text>
    </Box>
  </Box>
</Slide>
