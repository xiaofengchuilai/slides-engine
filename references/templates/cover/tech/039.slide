      <Box style={{ position: 'absolute', top: 0, left: 1200, width: 1, height: 720, background: '#22D3EE' }} />
    </Box>
    <Box style={{ justifyContent: 'center', alignItems: 'center' }}>
      <Text style={{ fontSize: 'label', color: '#22D3EE', letterSpacing: 4, marginBottom: 'lg' }}>{/* {{替换：状态标签}} */}[SYSTEM_READY]</Text>
