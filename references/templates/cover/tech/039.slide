      <Text style={{ fontSize: 'card', color: '#22D3EE', letterSpacing: 3, marginBottom: 'xl' }}>{/* {{替换：副标题}} */}SMART NETWORK</Text>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', border: '1px solid #0E7490', background: '#123C46', padding: 'sm lg' }}>
        <Box style={{ width: 12, height: 12, borderRadius: 6, background: '#06B6D4' }} />
        <Text style={{ fontSize: 'label', color: '#22D3EE', letterSpacing: 2 }}>{/* {{替换：状态文案}} */}ONLINE</Text>
