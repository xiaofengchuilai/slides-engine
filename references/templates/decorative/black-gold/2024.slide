      <Box style={{ flexDirection: 'row', gap: 48, alignItems: 'center' }}>
        <Box style={{ width: 40, height: 40, borderRadius: 20, background: 'linear-gradient(135deg, #EAB308 0%, #B45309 100%)', alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 'card', color: '#000000', bold: true }}>V</Text>
        </Box>
        <Box style={{ width: 40, height: 40, borderRadius: 20, border: '2px solid #C9A227', alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 'card', color: '#EAB308', bold: true }}>★</Text>
        </Box>
        <Box style={{ width: 40, height: 40, background: 'linear-gradient(135deg, #EAB308 0%, #B45309 100%)', rotate: 45 }} />
      </Box>
      <Box style={{ flexDirection: 'row', gap: 48, alignItems: 'center' }}>
        <Box style={{ width: 40, height: 40, position: 'relative' }}>
          <Box style={{ position: 'absolute', top: 19, left: 0, width: 40, height: 2, background: '#C9A227' }} />
          <Box style={{ position: 'absolute', top: 0, left: 19, width: 2, height: 40, background: '#C9A227' }} />
          <Box style={{ position: 'absolute', top: 12, left: 12, width: 16, height: 16, background: '#C9A227' }} />
