<Slide>
  {/* decorative/cartoon/2008 卡通风-圆角小贴纸：浅底 + 彩色圆角贴纸/胶囊装饰 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FDF2F8 0%, #EDE9FE 100%)', padding: 48 }}>
    <Box style={{ height: 624, alignItems: 'center', justifyContent: 'center', gap: 32 }}>
      <Box style={{ flexDirection: 'row', gap: 48, alignItems: 'center' }}>
        <Box style={{ width: 56, height: 40, borderRadius: 20, background: 'linear-gradient(135deg, #f9a8d4 0%, #c4b5fd 100%)', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }} />
        <Box style={{ width: 48, height: 48, borderRadius: 16, background: 'linear-gradient(135deg, #fde047 0%, #fdba74 100%)', rotate: -12, boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }} />
        <Box style={{ width: 40, height: 40, borderRadius: 20, background: 'linear-gradient(135deg, #67e8f9 0%, #93c5fd 100%)', border: '4px solid #FFFFFF', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }} />
      </Box>
      <Box style={{ flexDirection: 'row', gap: 48, alignItems: 'center' }}>
        <Box style={{ width: 48, height: 48, borderRadius: 12, background: 'linear-gradient(135deg, #6ee7b7 0%, #5eead4 100%)', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }} />
        <Box style={{ background: 'linear-gradient(90deg, #f472b6 0%, #a855f7 100%)', borderRadius: 999, padding: 8, paddingLeft: 16, paddingRight: 16, boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
          <Text style={{ fontSize: 'label', color: '#FFFFFF', bold: true }}>{/* {{替换：贴纸文字}} */}HI!</Text>
        </Box>
        <Box style={{ width: 40, height: 40, borderRadius: 20, background: 'linear-gradient(135deg, #fca5a5 0%, #f9a8d4 100%)', alignItems: 'center', justifyContent: 'center', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
          <Emoji name="🎵" style={{ width: 24, height: 24 }} />
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
