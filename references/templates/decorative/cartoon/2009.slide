<Slide>
  {/* decorative/cartoon/2009 卡通风-趣味小符号：浅底 + 彩色符号装饰（箭头/爱心/星形等） */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #ECFEFF 0%, #FFF7ED 100%)', padding: 48 }}>
    <Box style={{ height: 624, alignItems: 'center', justifyContent: 'center', gap: 24 }}>
      <Box style={{ flexDirection: 'row', gap: 48, alignItems: 'center' }}>
        <Text style={{ fontSize: 'kpi', color: '#374151', bold: true }}>→</Text>
        <Text style={{ fontSize: 'kpi', color: '#ec4899', bold: true }}>♥</Text>
        <Text style={{ fontSize: 'kpi', color: '#eab308', bold: true }}>★</Text>
        <Text style={{ fontSize: 'kpi', color: '#3b82f6', bold: true }}>●</Text>
      </Box>
      <Box style={{ flexDirection: 'row', gap: 48, alignItems: 'center' }}>
        <Text style={{ fontSize: 'kpi', color: '#8b5cf6', bold: true }}>▲</Text>
        <Text style={{ fontSize: 'kpi', color: '#22c55e', bold: true }}>✓</Text>
        <Text style={{ fontSize: 'kpi', color: '#f97316', bold: true }}>◆</Text>
        <Text style={{ fontSize: 'kpi', color: '#06b6d4', bold: true }}>※</Text>
      </Box>
    </Box>
  </Box>
</Slide>
