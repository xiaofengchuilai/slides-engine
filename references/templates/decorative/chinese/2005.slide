<Slide>
  {/* decorative/chinese/2005 中国风-水墨小笔触：米白底 + 墨线/墨点/竖笔触装饰 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FFFFFF 0%, #F5F1E8 100%)', padding: 48 }}>
    <Box style={{ height: 624, alignItems: 'center', justifyContent: 'center', gap: 32 }}>
      <Box style={{ flexDirection: 'row', gap: 48, alignItems: 'center' }}>
        <Box style={{ width: 64, height: 4, borderRadius: 2, background: 'linear-gradient(90deg, rgba(31,41,55,0) 0%, #1f2937 50%, rgba(31,41,55,0) 100%)', opacity: 0.6 }} />
        <Box style={{ width: 12, height: 48, borderRadius: 6, background: 'linear-gradient(180deg, #1f2937 0%, rgba(31,41,55,0) 100%)', opacity: 0.6 }} />
        <Box style={{ width: 32, height: 32, borderRadius: 16, background: 'linear-gradient(135deg, #1f2937 0%, rgba(31,41,55,0) 100%)', opacity: 0.4 }} />
      </Box>
      <Box style={{ flexDirection: 'row', gap: 48, alignItems: 'center' }}>
        <Box style={{ width: 40, height: 60, position: 'relative' }}>
          <Box style={{ position: 'absolute', top: 30, left: 0, width: 16, height: 2, background: '#374151', opacity: 0.5 }} />
          <Box style={{ position: 'absolute', top: 20, left: 16, width: 2, height: 20, background: '#374151', opacity: 0.5 }} />
          <Box style={{ position: 'absolute', top: 30, left: 16, width: 24, height: 2, background: '#374151', opacity: 0.5 }} />
        </Box>
        <Box style={{ flexDirection: 'row', gap: 4, alignItems: 'center' }}>
          <Box style={{ width: 4, height: 40, background: '#1f2937', opacity: 0.6 }} />
          <Box style={{ width: 4, height: 32, background: '#1f2937', opacity: 0.5 }} />
          <Box style={{ width: 4, height: 48, background: '#1f2937', opacity: 0.7 }} />
        </Box>
        <Box style={{ width: 48, height: 4, borderRadius: 2, background: 'rgba(31,41,55,0.4)' }} />
      </Box>
    </Box>
  </Box>
</Slide>
