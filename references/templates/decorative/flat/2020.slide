<Slide>
  {/* decorative/flat/2020 扁平风-圆角小色块：白底 + 多色圆角色块元素网格 */}
  <Box style={{ width: 1280, height: 720, background: 'bg', position: 'absolute', top: 0, left: 0, padding: 48 }}>
    <Box style={{ height: 624, justifyContent: 'center', gap: 40 }}>
      <Box style={{ flexDirection: 'row', gap: 56, alignItems: 'center', justifyContent: 'center' }}>
        <Box style={{ width: 48, height: 32, borderRadius: 'sm', background: '#3B82F6' }} />
        <Box style={{ width: 40, height: 40, borderRadius: 'lg', background: '#22C55E' }} />
        <Box style={{ width: 56, height: 24, borderRadius: 12, background: '#A855F7' }} />
        <Box style={{ width: 32, height: 48, borderRadius: 'md', background: '#EC4899' }} />
      </Box>
      <Box style={{ flexDirection: 'row', gap: 56, alignItems: 'center', justifyContent: 'center' }}>
        <Shape type="diamond" style={{ width: 40, height: 40, fill: '#14B8A6', rotate: 12 }} />
        {/* 三竖条（红/橙/黄） */}
        <Box style={{ flexDirection: 'row', gap: 4, alignItems: 'flex-end' }}>
          <Box style={{ width: 16, height: 32, borderRadius: 'sm', background: '#EF4444' }} />
          <Box style={{ width: 16, height: 40, borderRadius: 'sm', background: '#F97316' }} />
          <Box style={{ width: 16, height: 24, borderRadius: 'sm', background: '#EAB308' }} />
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
