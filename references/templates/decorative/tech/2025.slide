<Slide>
  {/* decorative/tech/2025 科技风-霓虹小光效：黑底 + 霓虹圆/环/条/点装饰网格 */}
  <Box style={{ height: 720, width: 1280, background: '#000000', padding: 48 }}>
    <Box style={{ height: 624, alignItems: 'center', justifyContent: 'center', gap: 32 }}>
      <Box style={{ flexDirection: 'row', gap: 40, alignItems: 'center' }}>
        <Box style={{ width: 48, height: 48, borderRadius: 24, background: 'rgba(34,211,238,0.5)', boxShadow: '0 0 10px #22d3ee' }} />
        <Box style={{ width: 40, height: 40, borderRadius: 20, border: '2px solid #3b82f6', boxShadow: '0 0 10px #3b82f6' }} />
        <Box style={{ width: 48, height: 8, background: 'linear-gradient(90deg, #22d3ee 0%, #a855f7 100%)', boxShadow: '0 0 10px #06b6d4' }} />
        <Box style={{ width: 40, height: 40, background: 'rgba(168,85,247,0.6)', rotate: 45, boxShadow: '0 0 10px #a855f7' }} />
      </Box>
      <Box style={{ flexDirection: 'row', gap: 40, alignItems: 'center' }}>
        <Box style={{ width: 32, height: 32, border: '2px solid #22d3ee', rotate: 45, boxShadow: '0 0 10px #06b6d4' }} />
        <Box style={{ flexDirection: 'row', gap: 8 }}>
          <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#22d3ee', boxShadow: '0 0 8px #06b6d4' }} />
          <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#3b82f6', boxShadow: '0 0 8px #3b82f6' }} />
          <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#a855f7', boxShadow: '0 0 8px #a855f7' }} />
        </Box>
        <Box style={{ width: 40, height: 40, borderRadius: 20, border: '1px solid rgba(34,211,238,0.5)', background: 'rgba(34,211,238,0.2)' }} />
        <Box style={{ width: 48, height: 8, borderRadius: 4, background: 'linear-gradient(90deg, rgba(34,211,238,0) 0%, #22d3ee 100%)' }} />
      </Box>
    </Box>
  </Box>
</Slide>
