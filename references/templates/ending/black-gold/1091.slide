<Slide>
  {/* ending/black-gold/1091 黑金风-几何奢华：深紫渐变 + 金色几何框 + 菱形 + 居中致谢 */}
  <Box style={{ width: 1280, height: 720, background: 'linear-gradient(135deg, #2C2C3E 0%, #1A1A2E 100%)' }}>
    {/* 金色几何装饰（降级为方框+菱形 Shape） */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 200, height: 200, border: '2px solid #D4AF37', opacity: 0.3 }} />
    <Box style={{ position: 'absolute', top: 95, right: 0, width: 230, height: 230, border: '2px solid #FFD700', opacity: 0.25 }} />
    <Shape type="diamond" style={{ width: 260, height: 260, position: 'absolute', bottom: 0, left: 230, fill: '#D4AF37', opacity: 0.15 }} />
    <Shape type="diamond" style={{ width: 180, height: 180, position: 'absolute', bottom: 55, right: 0, fill: '#DAA520', opacity: 0.12 }} />
    {/* 中心金色框架（菱形，用 Shape 旋转方块） */}
    <Box style={{ position: 'absolute', top: 268, left: 548, width: 185, height: 185, border: '2px solid #FFD700', opacity: 0.4 }}>
      <Shape type="rect" style={{ width: 185, height: 185, line: { color: '#FFD700', width: 2 }, rotate: 45 }} />
    </Box>
    <Box style={{ position: 'absolute', top: 288, left: 568, width: 145, height: 145, border: '1px solid #D4AF37', opacity: 0.3 }}>
      <Shape type="rect" style={{ width: 145, height: 145, line: { color: '#D4AF37', width: 1 }, rotate: 45 }} />
    </Box>
    {/* 金色粒子装饰 */}
    <Box style={{ position: 'absolute', top: 165, left: 230, width: 4, height: 4, borderRadius: 2, background: '#EAB308', opacity: 0.9 }} />
    <Box style={{ position: 'absolute', top: 490, right: 255, width: 5, height: 5, borderRadius: 2, background: '#D4AF37', opacity: 0.85 }} />
    <Box style={{ position: 'absolute', bottom: 185, left: 330, width: 3, height: 3, borderRadius: 1, background: '#EAB308', opacity: 0.8 }} />
    {/* 居中内容 */}
    <Box style={{ flex: 1, alignItems: 'center', justifyContent: 'center' }}>
      <Text style={{ fontSize: 'kpi', color: '#EAB308', bold: true, marginBottom: 'md' }}>{/* {{替换：主标题}} */}谢谢</Text>
      <Text style={{ fontSize: 'title', color: '#D4AF37' }}>{/* {{替换：致谢语}} */}感谢您的关注与支持</Text>
    </Box>
  </Box>
</Slide>
