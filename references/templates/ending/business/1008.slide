<Slide>
  {/* ending/business/1008 商务风-简洁边框：居中 THANK YOU + 四角边框装饰 + 三列联系信息 */}
  <Box style={{ height: 720, width: 1280, background: 'bg', justifyContent: 'center', alignItems: 'center' }}>
    {/* 四角边框装饰（用 L 形细条组合，不用单边 border） */}
    <Box style={{ position: 'absolute', top: 32, left: 32, width: 96, height: 8, background: 'primary' }} />
    <Box style={{ position: 'absolute', top: 32, left: 32, width: 8, height: 96, background: 'primary' }} />
    <Box style={{ position: 'absolute', bottom: 32, right: 32, width: 96, height: 8, background: 'primary' }} />
    <Box style={{ position: 'absolute', bottom: 32, right: 32, width: 8, height: 96, background: 'primary' }} />
    {/* 居中内容 */}
    <Box style={{ alignItems: 'center', padding: '0 96px' }}>
      <Text style={{ fontSize: 52, color: 'text', bold: true, letterSpacing: 8, textAlign: 'center', marginBottom: 'lg' }}>{/* {{替换：主标题}} */}THANK YOU</Text>
      <Box style={{ width: 160, height: 2, background: 'linear-gradient(90deg, #4F46E5 0%, #2563EB 100%)', marginBottom: 'xl' }} />
      <Text style={{ fontSize: 'card', color: 'text', textAlign: 'center', marginBottom: 'xxl' }}>{/* {{替换：致谢语}} */}期待与您的合作</Text>
      <Box style={{ flexDirection: 'row', gap: 'xl' }}>
        {[
          ['联系电话', '138-0000-0000'],
          ['电子邮箱', 'info@biz.com'],
          ['公司网址', 'www.biz.com'],
        ].map((c, i) => (
          <Box key={i} style={{ alignItems: 'center' }}>
            <Text style={{ fontSize: 'label', color: 'muted', marginBottom: 'xs' }}>{c[0]}</Text>
            <Text style={{ fontSize: 'body', color: 'text', bold: true }}>{/* {{替换：联系内容}} */}{c[1]}</Text>
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
</Slide>
