<Slide>
  {/* ending/cartoon/1006 卡通风-气球告别：青蓝渐变底+气球彩圆、白卡+紫粗边、联系方式胶囊 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(90deg, #D6F3FF 0%, #A8D8F5 100%)', justifyContent: 'center', alignItems: 'center' }}>
    {/* 气球（三彩圆 → 彩色 emoji） */}
    <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: 'md', marginBottom: 'xl' }}>
      <Emoji name="🎈" style={{ width: 56, height: 72 }} />
      <Emoji name="🎈" style={{ width: 68, height: 88 }} />
      <Emoji name="🎈" style={{ width: 56, height: 72 }} />
    </Box>
    <Box style={{ background: '#FFFFFF', borderRadius: 'lg', border: '8px solid #C4A8FF', padding: 'xxl xl', alignItems: 'center', gap: 'sm', boxShadow: '0 16px 48px rgba(0,0,0,0.28)' }}>
      <Text style={{ fontSize: 56, color: '#2D3748', bold: true }}>{/* {{替换：告别标题}} */}再见啦！</Text>
      <Text style={{ fontSize: 'card', color: '#718096' }}>See You Next Time</Text>
      <Box style={{ gap: 'sm', marginTop: 'md', alignItems: 'center' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', background: 'linear-gradient(90deg, #FFD6E8 0%, #E8D6FF 100%)', borderRadius: 'sm', padding: 'xs lg' }}>
          <Emoji name="📮" style={{ width: 18, height: 18 }} />
          <Text style={{ fontSize: 'body', bold: true }}>{/* {{替换：邮箱}} */}info@happy.com</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', background: 'linear-gradient(90deg, #C9EAFF 0%, #D6F3FF 100%)', borderRadius: 'sm', padding: 'xs lg' }}>
          <Emoji name="📞" style={{ width: 18, height: 18 }} />
          <Text style={{ fontSize: 'body', bold: true }}>{/* {{替换：电话}} */}400-999-9999</Text>
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
