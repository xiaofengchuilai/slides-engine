<Slide>
  {/* ending/cartoon/1040 卡通风-可爱动物：米粉渐变底+小熊兔子圆卡、粉标题+粉条+寄语 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FFF9E6 0%, #FFE6F0 100%)', justifyContent: 'center', alignItems: 'center' }}>
    {/* 小熊（左下：棕圆+浅脸+耳） */}
    <Box style={{ position: 'absolute', bottom: 72, left: 110, alignItems: 'center' }}>
      <Box style={{ width: 80, height: 80, borderRadius: 'sm', background: '#D4A574', flexDirection: 'row', justifyContent: 'center', alignItems: 'center', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
        <Box style={{ width: 34, height: 34, borderRadius: 'sm', background: '#D4A574', marginRight: -6 }} />
        <Box style={{ width: 34, height: 34, borderRadius: 'sm', background: '#D4A574', marginLeft: -6 }} />
      </Box>
      <Box style={{ width: 50, height: 40, borderRadius: 'sm', background: '#F5D9A8', marginTop: -30 }} />
    </Box>
    {/* 兔子（右下：粉圆+耳） */}
    <Box style={{ position: 'absolute', bottom: 72, right: 110, alignItems: 'center' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'center' }}>
        <Box style={{ width: 18, height: 55, borderRadius: 'sm', background: '#FFB3D9', marginRight: 2 }} />
        <Box style={{ width: 18, height: 55, borderRadius: 'sm', background: '#FFB3D9', marginLeft: 2 }} />
      </Box>
      <Box style={{ width: 75, height: 75, borderRadius: 'sm', background: '#FFB3D9', marginTop: -12, boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }} />
    </Box>
    {/* 爱心装饰（彩色 emoji） */}
    <Emoji name="💕" style={{ position: 'absolute', top: 110, left: 230, width: 26, height: 26 }} />
    <Emoji name="💕" style={{ position: 'absolute', top: 140, right: 260, width: 22, height: 22 }} />
    {/* 气泡圆环 */}
    <Box style={{ position: 'absolute', bottom: 250, left: 320, width: 30, height: 30, borderRadius: 'sm', border: '3px solid #66CCFF', opacity: 0.6 }} />
    <Box style={{ position: 'absolute', bottom: 220, right: 360, width: 25, height: 25, borderRadius: 'sm', border: '3px solid #77DD77', opacity: 0.6 }} />
    <Box style={{ alignItems: 'center', gap: 'md' }}>
      <Text style={{ fontSize: 62, color: '#FF6B9D', bold: true }}>{/* {{替换：致谢标题}} */}感谢聆听</Text>
      <Box style={{ width: 120, height: 4, borderRadius: 'sm', background: 'linear-gradient(90deg, #FF99CC 0%, #FFB3D9 50%, #FF99CC 100%)' }} />
      <Text style={{ fontSize: 'card', color: '#666666', bold: true }}>{/* {{替换：寄语}} */}期待与您再次相见</Text>
    </Box>
  </Box>
</Slide>
