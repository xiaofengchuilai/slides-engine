<Slide>
  {/* ending/cartoon/1041 卡通风-糖果色块：粉蓝渐变底+四角糖果色圆、白卡+彩点+副题 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FFF0F5 0%, #F0F8FF 100%)', justifyContent: 'center', alignItems: 'center' }}>
    {/* 四角糖果圆（半透明 + 阴影） */}
    <Box style={{ position: 'absolute', top: 30, left: 30, width: 160, height: 160, borderRadius: 'sm', background: 'linear-gradient(135deg, #FFB3D9 0%, #FF99CC 100%)', opacity: 0.7, boxShadow: '0 16px 48px rgba(0,0,0,0.28)' }} />
    <Box style={{ position: 'absolute', top: 60, right: 40, width: 140, height: 140, borderRadius: 'sm', background: 'linear-gradient(135deg, #FFEA5C 0%, #FFD93D 100%)', opacity: 0.7, boxShadow: '0 16px 48px rgba(0,0,0,0.28)' }} />
    <Box style={{ position: 'absolute', bottom: 50, left: 80, width: 170, height: 170, borderRadius: 'sm', background: 'linear-gradient(135deg, #77DD77 0%, #5FD85F 100%)', opacity: 0.7, boxShadow: '0 16px 48px rgba(0,0,0,0.28)' }} />
    <Box style={{ position: 'absolute', bottom: 60, right: 60, width: 150, height: 150, borderRadius: 'sm', background: 'linear-gradient(135deg, #B388FF 0%, #9966FF 100%)', opacity: 0.7, boxShadow: '0 16px 48px rgba(0,0,0,0.28)' }} />
    {/* 小圆点（+ 阴影） */}
    <Box style={{ position: 'absolute', top: 200, left: 260, width: 30, height: 30, borderRadius: 'sm', background: '#66CCFF', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }} />
    <Box style={{ position: 'absolute', top: 260, right: 320, width: 24, height: 24, borderRadius: 'sm', background: '#FFB347', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }} />
    <Box style={{ position: 'absolute', bottom: 230, left: 390, width: 28, height: 28, borderRadius: 'sm', background: '#FF6B9D', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }} />
    {/* 白卡 */}
    <Box style={{ background: 'rgba(255,255,255,0.85)', borderRadius: 'lg', padding: 'xxl xxl', alignItems: 'center', gap: 'md', boxShadow: '0 16px 48px rgba(0,0,0,0.28)' }}>
      <Text style={{ fontSize: 60, color: '#FF6B9D', bold: true }}>{/* {{替换：致谢标题}} */}谢谢</Text>
      <Box style={{ flexDirection: 'row', gap: 'xs' }}>
        <Box style={{ width: 14, height: 14, borderRadius: 'sm', background: '#FF6B9D' }} />
        <Box style={{ width: 14, height: 14, borderRadius: 'sm', background: '#FFB347' }} />
        <Box style={{ width: 14, height: 14, borderRadius: 'sm', background: '#FFEA5C' }} />
        <Box style={{ width: 14, height: 14, borderRadius: 'sm', background: '#77DD77' }} />
        <Box style={{ width: 14, height: 14, borderRadius: 'sm', background: '#66CCFF' }} />
        <Box style={{ width: 14, height: 14, borderRadius: 'sm', background: '#B388FF' }} />
      </Box>
      <Text style={{ fontSize: 'card', color: '#666666', bold: true }}>{/* {{替换：副题}} */}感谢您的关注与支持</Text>
    </Box>
  </Box>
</Slide>
