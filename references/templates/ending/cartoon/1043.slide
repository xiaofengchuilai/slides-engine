<Slide>
  {/* ending/cartoon/1043 卡通风-对话框：蓝粉渐变底+中央大对话卡（白底+粗黑边+尾巴）+三色小对话卡、标题+彩点+副题 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #E6F7FF 0%, #FFF0F5 100%)', justifyContent: 'center', alignItems: 'center' }}>
    {/* 小对话卡-左上（黄） */}
    <Box style={{ position: 'absolute', top: 90, left: 130, width: 140, height: 90, background: '#FFEA5C', border: '4px solid #333333', borderRadius: 'md', alignItems: 'center', justifyContent: 'center' }}>
      <Emoji name="👋" style={{ width: 32, height: 32 }} />
    </Box>
    {/* 小对话卡-右上（紫） */}
    <Box style={{ position: 'absolute', top: 130, right: 150, width: 120, height: 80, background: '#B388FF', border: '4px solid #333333', borderRadius: 'md', alignItems: 'center', justifyContent: 'center' }}>
      <Emoji name="😊" style={{ width: 28, height: 28 }} />
    </Box>
    {/* 小对话卡-左下（绿） */}
    <Box style={{ position: 'absolute', bottom: 60, left: 190, width: 100, height: 70, background: '#77DD77', border: '4px solid #333333', borderRadius: 'md', alignItems: 'center', justifyContent: 'center' }}>
      <Emoji name="❤️" style={{ width: 26, height: 26 }} />
    </Box>
    {/* 星星（彩色 emoji） */}
    <Emoji name="✨" style={{ position: 'absolute', top: 180, left: 390, width: 18, height: 18 }} />
    <Emoji name="✨" style={{ position: 'absolute', bottom: 140, right: 320, width: 20, height: 20 }} />
    {/* 中央大对话卡 */}
    <Box style={{ background: '#FFFFFF', border: '5px solid #333333', borderRadius: 'lg', padding: 'xxl xxl', alignItems: 'center', gap: 'md', position: 'absolute', top: 200, left: 192, width: 896 }}>
      <Text style={{ fontSize: 62, color: '#FF6B9D', bold: true }}>{/* {{替换：致谢标题}} */}谢谢观看</Text>
      <Box style={{ flexDirection: 'row', gap: 'sm' }}>
        <Box style={{ width: 18, height: 18, borderRadius: 'sm', background: '#FF6B9D' }} />
        <Box style={{ width: 18, height: 18, borderRadius: 'sm', background: '#FFB347' }} />
        <Box style={{ width: 18, height: 18, borderRadius: 'sm', background: '#77DD77' }} />
      </Box>
      <Text style={{ fontSize: 'card', color: '#666666', bold: true }}>{/* {{替换：副题}} */}期待您的宝贵意见</Text>
    </Box>
  </Box>
</Slide>
