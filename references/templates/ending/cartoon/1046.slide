<Slide>
  {/* ending/cartoon/1046 卡通风-手绘箭头：米蓝渐变底+四角彩箭头（细条+圆点）、白卡粗黑边+波浪线+彩点、标题+副题 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(180deg, #FFFEF9 0%, #F0F8FF 100%)', justifyContent: 'center', alignItems: 'center' }}>
    {/* 四角箭头（细条+端点圆，顺时针指向中心） */}
    <Box style={{ position: 'absolute', top: 110, left: 140, width: 120, height: 6, borderRadius: 'sm', background: '#FF6B9D' }} />
    <Box style={{ position: 'absolute', top: 104, left: 252, width: 16, height: 16, borderRadius: 'sm', background: '#FF6B9D' }} />
    <Box style={{ position: 'absolute', top: 110, right: 140, width: 120, height: 6, borderRadius: 'sm', background: '#FFB347' }} />
    <Box style={{ position: 'absolute', top: 104, right: 252, width: 16, height: 16, borderRadius: 'sm', background: '#FFB347' }} />
    <Box style={{ position: 'absolute', bottom: 110, left: 140, width: 120, height: 6, borderRadius: 'sm', background: '#77DD77' }} />
    <Box style={{ position: 'absolute', bottom: 104, left: 252, width: 16, height: 16, borderRadius: 'sm', background: '#77DD77' }} />
    <Box style={{ position: 'absolute', bottom: 110, right: 140, width: 120, height: 6, borderRadius: 'sm', background: '#B388FF' }} />
    <Box style={{ position: 'absolute', bottom: 104, right: 252, width: 16, height: 16, borderRadius: 'sm', background: '#B388FF' }} />
    {/* 手绘圆环 */}
    <Box style={{ position: 'absolute', top: 160, left: 360, width: 60, height: 60, borderRadius: 'sm', border: '4px solid #66CCFF' }} />
    <Box style={{ position: 'absolute', bottom: 200, right: 380, width: 50, height: 50, borderRadius: 'sm', border: '4px solid #FFEA5C' }} />
    {/* 手绘星星 */}
    <Box style={{ position: 'absolute', top: 250, right: 280, width: 16, height: 16, borderRadius: 'sm', background: '#FFEA5C', border: '2px solid #333333' }} />
    {/* 白卡 */}
    <Box style={{ background: '#FFFFFF', border: '5px solid #333333', borderRadius: 'lg', padding: 'xxl xxl', alignItems: 'center', gap: 'md', position: 'absolute', top: 200, left: 288, width: 704 }}>
      <Text style={{ fontSize: 62, color: '#FF6B9D', bold: true }}>{/* {{替换：致谢标题}} */}谢谢观看</Text>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'md' }}>
        <Box style={{ width: 80, height: 4, borderRadius: 'sm', background: 'linear-gradient(90deg, #FF6B9D 0%, #FF99CC 100%)' }} />
        <Box style={{ width: 18, height: 18, borderRadius: 'sm', background: '#FFEA5C', border: '3px solid #333333' }} />
        <Box style={{ width: 80, height: 4, borderRadius: 'sm', background: 'linear-gradient(90deg, #77DD77 0%, #A5E6B8 100%)' }} />
      </Box>
      <Text style={{ fontSize: 'card', color: '#666666', bold: true }}>{/* {{替换：副题}} */}欢迎提出宝贵建议</Text>
    </Box>
  </Box>
</Slide>
