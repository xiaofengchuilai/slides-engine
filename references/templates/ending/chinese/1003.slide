<Slide>
  {/* ending/chinese/1003 中国风-印章致谢：米底+细线边框，圆形红印章+红字标题+分隔线+联系信息 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FBF7F0 0%, #F5ECDC 100%)', justifyContent: 'center', alignItems: 'center' }}>
    {/* 装饰边框：左上 L 形 + 右下 L 形（细条替代单边 border） */}
    <Box style={{ position: 'absolute', top: 56, left: 64, width: 112, height: 4, background: '#A81810' }} />
    <Box style={{ position: 'absolute', top: 56, left: 64, width: 4, height: 112, background: '#A81810' }} />
    <Box style={{ position: 'absolute', bottom: 56, right: 64, width: 112, height: 4, background: '#A81810' }} />
    <Box style={{ position: 'absolute', bottom: 56, right: 64, width: 4, height: 112, background: '#A81810' }} />
    {/* 中央内容 */}
    <Box style={{ alignItems: 'center', gap: 'lg' }}>
      {/* 圆形印章 */}
      <Box style={{ width: 112, height: 112, borderRadius: 'sm', background: '#A81810', border: '4px solid #7C1208', alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontSize: 44, color: '#FFFFFF', bold: true }}>谢</Text>
      </Box>
      <Text style={{ fontSize: 52, color: '#A81810', bold: true, letterSpacing: 8 }}>{/* {{替换：致谢标题}} */}感谢聆听</Text>
      {/* 分隔线：细线-文字-细线 */}
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'md' }}>
        <Box style={{ width: 64, height: 2, background: '#A81810' }} />
        <Text style={{ fontSize: 'body', color: 'text' }}>{/* {{替换：副标题}} */}敬请指正</Text>
        <Box style={{ width: 64, height: 2, background: '#A81810' }} />
      </Box>
      <Box style={{ gap: 'xs', alignItems: 'center' }}>
        <Text style={{ fontSize: 'body', color: 'text' }}>{/* {{替换：联系电话}} */}电话：010-12345678</Text>
        <Text style={{ fontSize: 'body', color: 'text' }}>{/* {{替换：联系邮箱}} */}邮箱：info@company.cn</Text>
      </Box>
    </Box>
  </Box>
</Slide>
