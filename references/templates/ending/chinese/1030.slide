    <Box style={{ position: 'absolute', top: 64, left: 512, width: 260, height: 18, background: 'linear-gradient(180deg, #6B5A43 0%, #8B7355 100%)', borderRadius: 'sm', boxShadow: '0 4px 12px rgba(0,0,0,0.15)' }} />
