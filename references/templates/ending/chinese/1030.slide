<Slide>
  {/* ending/chinese/1030 中国风-竹简卷轴：米底+卷轴上下条、红菱形装饰、大标题+分隔+寄语 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #F5F0E8 0%, #E8DCC8 100%)', justifyContent: 'center', alignItems: 'center' }}>
