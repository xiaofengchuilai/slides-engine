    <Box style={{ position: 'absolute', bottom: 64, left: 512, width: 260, height: 18, background: 'linear-gradient(180deg, #8B7355 0%, #6B5A43 100%)', borderRadius: 'sm', boxShadow: '0 4px 12px rgba(0,0,0,0.15)' }} />
    <Box style={{ position: 'absolute', bottom: 90, left: 520, width: 240, height: 2, background: 'rgba(107,90,67,0.3)' }} />
