<Slide>
  {/* ending/chinese/1031 中国风-青花瓷纹：浅蓝灰底+青花圆环装饰，青蓝标题+分隔线+副题 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(180deg, #F8F8F8 0%, #E8E8F0 100%)', justifyContent: 'center', alignItems: 'center' }}>
    {/* 青花圆环装饰（左上/右下） */}
    <Box style={{ position: 'absolute', top: -90, left: -90, width: 360, height: 360, borderRadius: 'sm', border: '3px solid rgba(50,80,140,0.25)' }} />
    <Box style={{ position: 'absolute', top: 40, left: 60, width: 100, height: 100, borderRadius: 'sm', border: '2px solid rgba(50,80,140,0.25)', alignItems: 'center', justifyContent: 'center' }}>
      <Box style={{ width: 60, height: 60, borderRadius: 'sm', background: 'rgba(50,80,140,0.20)' }} />
    </Box>
    <Box style={{ position: 'absolute', bottom: 40, right: 40, width: 320, height: 320, borderRadius: 'sm', border: '3px solid rgba(50,80,140,0.25)' }} />
    <Box style={{ alignItems: 'center', gap: 'md' }}>
      <Text style={{ fontSize: 64, color: '#32508C', letterSpacing: 12 }}>{/* {{替换：致谢标题}} */}致谢</Text>
      <Box style={{ width: 150, height: 2, background: 'linear-gradient(90deg, #E8E8F0 0%, #32508C 50%, #E8E8F0 100%)' }} />
      <Text style={{ fontSize: 'card', color: '#5A7099', letterSpacing: 3 }}>{/* {{替换：副题}} */}感谢诸位的聆听</Text>
