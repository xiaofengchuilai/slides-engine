<Slide>
  {/* ending/chinese/1034 中国风-书法墨迹：米底+墨点晕染+笔触横条、红方章，大标题+墨点线+寄语 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #F8F5F0 0%, #F0E8D8 100%)', justifyContent: 'center', alignItems: 'center' }}>
    {/* 墨迹晕染（半透明灰圆） */}
    <Box style={{ position: 'absolute', top: -40, left: -40, width: 300, height: 300, borderRadius: 'sm', background: 'rgba(40,40,40,0.06)' }} />
    <Box style={{ position: 'absolute', bottom: 20, right: 20, width: 320, height: 320, borderRadius: 'sm', background: 'rgba(40,40,40,0.05)' }} />
    {/* 笔触横条（半透明墨条） */}
    <Box style={{ position: 'absolute', top: 108, left: 100, width: 180, height: 8, background: 'rgba(40,40,40,0.2)' }} />
    <Box style={{ position: 'absolute', bottom: 130, right: 128, width: 200, height: 6, background: 'rgba(40,40,40,0.16)' }} />
    {/* 墨点 */}
    <Box style={{ position: 'absolute', bottom: 180, left: 192, width: 18, height: 18, borderRadius: 'sm', background: 'rgba(40,40,40,0.25)' }} />
    <Box style={{ position: 'absolute', top: 200, right: 320, width: 12, height: 12, borderRadius: 'sm', background: 'rgba(40,40,40,0.2)' }} />
    {/* 印章（方章） */}
    <Box style={{ position: 'absolute', top: 88, right: 128, width: 70, height: 70, border: '3px solid #A81810', background: 'rgba(200,16,46,0.10)', alignItems: 'center', justifyContent: 'center' }}>
      <Text style={{ fontSize: 20, color: '#A81810', bold: true, lineHeight: 1.1, textAlign: 'center' }}>谢 谢</Text>
    </Box>
    <Box style={{ alignItems: 'center', gap: 'md' }}>
      <Text style={{ fontSize: 64, color: '#2C2C2C', letterSpacing: 12 }}>{/* {{替换：致谢标题}} */}感谢聆听</Text>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'lg' }}>
        <Box style={{ width: 100, height: 2, background: 'rgba(40,40,40,0.3)' }} />
        <Box style={{ width: 8, height: 8, borderRadius: 'sm', background: 'rgba(40,40,40,0.3)' }} />
        <Box style={{ width: 100, height: 2, background: 'rgba(40,40,40,0.3)' }} />
      </Box>
      <Text style={{ fontSize: 'card', color: '#666666', letterSpacing: 4 }}>{/* {{替换：寄语}} */}期待与您再次相见</Text>
    </Box>
  </Box>
</Slide>
