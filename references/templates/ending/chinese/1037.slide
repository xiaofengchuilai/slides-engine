<Slide>
  {/* ending/chinese/1037 中国风-莲花禅意：米底+底部水波线、左下莲瓣簇+右下荷叶环、大标题+彩点线+寄语 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(180deg, #F8F8F0 0%, #E8E8D8 100%)', justifyContent: 'center', alignItems: 'center' }}>
    {/* 水波（底部棕弧+横线） */}
    <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 1280, height: 288, background: 'linear-gradient(180deg, rgba(139,115,85,0) 0%, rgba(139,115,85,0.08) 100%)' }} />
    <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 1280, height: 2, background: 'rgba(139,115,85,0.2)' }} />
    {/* 莲花瓣簇（左下：棕米色瓣+金心） */}
    <Box style={{ position: 'absolute', bottom: 108, left: 120, width: 100, height: 100, alignItems: 'center', justifyContent: 'center' }}>
      <Box style={{ position: 'absolute', width: 32, height: 56, borderRadius: 'sm', background: 'linear-gradient(180deg, #E8C8A2 0%, #C8A882 100%)' }} />
      <Box style={{ position: 'absolute', width: 32, height: 56, borderRadius: 'sm', background: 'linear-gradient(180deg, #E8C8A2 0%, #C8A882 100%)', left: 8, top: 2 }} />
      <Box style={{ position: 'absolute', width: 32, height: 56, borderRadius: 'sm', background: 'linear-gradient(180deg, #E8C8A2 0%, #C8A882 100%)', left: 60, top: 2 }} />
      <Box style={{ position: 'absolute', width: 32, height: 56, borderRadius: 'sm', background: 'linear-gradient(180deg, #E8C8A2 0%, #C8A882 100%)', top: 6, left: 34 }} />
      <Box style={{ width: 24, height: 24, borderRadius: 'sm', background: '#E8C808' }} />
    </Box>
    {/* 荷叶环（右下） */}
    <Box style={{ position: 'absolute', bottom: 130, right: 192, width: 120, height: 120, borderRadius: 'sm', border: '2px solid rgba(139,115,85,0.25)', background: 'rgba(139,115,85,0.1)' }} />
    {/* 禅意圆环（右上） */}
    <Box style={{ position: 'absolute', top: 108, right: 192, width: 100, height: 100, borderRadius: 'sm', border: '3px solid rgba(139,115,85,0.3)' }} />
    <Box style={{ alignItems: 'center', gap: 'md', marginTop: -40 }}>
      <Text style={{ fontSize: 62, color: '#2C2C2C', letterSpacing: 12 }}>{/* {{替换：致谢标题}} */}谢谢观看</Text>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'md' }}>
        <Box style={{ width: 10, height: 10, borderRadius: 'sm', background: '#C8A882' }} />
        <Box style={{ width: 60, height: 2, background: '#8B7355' }} />
        <Box style={{ width: 16, height: 16, borderRadius: 'sm', background: '#E8C808' }} />
        <Box style={{ width: 60, height: 2, background: '#8B7355' }} />
        <Box style={{ width: 10, height: 10, borderRadius: 'sm', background: '#C8A882' }} />
      </Box>
      <Text style={{ fontSize: 'card', color: '#666666', letterSpacing: 3 }}>{/* {{替换：寄语}} */}期待您的宝贵意见</Text>
    </Box>
  </Box>
</Slide>
