<Slide>
  {/* ending/flat 1083 图标组合结尾：淡青粉渐变底 + 心形/星星/笑脸/对勾图标装饰 + 居中致谢 */}
  <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, background: 'linear-gradient(135deg, #CCFBF1 0%, #FDF2F8 50%, #FBCFE8 100%)' }}>
    {/* 心形图标（左上） */}
    <FAIcon name="heart" style={{ position: 'absolute', top: 108, left: 192, width: 56, height: 56, fill: '#F87171' }} />
    {/* 星星图标（右上） */}
    <FAIcon name="star" style={{ position: 'absolute', top: 180, right: 230, width: 64, height: 64, fill: '#FACC15' }} />
    {/* 笑脸图标（左下） */}
    <FAIcon name="smile" style={{ position: 'absolute', bottom: 144, left: 256, width: 72, height: 72, fill: '#4ADE80' }} />
    {/* 对勾图标（右下） */}
    <FAIcon name="circle-check" style={{ position: 'absolute', bottom: 180, right: 192, width: 64, height: 64, fill: '#2DD4BF' }} />
    {/* 小装饰点（旋转方块） */}
    <Box style={{ position: 'absolute', top: 288, left: 384, width: 20, height: 20, background: '#F9A8D4', rotate: 45 }} />
    <Box style={{ position: 'absolute', top: 432, right: 448, width: 25, height: 25, background: '#5EEAD4', rotate: 45 }} />
    {/* 内容区域 */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, alignItems: 'center', justifyContent: 'center' }}>
      <Text style={{ fontSize: 56, color: 'text', bold: true, marginBottom: 'lg' }}>{/* {{主标题}} */}谢谢观看</Text>
      <Text style={{ fontSize: 'card', color: 'text', textAlign: 'center' }}>{/* {{副标题}} */}期待您的宝贵意见</Text>
    </Box>
  </Box>
</Slide>
