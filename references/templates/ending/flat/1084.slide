<Slide>
  {/* ending/flat 1084 几何拼接结尾：白底 + 四角三角色块 + 中心菱形框 + 居中致谢 */}
  <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, background: 'bg' }}>
    {/* 四角三角色块（用直角三角 Shape） */}
    <Shape type="rightTriangle" style={{ position: 'absolute', top: 0, left: 0, width: 230, height: 230, fill: '#FF6B6B', opacity: 0.8 }} />
    <Shape type="rightTriangle" style={{ position: 'absolute', top: 0, right: 0, width: 260, height: 260, fill: '#4ECDC4', opacity: 0.7, rotate: 90 }} />
    <Shape type="rightTriangle" style={{ position: 'absolute', bottom: 0, left: 0, width: 280, height: 280, fill: '#FFE66D', opacity: 0.75, rotate: -90 }} />
    <Shape type="rightTriangle" style={{ position: 'absolute', bottom: 0, right: 0, width: 240, height: 240, fill: '#A8E6CF', opacity: 0.8, rotate: 180 }} />
    {/* 中心菱形装饰（带渐变填充） */}
    <Shape type="diamond" style={{ position: 'absolute', top: '50%', left: '50%', width: 150, height: 150, fill: '#818CF8', opacity: 0.3 }} />
    {/* 小几何装饰 */}
    <Box style={{ position: 'absolute', top: 216, left: 320, width: 40, height: 40, background: '#F9A8D4', opacity: 0.6, borderRadius: 'sm' }} />
    <Shape type="diamond" style={{ position: 'absolute', top: 468, right: 282, width: 50, height: 50, fill: '#5EEAD4', opacity: 0.7 }} />
    {/* 内容区域 */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, alignItems: 'center', justifyContent: 'center' }}>
      <Text style={{ fontSize: 56, color: 'text', bold: true, marginBottom: 'lg' }}>{/* {{主标题}} */}感谢</Text>
      <Text style={{ fontSize: 'card', color: 'text', textAlign: 'center' }}>{/* {{副标题}} */}感谢您的聆听与关注</Text>
    </Box>
  </Box>
</Slide>
