<Slide>
  {/* ending/flat 1086 波浪层叠结尾：浅灰底 + 上下层叠波浪（椭圆近似）+ 居中致谢 */}
  <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, background: 'cardBg' }}>
    {/* 底部波浪层（三层，浅绿系） */}
    <Shape type="ellipse" style={{ position: 'absolute', bottom: 0, left: 0, width: 1280, height: 300, fill: '#A8E6CF', opacity: 0.6 }} />
    <Shape type="ellipse" style={{ position: 'absolute', bottom: 0, left: 0, width: 1280, height: 270, fill: '#4ECDC4', opacity: 0.7 }} />
    <Shape type="ellipse" style={{ position: 'absolute', bottom: 0, left: 0, width: 1280, height: 240, fill: '#95E1D3', opacity: 0.8 }} />
    {/* 顶部波浪层（两层，黄色系） */}
    <Shape type="ellipse" style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 200, fill: '#FFE66D', opacity: 0.5 }} />
    <Shape type="ellipse" style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 170, fill: '#FFD93D', opacity: 0.6 }} />
    {/* 内容区域 */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, alignItems: 'center', justifyContent: 'center' }}>
      <Text style={{ fontSize: 56, color: 'text', bold: true, marginBottom: 'lg' }}>{/* {{主标题}} */}谢谢观看</Text>
      <Text style={{ fontSize: 'card', color: 'text', textAlign: 'center' }}>{/* {{副标题}} */}欢迎提出宝贵建议</Text>
    </Box>
  </Box>
</Slide>
