<Slide>
  {/* ending/geometric 1067 波纹圆环结尾：紫蓝渐变底 + 多层同心圆环 + 中心圆 + 圆点 + 居中致谢 */}
  <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, background: 'linear-gradient(135deg, #6A11CB 0%, #2575FC 100%)' }}>
    {/* 波纹圆环（多层，淡色递增） */}
    <Shape type="ellipse" style={{ position: 'absolute', top: '50%', left: '50%', width: 340, height: 340, line: { color: '#FFFFFF', width: 3 }, opacity: 0.4 }} />
    <Shape type="ellipse" style={{ position: 'absolute', top: '50%', left: '50%', width: 300, height: 300, line: { color: '#FFFFFF', width: 3 }, opacity: 0.35 }} />
    <Shape type="ellipse" style={{ position: 'absolute', top: '50%', left: '50%', width: 250, height: 250, line: { color: '#FFFFFF', width: 3 }, opacity: 0.3 }} />
    <Shape type="ellipse" style={{ position: 'absolute', top: '50%', left: '50%', width: 200, height: 200, line: { color: '#FFFFFF', width: 3 }, opacity: 0.25 }} />
    <Shape type="ellipse" style={{ position: 'absolute', top: '50%', left: '50%', width: 140, height: 140, fill: '#FFFFFF', opacity: 0.15 }} />
    {/* 装饰圆点 */}
    <Box style={{ position: 'absolute', top: 144, left: 256, width: 15, height: 15, borderRadius: 8, background: '#FFFFFF', opacity: 0.4 }} />
    <Box style={{ position: 'absolute', top: 180, right: 230, width: 18, height: 18, borderRadius: 9, background: '#FFFFFF', opacity: 0.35 }} />
    <Box style={{ position: 'absolute', bottom: 158, left: 192, width: 20, height: 20, borderRadius: 10, background: '#FFFFFF', opacity: 0.3 }} />
    <Box style={{ position: 'absolute', bottom: 130, right: 282, width: 16, height: 16, borderRadius: 8, background: '#FFFFFF', opacity: 0.38 }} />
    {/* 内容区域 */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, alignItems: 'center', justifyContent: 'center' }}>
      <Text style={{ fontSize: 56, color: '#FFFFFF', bold: true, marginBottom: 'lg' }}>{/* {{主标题}} */}感谢聆听</Text>
      <Text style={{ fontSize: 'card', color: '#FFFFFF', textAlign: 'center' }}>{/* {{副标题}} */}期待下次再见</Text>
    </Box>
  </Box>
</Slide>
