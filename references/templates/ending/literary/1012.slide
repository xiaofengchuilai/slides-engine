<Slide>
  {/* ending/literary/1012 文艺风-书页结尾：浅灰渐变 + 左书图标 + 右标题 + 联系列表 */}
  <Box style={{ width: 1280, height: 720, background: 'linear-gradient(90deg, #F1F5F9 0%, #F5F5F4 100%)' }}>
    <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: 'xxl' }}>
      {/* 左：书页图标（彩色 emoji） */}
      <Box style={{ width: 96, height: 96, borderRadius: 'sm', background: '#D97706', alignItems: 'center', justifyContent: 'center' }}>
        <Emoji name="📚" style={{ width: 48, height: 48 }} />
      </Box>
      {/* 右内容 */}
      <Box style={{ flex: 1, maxWidth: 560 }}>
        <Box style={{ marginBottom: 'lg' }}>
          <Text style={{ fontSize: 'hero', color: '#374151', bold: true, fontFamily: 'serif', marginBottom: 'sm' }}>{/* {{替换：主标题}} */}The End</Text>
          <Text style={{ fontSize: 'title', color: '#4B5563', fontFamily: 'serif' }}>{/* {{替换：致谢语}} */}感谢您的陪伴</Text>
        </Box>
        {/* 左竖线（用绝对定位细条）+ 联系列表 */}
        <Box style={{ position: 'relative', paddingLeft: 'xl' }}>
          <Box style={{ position: 'absolute', top: 0, left: 0, bottom: 0, width: 4, background: '#F59E0B' }} />
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', marginBottom: 'sm' }}>
            <Emoji name="✍️" style={{ width: 18, height: 18 }} />
            <Text style={{ fontSize: 'body', color: '#374151' }}>{/* {{替换：联系内容}} */}联系邮箱：author@story.com</Text>
          </Box>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm', marginBottom: 'sm' }}>
            <Emoji name="📞" style={{ width: 18, height: 18 }} />
            <Text style={{ fontSize: 'body', color: '#374151' }}>{/* {{替换：联系内容}} */}联系电话：010-6688-9900</Text>
          </Box>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 'sm' }}>
            <Emoji name="🌐" style={{ width: 18, height: 18 }} />
            <Text style={{ fontSize: 'body', color: '#374151' }}>{/* {{替换：联系内容}} */}官方网站：www.story.com</Text>
          </Box>
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
