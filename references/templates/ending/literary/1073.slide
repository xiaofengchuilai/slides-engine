<Slide>
  {/* ending/literary/1073 文艺风-羽毛信笺：蓝粉渐变 + 羽毛线装饰 + 居中致谢 */}
  <Box style={{ width: 1280, height: 720, background: 'linear-gradient(135deg, #E8F4F8 0%, #F8E8F4 100%)' }}>
    {/* 羽毛装饰降级为竖线组 */}
    <Box style={{ position: 'absolute', top: 70, left: 190, width: 80, height: 180, opacity: 0.4 }}>
      <Shape type="line" style={{ width: 0, height: 170, position: 'absolute', top: 0, left: 40, line: { color: '#B8C5D6', width: 2 } }} />
      <Shape type="line" style={{ width: 30, height: 0, position: 'absolute', top: 25, left: 12, line: { color: '#B8C5D6', width: 1.5 } }} />
      <Shape type="line" style={{ width: 35, height: 0, position: 'absolute', top: 45, left: 10, line: { color: '#B8C5D6', width: 1.5 } }} />
