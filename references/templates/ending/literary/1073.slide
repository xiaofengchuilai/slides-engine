      <Shape type="line" style={{ width: 30, height: 0, position: 'absolute', top: 25, right: 12, line: { color: '#B8C5D6', width: 1.5 } }} />
      <Shape type="line" style={{ width: 35, height: 0, position: 'absolute', top: 45, right: 10, line: { color: '#B8C5D6', width: 1.5 } }} />
      <Shape type="line" style={{ width: 40, height: 0, position: 'absolute', top: 65, right: 8, line: { color: '#B8C5D6', width: 1.5 } }} />
    </Box>
    <Box style={{ position: 'absolute', top: 280, right: 150, width: 70, height: 160, opacity: 0.35 }}>
      <Shape type="line" style={{ width: 0, height: 150, position: 'absolute', top: 0, left: 35, line: { color: '#D6B8C5', width: 2 } }} />
      <Shape type="line" style={{ width: 25, height: 0, position: 'absolute', top: 20, left: 12, line: { color: '#D6B8C5', width: 1.5 } }} />
      <Shape type="line" style={{ width: 30, height: 0, position: 'absolute', top: 40, left: 10, line: { color: '#D6B8C5', width: 1.5 } }} />
      <Shape type="line" style={{ width: 25, height: 0, position: 'absolute', top: 20, right: 12, line: { color: '#D6B8C5', width: 1.5 } }} />
      <Shape type="line" style={{ width: 30, height: 0, position: 'absolute', top: 40, right: 10, line: { color: '#D6B8C5', width: 1.5 } }} />
    </Box>
    <Box style={{ position: 'absolute', bottom: 100, left: 260, width: 60, height: 140, opacity: 0.3 }}>
      <Shape type="line" style={{ width: 0, height: 130, position: 'absolute', top: 0, left: 30, line: { color: '#C5D6B8', width: 2 } }} />
      <Shape type="line" style={{ width: 20, height: 0, position: 'absolute', top: 18, left: 12, line: { color: '#C5D6B8', width: 1.5 } }} />
