    {/* 居中内容 */}
    <Box style={{ flex: 1, alignItems: 'center', justifyContent: 'center' }}>
      <Text style={{ fontSize: 'kpi', color: '#7D8B96', fontFamily: 'serif', marginBottom: 'xl' }}>{/* {{替换：主标题}} */}谢谢观看</Text>
