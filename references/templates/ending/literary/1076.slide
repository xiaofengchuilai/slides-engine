<Slide>
  {/* ending/literary/1076 文艺风-信纸横线：米色底 + 信纸横线 + 邮票 + 居中致谢 */}
  <Box style={{ width: 1280, height: 720, background: '#F9F7F1' }}>
    {/* 信纸横线（细线） */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, opacity: 0.15 }}>
      {[40, 80, 120, 160, 200, 240, 280, 320, 360, 400, 440, 480, 520, 560, 600, 640, 680].map((y, i) => (
        <Box key={i} style={{ position: 'absolute', top: y, left: 130, width: 1020, height: 1, background: '#B8A890' }} />
      ))}
    </Box>
    {/* 信纸左边距红线 */}
    <Box style={{ position: 'absolute', top: 0, left: 120, width: 2, height: 720, background: '#DCB48C', opacity: 0.3 }} />
    <Box style={{ position: 'absolute', top: 0, left: 125, width: 2, height: 720, background: '#DCB48C', opacity: 0.15 }} />
    {/* 邮票装饰（降级为浅米方块+信封图标） */}
    <Box style={{ position: 'absolute', top: 60, right: 80, width: 100, height: 120, background: '#C8B49A', opacity: 0.4, alignItems: 'center', justifyContent: 'center', borderRadius: 'sm' }}>
      <FAIcon name="envelope" style={{ fill: '#8B7355', width: 40, height: 40, opacity: 0.8 }} />
    </Box>
    {/* 手写体装饰降级为文字 */}
    <Box style={{ position: 'absolute', top: 180, left: 190, opacity: 0.12 }}>
      <Text style={{ fontSize: 'body', color: '#8B7355', fontFamily: 'serif' }}>Dear Friend,</Text>
      <Text style={{ fontSize: 'body', color: '#8B7355', fontFamily: 'serif' }}>Thank you so much</Text>
    </Box>
    {/* 居中内容 */}
    <Box style={{ flex: 1, alignItems: 'center', justifyContent: 'center' }}>
      <Text style={{ fontSize: 'kpi', color: '#6B5D4F', fontFamily: 'serif', letterSpacing: 1, marginBottom: 'xl' }}>{/* {{替换：主标题}} */}谢谢观看</Text>
      <Text style={{ fontSize: 'title', color: '#8B7355', fontFamily: 'serif', lineHeight: 2 }}>{/* {{替换：致谢语}} */}欢迎提出宝贵建议</Text>
    </Box>
    {/* 签名装饰（降级为波浪细线） */}
    <Shape type="line" style={{ width: 180, height: 0, position: 'absolute', bottom: 120, left: 550, line: { color: '#8B7355', width: 2 } }} />
    {/* 爱心装饰降级为圆点 */}
    <Box style={{ position: 'absolute', bottom: 100, right: 100, width: 20, height: 20, borderRadius: 10, background: '#C88C8C', opacity: 0.4 }} />
  </Box>
</Slide>
