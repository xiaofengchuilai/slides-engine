<Slide>
  {/* minimalist/1027 小方块装饰：四角与两侧小方块点缀 + 居中标题 */}
  <Box style={{ height: 720, width: 1280, background: 'cardBg' }}>
    {/* 小方块装饰（旋转 45° 菱形） */}
    <Box style={{ position: 'absolute', top: 108, left: 256, width: 26, height: 26, background: '#D1D5DB', rotate: 45 }} />
    <Box style={{ position: 'absolute', top: 144, right: 230, width: 26, height: 26, background: '#D1D5DB', rotate: 45 }} />
    <Box style={{ position: 'absolute', bottom: 130, left: 192, width: 26, height: 26, background: '#D1D5DB', rotate: 45 }} />
    <Box style={{ position: 'absolute', bottom: 158, right: 256, width: 26, height: 26, background: '#D1D5DB', rotate: 45 }} />
    <Box style={{ position: 'absolute', top: 360, left: 128, width: 26, height: 26, background: '#D1D5DB', rotate: 45 }} />
    <Box style={{ position: 'absolute', top: 346, right: 154, width: 26, height: 26, background: '#D1D5DB', rotate: 45 }} />
    {/* 中央内容 */}
    <Box style={{ height: 720, alignItems: 'center', justifyContent: 'center', gap: 'md' }}>
      <Text style={{ fontSize: 'title', color: 'text', letterSpacing: 4 }}>{/* {{替换：致谢标题}} */}感谢聆听</Text>
