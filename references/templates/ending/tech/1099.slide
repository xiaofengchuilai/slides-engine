<Slide>
  {/* ending/tech/1099 科技风-电路板：深蓝渐变 + 电路网格装饰 + 圆环 + 居中致谢 */}
  <Box style={{ width: 1280, height: 720, background: 'linear-gradient(135deg, #0A0E27 0%, #1A1F3A 100%)' }}>
    {/* 电路网格装饰（细线交叉） */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, opacity: 0.2 }}>
      {[0, 90, 180, 270, 360, 450, 540, 630].map((y, i) => (
        <Box key={i} style={{ position: 'absolute', top: y, left: 0, width: 1280, height: 1, background: '#00D9FF' }} />
      ))}
      {[0, 90, 180, 270, 360, 450, 540, 630, 720, 810, 900, 990, 1080, 1170, 1260].map((x, i) => (
        <Box key={i} style={{ position: 'absolute', top: 0, left: x, width: 1, height: 720, background: '#00D9FF' }} />
      ))}
    </Box>
    {/* 角落圆环装饰（降级为静态圆环） */}
    <Box style={{ position: 'absolute', top: 100, left: 90, width: 72, height: 72, border: '3px solid #00D9FF', borderRadius: 'sm', opacity: 0.5 }} />
    <Box style={{ position: 'absolute', top: 130, right: 170, width: 54, height: 54, border: '2px solid #00FF88', borderRadius: 'sm', opacity: 0.4 }} />
    <Box style={{ position: 'absolute', bottom: 120, left: 130, width: 63, height: 63, border: '3px solid #FF00FF', borderRadius: 'sm', opacity: 0.4 }} />
    <Box style={{ position: 'absolute', bottom: 105, right: 190, width: 58, height: 58, border: '2px solid #FFAA00', borderRadius: 'sm', opacity: 0.5 }} />
    {/* 中心内容框（半透明底用深色 hex 双层：底层装饰、上层内容） */}
    <Box style={{ flex: 1, alignItems: 'center', justifyContent: 'center' }}>
      <Box style={{ position: 'relative', border: '2px solid #00D9FF', padding: 'xl xxl', borderRadius: 'sm', background: '#0A0E27', boxShadow: '0 0 30px rgba(0,217,255,0.3)' }}>
        {/* 四角装饰（L 形细条） */}
        <Box style={{ position: 'absolute', top: -2, left: -2, width: 18, height: 18, background: 'transparent' }}>
          <Box style={{ position: 'absolute', top: 0, left: 0, width: 18, height: 3, background: '#00D9FF' }} />
          <Box style={{ position: 'absolute', top: 0, left: 0, width: 3, height: 18, background: '#00D9FF' }} />
        </Box>
        <Box style={{ position: 'absolute', top: -2, right: -2, width: 18, height: 18, background: 'transparent' }}>
          <Box style={{ position: 'absolute', top: 0, right: 0, width: 18, height: 3, background: '#00D9FF' }} />
          <Box style={{ position: 'absolute', top: 0, right: 0, width: 3, height: 18, background: '#00D9FF' }} />
        </Box>
        <Box style={{ position: 'absolute', bottom: -2, left: -2, width: 18, height: 18, background: 'transparent' }}>
          <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 18, height: 3, background: '#00D9FF' }} />
          <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 3, height: 18, background: '#00D9FF' }} />
        </Box>
        <Box style={{ position: 'absolute', bottom: -2, right: -2, width: 18, height: 18, background: 'transparent' }}>
          <Box style={{ position: 'absolute', bottom: 0, right: 0, width: 18, height: 3, background: '#00D9FF' }} />
          <Box style={{ position: 'absolute', bottom: 0, right: 0, width: 3, height: 18, background: '#00D9FF' }} />
        </Box>
        <Text style={{ fontSize: 'kpi', color: '#FFFFFF', bold: true, letterSpacing: 4, marginBottom: 'md' }}>{/* {{替换：主标题}} */}谢谢观看</Text>
        <Text style={{ fontSize: 'card', color: '#00D9FF', letterSpacing: 2 }}>{/* {{替换：致谢语}} */}感谢您的聆听</Text>
      </Box>
    </Box>
    {/* 发光粒子装饰（降级为静态圆点） */}
    <Box style={{ position: 'absolute', top: 160, left: 220, width: 8, height: 8, borderRadius: 'sm', background: '#00D9FF', opacity: 0.8 }} />
    <Box style={{ position: 'absolute', top: 470, right: 280, width: 6, height: 6, borderRadius: 'sm', background: '#00FF88', opacity: 0.8 }} />
    <Box style={{ position: 'absolute', bottom: 190, left: 340, width: 7, height: 7, borderRadius: 'sm', background: '#FF00FF', opacity: 0.8 }} />
  </Box>
</Slide>
