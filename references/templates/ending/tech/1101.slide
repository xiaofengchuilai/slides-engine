<Slide>
  {/* ending/tech/1101 科技风-全息界面：深紫渐变 + 全息网格 + 同心圆环 + 居中致谢 */}
  <Box style={{ width: 1280, height: 720, background: 'linear-gradient(135deg, #0F0C29 0%, #302B63 50%, #24243E 100%)' }}>
    {/* 全息网格背景 */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, opacity: 0.2 }}>
      {[0, 40, 80, 120, 160, 200, 240, 280, 320, 360, 400, 440, 480, 520, 560, 600, 640, 680].map((y, i) => (
        <Box key={i} style={{ position: 'absolute', top: y, left: 0, width: 1280, height: 1, background: '#00D4FF' }} />
      ))}
      {[0, 60, 120, 180, 240, 300, 360, 420, 480, 540, 600, 660, 720, 780, 840, 900, 960, 1020, 1080, 1140, 1200, 1260].map((x, i) => (
        <Box key={i} style={{ position: 'absolute', top: 0, left: x, width: 1, height: 720, background: '#00D4FF' }} />
      ))}
    </Box>
    {/* 全息圆环装饰（静态同心圆） */}
    <Box style={{ position: 'absolute', top: 90, left: 370, width: 540, height: 540, border: '2px solid #00D4FF', borderRadius: 'sm', opacity: 0.3 }} />
    <Box style={{ position: 'absolute', top: 135, left: 415, width: 450, height: 450, border: '2px solid #00D4FF', borderRadius: 'sm', opacity: 0.25 }} />
    <Box style={{ position: 'absolute', top: 180, left: 460, width: 360, height: 360, border: '2px solid #00D4FF', borderRadius: 'sm', opacity: 0.2 }} />
    {/* 中心内容框（六边形切角降级为直角框+渐变标题） */}
    <Box style={{ flex: 1, alignItems: 'center', justifyContent: 'center' }}>
      <Box style={{ position: 'relative', border: '2px solid #00D4FF', padding: 'xl xxl', borderRadius: 'sm', background: '#0F0C29', boxShadow: '0 0 50px rgba(0,212,255,0.4)' }}>
        <Text style={{ fontSize: 'kpi', color: '#22D3EE', bold: true, letterSpacing: 5, marginBottom: 'md' }}>{/* {{替换：主标题}} */}谢谢</Text>
        <Text style={{ fontSize: 'card', color: '#00D4FF', letterSpacing: 3 }}>{/* {{替换：致谢语}} */}感谢您的关注与支持</Text>
      </Box>
    </Box>
    {/* 光点装饰 */}
    <Box style={{ position: 'absolute', top: 120, left: 150, width: 6, height: 6, borderRadius: 'sm', background: '#00D4FF', opacity: 0.8 }} />
    <Box style={{ position: 'absolute', top: 230, right: 220, width: 8, height: 8, borderRadius: 'sm', background: '#00FFFF', opacity: 0.8 }} />
    <Box style={{ position: 'absolute', bottom: 160, left: 190, width: 7, height: 7, borderRadius: 'sm', background: '#0099FF', opacity: 0.8 }} />
    <Box style={{ position: 'absolute', bottom: 195, right: 240, width: 6, height: 6, borderRadius: 'sm', background: '#00CCFF', opacity: 0.8 }} />
  </Box>
</Slide>
