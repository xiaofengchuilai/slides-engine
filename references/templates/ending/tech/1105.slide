<Slide>
  {/* ending/tech/1105 科技风-激光：深色渐变 + 网格 + 四边激光边框 + 渐变标题 */}
  <Box style={{ width: 1280, height: 720, background: 'linear-gradient(135deg, #0C0D16 0%, #1A1C2E 100%)' }}>
    {/* 网格背景 */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, opacity: 0.12 }}>
      {[0, 50, 100, 150, 200, 250, 300, 350, 400, 450, 500, 550, 600, 650].map((y, i) => (
        <Box key={i} style={{ position: 'absolute', top: y, left: 0, width: 1280, height: 1, background: '#00FF00' }} />
      ))}
      {[0, 50, 100, 150, 200, 250, 300, 350, 400, 450, 500, 550, 600, 650, 700, 750, 800, 850, 900, 950, 1000, 1050, 1100, 1150, 1200, 1250].map((x, i) => (
        <Box key={i} style={{ position: 'absolute', top: 0, left: x, width: 1, height: 720, background: '#00FF00' }} />
      ))}
    </Box>
    {/* 角落激光发射点（+ 发光） */}
    <Box style={{ position: 'absolute', top: 10, left: 10, width: 18, height: 18, borderRadius: 'sm', background: '#00FF00', opacity: 0.8, boxShadow: '0 0 20px #00FF00' }} />
    <Box style={{ position: 'absolute', top: 10, right: 10, width: 18, height: 18, borderRadius: 'sm', background: '#00FFFF', opacity: 0.8, boxShadow: '0 0 20px #00FFFF' }} />
    <Box style={{ position: 'absolute', bottom: 10, left: 10, width: 18, height: 18, borderRadius: 'sm', background: '#FF00FF', opacity: 0.8, boxShadow: '0 0 20px #FF00FF' }} />
    <Box style={{ position: 'absolute', bottom: 10, right: 10, width: 18, height: 18, borderRadius: 'sm', background: '#FFFF00', opacity: 0.8, boxShadow: '0 0 20px #FFFF00' }} />
    {/* 中心激光边框容器（四边激光条 + 内容） */}
    <Box style={{ flex: 1, alignItems: 'center', justifyContent: 'center' }}>
      <Box style={{ position: 'relative', border: '2px solid #00FF00', borderRadius: 'sm', background: '#0C0D16', padding: 'xl xxl' }}>
        {/* 四边激光条（内衬细条，hex 渐变） */}
        <Box style={{ position: 'absolute', top: 0, left: 0, right: 0, height: 3, background: 'linear-gradient(90deg, #0C0D16 0%, #00FF00 20%, #00FF00 80%, #0C0D16 100%)', opacity: 0.8 }} />
        <Box style={{ position: 'absolute', bottom: 0, left: 0, right: 0, height: 3, background: 'linear-gradient(90deg, #0C0D16 0%, #00FF00 20%, #00FF00 80%, #0C0D16 100%)', opacity: 0.8 }} />
        <Box style={{ position: 'absolute', left: 0, top: 0, bottom: 0, width: 3, background: 'linear-gradient(180deg, #0C0D16 0%, #00FFFF 20%, #00FFFF 80%, #0C0D16 100%)', opacity: 0.8 }} />
        <Box style={{ position: 'absolute', right: 0, top: 0, bottom: 0, width: 3, background: 'linear-gradient(180deg, #0C0D16 0%, #00FFFF 20%, #00FFFF 80%, #0C0D16 100%)', opacity: 0.8 }} />
        <Text style={{ fontSize: 'kpi', color: '#00FF00', bold: true, letterSpacing: 6, marginBottom: 'md' }}>{/* {{替换：主标题}} */}谢谢</Text>
        <Text style={{ fontSize: 'card', color: '#00FFFF', letterSpacing: 3, fontFamily: 'Courier New' }}>{/* {{替换：致谢语}} */}感谢您的宝贵时间</Text>
      </Box>
    </Box>
    {/* 浮动激光点 */}
    <Box style={{ position: 'absolute', top: 180, left: 100, width: 10, height: 10, borderRadius: 'sm', background: '#00FF00', opacity: 0.8 }} />
    <Box style={{ position: 'absolute', top: 430, right: 130, width: 8, height: 8, borderRadius: 'sm', background: '#00FFFF', opacity: 0.8 }} />
  </Box>
</Slide>
