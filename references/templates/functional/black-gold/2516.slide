<Slide>
  {/* functional/black-gold/2516 黑金风-变体2：黑底 + 金色方块/按钮/会员卡/页脚 */}
  <Box style={{ height: 720, width: 1280, background: '#000000', padding: 48 }}>
    <Box style={{ height: 624, justifyContent: 'center', gap: 24 }}>
      {/* 导航 - 金色方块 + 金边按钮 */}
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 24, border: '1px solid rgba(201,162,39,0.3)', background: '#0a0a0a', padding: 20 }}>
        <Box style={{ width: 56, height: 56, background: 'linear-gradient(135deg, #EAB308 0%, #B45309 100%)', alignItems: 'center', justifyContent: 'center', rotate: 45 }}>
          <Text style={{ fontSize: 'card', color: '#000000', bold: true, rotate: -45 }}>{/* {{替换：章节号}} */}3</Text>
        </Box>
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 'card', color: '#EAB308', bold: true, letterSpacing: 2 }}>{/* {{替换：章节名}} */}THE THIRD ACT</Text>
          <Text style={{ fontSize: 'label', color: '#C9A227', marginTop: 4 }}>{/* {{替换：副标签}} */}Elite Leadership</Text>
        </Box>
        <Box style={{ border: '2px solid #C9A227', background: '#000000', padding: 10, paddingLeft: 24, paddingRight: 24 }}>
          <Text style={{ fontSize: 'body', color: '#EAB308', bold: true }}>{/* {{替换：按钮文字}} */}PROCEED →</Text>
        </Box>
      </Box>
      {/* 行动 - 会员尊享卡片 */}
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 32, border: '1px solid rgba(201,162,39,0.3)', background: '#0a0a0a', padding: 20 }}>
        <Box style={{ alignItems: 'center', gap: 12 }}>
          <Box style={{ width: 96, height: 96, border: '4px solid #C9A227', alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 'label', color: '#EAB308', bold: true }}>SCAN</Text>
          </Box>
          <Text style={{ fontSize: 'label', color: '#EAB308', bold: true }}>{/* {{替换：卡片标题}} */}会员专享</Text>
        </Box>
        <Box style={{ width: 2, height: 96, background: 'rgba(201,162,39,0.3)' }} />
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 'title', color: '#EAB308', bold: true, marginBottom: 16 }}>{/* {{替换：标题}} */}Excellence</Text>
          <Box style={{ flexDirection: 'row', gap: 16 }}>
            {[
              ['JOIN', '#C9A227'],
              ['CONSULT', '#B45309'],
              ['CONTACT', '#a16207'],
            ].map((x, i) => (
              <Box key={i} style={{ flex: 1, border: '1px solid ' + x[1], background: 'rgba(202,138,4,0.15)', padding: 12, alignItems: 'center' }}>
                <Text style={{ fontSize: 'label', color: x[1], bold: true }}>{/* {{替换：按钮文字}} */}{x[0]}</Text>
              </Box>
            ))}
          </Box>
        </Box>
      </Box>
      {/* 页脚 - 皇冠图标页脚 */}
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, padding: 12, background: '#0a0a0a' }}>
        <Box style={{ width: 40, height: 40, background: '#C9A227', alignItems: 'center', justifyContent: 'center' }}>
          <Emoji name="👑" style={{ width: 26, height: 26 }} />
        </Box>
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 'body', color: '#EAB308', bold: true, letterSpacing: 2 }}>{/* {{替换：品牌名}} */}ROYAL EXCELLENCE</Text>
          <Text style={{ fontSize: 'label', color: '#C9A227' }}>{/* {{替换：副标签}} */}Since 2024</Text>
        </Box>
        <Text style={{ fontSize: 'label', color: '#a16207' }}>{/* {{替换：版权}} */}© MMXXIV</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
          <Text style={{ fontSize: 'label', color: '#C9A227' }}>Chapter</Text>
          <Box style={{ width: 40, height: 40, background: 'linear-gradient(135deg, #EAB308 0%, #B45309 100%)', alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 'body', color: '#000000', bold: true }}>{/* {{替换：页码}} */}3</Text>
          </Box>
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
