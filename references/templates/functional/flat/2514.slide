<Slide>
  {/* functional/flat/2514 扁平风-变体2：白底 + 翠绿方块指示器/继续按钮/五色图标按钮/极简页脚 */}
  <Box style={{ height: 720, width: 1280, background: 'bg', padding: 48 }}>
    <Box style={{ height: 624, justifyContent: 'center', gap: 20 }}>
      {/* 导航 - 翠绿方块指示器 */}
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, border: '1px solid #D1D5DB', background: '#F9FAFB', padding: 16, borderRadius: 'sm' }}>
        <Box style={{ width: 40, height: 40, background: '#10B981', alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>{/* {{替换：章节号}} */}3</Text>
        </Box>
        <Box>
          <Text style={{ fontSize: 'card', color: 'text', bold: true }}>{/* {{替换：章节名}} */}AGILE DEV</Text>
          <Text style={{ fontSize: 'label', color: 'muted' }}>{/* {{替换：副标签}} */}Sprint Planning</Text>
        </Box>
      </Box>
      {/* 导航 - 继续按钮 */}
      <Box style={{ alignSelf: 'flex-start', background: '#10B981', padding: 8, paddingLeft: 24, paddingRight: 24 }}>
        <Text style={{ fontSize: 'body', color: '#FFFFFF', bold: true }}>{/* {{替换：按钮文字}} */}CONTINUE →</Text>
      </Box>
      {/* 行动 - 五色图标按钮 */}
      <Box style={{ flexDirection: 'row', gap: 12 }}>
        {[
          ['#3B82F6', '📊', 'Dashboard'],
          ['#14B8A6', '📁', 'Resources'],
          ['#A855F7', '💼', 'Portfolio'],
          ['#EC4899', '👥', 'Team'],
          ['#F97316', '⚙️', 'Settings'],
        ].map((x, i) => (
          <Box key={i} style={{ flex: 1, background: x[0], padding: 16, alignItems: 'center' }}>
            <Emoji name={x[1]} style={{ width: 26, height: 26, marginBottom: 8 }} />
            <Text style={{ fontSize: 'label', color: '#FFFFFF', bold: true }}>{/* {{替换：按钮文字}} */}{x[2]}</Text>
          </Box>
        ))}
      </Box>
      {/* 页脚 - 极简页脚 */}
      <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', border: '1px solid #E5E7EB', background: '#F9FAFB', padding: 12, borderRadius: 'sm' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
          <Box style={{ width: 32, height: 32, background: '#10B981' }} />
          <Text style={{ fontSize: 'body', color: 'text', bold: true }}>{/* {{替换：品牌名}} */}COMPANY</Text>
        </Box>
        <Text style={{ fontSize: 'label', color: 'muted' }}>{/* {{替换：版权}} */}© 2024</Text>
        <Text style={{ fontSize: 'body', color: 'text', bold: true }}>{/* {{替换：页码}} */}3 / 12</Text>
      </Box>
    </Box>
  </Box>
</Slide>
