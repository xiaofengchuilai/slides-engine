<Slide>
  {/* functional/geometric/2510 几何风-变体2：白底 + 六边形指示/多边形按钮/六边形按钮组/六边形页脚 */}
  <Box style={{ height: 720, width: 1280, background: 'bg', padding: 48 }}>
    <Box style={{ height: 624, justifyContent: 'center', gap: 20 }}>
      {/* 导航 - 六边形指示器 */}
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 24, border: '1px solid #D1D5DB', background: '#F9FAFB', padding: 16, borderRadius: 'sm' }}>
        <Shape type="hexagon" style={{ width: 60, height: 60, fill: '#14B8A6' }} />
        <Box>
          <Text style={{ fontSize: 'card', color: '#134E4A', bold: true }}>{/* {{替换：章节名}} */}Module 03</Text>
          <Text style={{ fontSize: 'label', color: '#0D9488' }}>{/* {{替换：副标签}} */}Modular Thinking</Text>
        </Box>
      </Box>
      {/* 导航 - 多边形按钮 */}
      <Box style={{ alignSelf: 'flex-start', position: 'relative', width: 160, height: 56 }}>
        <Shape type="hexagon" style={{ width: 160, height: 56, fill: '#0D9488', position: 'absolute', top: 0, left: 0 }} />
        <Box style={{ position: 'absolute', top: 0, left: 0, width: 160, height: 56, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 'body', color: '#FFFFFF', bold: true }}>{/* {{替换：按钮文字}} */}NEXT</Text>
        </Box>
      </Box>
      {/* 行动 - 六边形按钮组 */}
      <Box style={{ flexDirection: 'row', gap: 16 }}>
        {[
          ['#14B8A6', 'Explore'],
          ['#06B6D4', 'Start'],
          ['#0D9488', 'Contact'],
        ].map((x, i) => (
          <Box key={i} style={{ flex: 1, background: x[0], padding: 16, alignItems: 'center' }}>
            <Shape type="hexagon" style={{ width: 40, height: 40, fill: '#FFFFFF', marginBottom: 'xs' }} />
            <Text style={{ fontSize: 'label', color: '#FFFFFF', bold: true }}>{/* {{替换：按钮文字}} */}{x[1]}</Text>
          </Box>
        ))}
      </Box>
      {/* 页脚 - 六边形+旋转方形 */}
      <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', border: '4px solid #99F6E4', background: '#F9FAFB', padding: 12, borderRadius: 'sm' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
          <Shape type="hexagon" style={{ width: 32, height: 32, fill: '#0D9488' }} />
          <Text style={{ fontSize: 'label', color: '#134E4A', bold: true }}>{/* {{替换：品牌名}} */}HEXAGON SYSTEMS</Text>
        </Box>
        <Text style={{ fontSize: 'label', color: '#0D9488' }}>{/* {{替换：版权}} */}© 2024</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
          <Box style={{ width: 32, height: 32, background: '#0D9488', alignItems: 'center', justifyContent: 'center', rotate: 45 }}>
            <Text style={{ fontSize: 'label', color: '#FFFFFF', bold: true, rotate: -45 }}>{/* {{替换：页码}} */}3</Text>
          </Box>
          <Text style={{ fontSize: 'label', color: '#14B8A6' }}>{/* {{替换：总页数}} */}/ 12</Text>
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
