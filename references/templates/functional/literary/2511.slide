<Slide>
  {/* functional/literary/2511 文艺风-变体1：米白底 + 温馨导航/按钮/行动/页脚 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FFFFFF 0%, #FFF7ED 100%)', padding: 48 }}>
    <Box style={{ height: 624, justifyContent: 'center', gap: 24 }}>
      {/* 导航 - 温馨圆形章节 */}
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, border: '1px solid #E5E7EB', background: '#FAFAF9', padding: 20 }}>
        <Box style={{ width: 56, height: 56, borderRadius: 28, background: '#fbbf24', alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true, fontFamily: 'serif' }}>{/* {{替换：章节号}} */}3</Text>
        </Box>
        <Box>
          <Text style={{ fontSize: 'card', color: '#78350f', bold: true, fontFamily: 'serif' }}>{/* {{替换：章节名}} */}第三章·慢生活的艺术</Text>
          <Text style={{ fontSize: 'label', color: '#d97706', fontFamily: 'serif' }}>{/* {{替换：副标签}} */}Chapter Three</Text>
        </Box>
        <Box style={{ flex: 1 }} />
        <Box style={{ background: 'linear-gradient(90deg, #fda4af 0%, #fdba74 100%)', borderRadius: 999, padding: 10, paddingLeft: 24, paddingRight: 24 }}>
          <Text style={{ fontSize: 'body', color: '#881337', bold: true, fontFamily: 'serif' }}>{/* {{替换：按钮文字}} */}继续阅读 →</Text>
        </Box>
      </Box>
      {/* 行动 - 手绘风三联按钮 */}
      <Box style={{ border: '4px dashed #fcd34d', borderRadius: 24, background: 'rgba(255,255,255,0.85)', padding: 20, flexDirection: 'row', justifyContent: 'space-around', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
        {[
          ['#fef9c3', '#fde047', '📚', '阅读原文'],
          ['#fce7f3', '#f9a8d4', '💬', '留言交流'],
          ['#dcfce7', '#86efac', '⭐', '收藏本文'],
        ].map((x, i) => (
          <Box key={i} style={{ alignItems: 'center', gap: 8 }}>
            <Box style={{ width: 64, height: 64, borderRadius: 32, background: x[0], border: '4px solid ' + x[1], alignItems: 'center', justifyContent: 'center' }}>
              <Emoji name={x[2]} style={{ width: 30, height: 30 }} />
            </Box>
            <Text style={{ fontSize: 'label', color: '#78350f', bold: true, fontFamily: 'serif' }}>{/* {{替换：按钮文字}} */}{x[3]}</Text>
          </Box>
        ))}
      </Box>
      {/* 页脚 - 咖啡图标页脚 */}
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, border: '2px solid #fde68a', borderRadius: 16, background: 'rgba(255,255,255,0.8)', padding: 16 }}>
        <Box style={{ width: 40, height: 40, borderRadius: 20, background: 'linear-gradient(135deg, #fbbf24 0%, #fb7185 100%)', alignItems: 'center', justifyContent: 'center' }}>
          <Emoji name="☕" style={{ width: 24, height: 24 }} />
        </Box>
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 'body', color: '#78350f', bold: true, fontFamily: 'serif' }}>{/* {{替换：品牌名}} */}温馨生活杂志</Text>
          <Text style={{ fontSize: 'label', color: '#d97706', fontFamily: 'serif' }}>{/* {{替换：副标签}} */}Warm Life</Text>
        </Box>
        <Text style={{ fontSize: 'label', color: '#d97706', fontFamily: 'serif' }}>{/* {{替换：版权}} */}© 2024 用心感受生活</Text>
        <Box style={{ background: '#fbbf24', borderRadius: 999, padding: 8, paddingLeft: 16, paddingRight: 16 }}>
          <Text style={{ fontSize: 'label', color: '#FFFFFF', bold: true, fontFamily: 'serif' }}>{/* {{替换：页码}} */}第 3 页</Text>
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
