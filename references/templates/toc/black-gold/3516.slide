<Slide>
  {/* black-gold/3516 黑金风-立体层次：纯黑底 + 左侧标题（金线分隔）+ 右侧金条章节列表 */}
  <Box style={{ height: 720, width: 1280, background: '#000000', padding: 48 }}>
    <Box style={{ height: 624, flexDirection: 'row' }}>
      {/* 左侧标题区 */}
      <Box style={{ width: 480, alignItems: 'center', justifyContent: 'center', position: 'relative' }}>
        <Box style={{ width: 48, height: 48, border: '2px solid #C9A227', borderRadius: 24, alignItems: 'center', justifyContent: 'center', marginBottom: 12 }}>
          <Box style={{ width: 16, height: 16, background: '#C9A227', borderRadius: 8 }} />
        </Box>
        <Text style={{ fontSize: 'title', color: '#EAB308', bold: true, letterSpacing: 4, marginBottom: 8 }}>{/* {{标题}} */}目录</Text>
        <Text style={{ fontSize: 'label', color: '#C9A227', letterSpacing: 4, marginTop: 8 }}>TABLE OF CONTENTS</Text>
        <Box style={{ position: 'absolute', right: 0, top: 0, bottom: 0, width: 1, background: 'rgba(201,162,39,0.3)' }} />
      </Box>
      {/* 右侧章节列表 */}
      <Box style={{ flex: 1, justifyContent: 'center', paddingLeft: 48, gap: 20 }}>
        {[
          ['01', '品牌故事', 'Brand Story'],
          ['02', '产品体系', 'Product System'],
          ['03', '市场表现', 'Market Performance'],
          ['04', '未来愿景', 'Future Vision'],
        ].map((x, i) => (
          <Box key={i} style={{ flexDirection: 'row', alignItems: 'baseline', gap: 16, paddingLeft: 32, position: 'relative' }}>
            <Box style={{ position: 'absolute', left: 0, top: 0, bottom: 0, width: 4, background: 'linear-gradient(180deg, #EAB308 0%, #CA8A04 100%)' }} />
            <Text style={{ fontSize: 'kpi', color: '#C9A227', bold: true }}>{/* {{章节编号}} */}{x[0]}</Text>
            <Box style={{ flex: 1 }}>
              <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>{/* {{章节名}} */}{x[1]}</Text>
              <Text style={{ fontSize: 'body', color: '#6b7280', marginTop: 4 }}>{/* {{章节副标题}} */}{x[2]}</Text>
            </Box>
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
</Slide>
