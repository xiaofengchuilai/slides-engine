<Slide>
  {/* business/3544 商务风-双栏布局：居中标题 + 2x2 编号卡片（左侧色条） */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #F9FAFB 0%, #F1F5F9 100%)', padding: 48 }}>
    <Box style={{ height: 624, justifyContent: 'center' }}>
      <Text style={{ fontSize: 'title', color: 'text', bold: true, textAlign: 'center', marginBottom: 40 }}>{/* {{标题}} */}目录</Text>
      <Box style={{ flexDirection: 'row', gap: 32, flexWrap: 'wrap' }}>
        {[
          ['01', '项目背景'],
          ['02', '核心功能'],
          ['03', '技术架构'],
          ['04', '实施计划'],
        ].map((x, i) => (
          <Box key={i} style={{ width: 572, background: 'cardBg', borderRadius: 8, padding: 24, flexDirection: 'row', gap: 20, alignItems: 'center', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
            <Box style={{ width: 4, height: 56, background: 'secondary', borderRadius: 2 }} />
            <Box style={{ width: 56, height: 56, background: 'linear-gradient(135deg, #2563EB 0%, #1E3A8A 100%)', borderRadius: 8, alignItems: 'center', justifyContent: 'center' }}>
              <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>{x[0]}</Text>
            </Box>
            <Text style={{ fontSize: 'card', color: 'text', bold: true }}>{/* {{章节名}} */}{x[1]}</Text>
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
</Slide>
