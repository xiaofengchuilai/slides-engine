<Slide>
  {/* business/3545 商务风-蓝色主题：深蓝渐变底 + 居中标签标题 + 白卡章节列表 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #1E3A8A 0%, #1E40AF 100%)', padding: 48 }}>
    <Box style={{ height: 624, justifyContent: 'center' }}>
      <Box style={{ alignItems: 'center', marginBottom: 40 }}>
        <Box style={{ background: 'secondary', opacity: 0.85, borderRadius: 8, padding: '16px 40px' }}>
          <Text style={{ fontSize: 'title', color: '#FFFFFF', bold: true }}>{/* {{标题}} */}目录</Text>
        </Box>
      </Box>
      <Box style={{ gap: 20 }}>
        {[
          ['1', '项目背景'],
          ['2', '核心功能'],
          ['3', '技术架构'],
          ['4', '实施计划'],
        ].map((x, i) => (
          <Box key={i} style={{ flexDirection: 'row', gap: 24, alignItems: 'center', background: 'cardBg', padding: 20, borderRadius: 8, boxShadow: '0 12px 36px rgba(0,0,0,0.22)' }}>
            <Box style={{ width: 64, height: 64, background: 'linear-gradient(135deg, #2563EB 0%, #1E3A8A 100%)', borderRadius: 8, alignItems: 'center', justifyContent: 'center', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
              <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>{x[0]}</Text>
            </Box>
            <Text style={{ fontSize: 'card', color: 'text', bold: true }}>{/* {{章节名}} */}{x[1]}</Text>
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
</Slide>
