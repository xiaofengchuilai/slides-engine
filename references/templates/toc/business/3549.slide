<Slide>
  {/* business/3549 商务风-深色主题：深灰渐变底 + 金色点缀 + 深色章节行 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #111827 0%, #0F172A 100%)', padding: 48 }}>
    <Box style={{ height: 624, justifyContent: 'center', position: 'relative' }}>
      <Box style={{ position: 'absolute', top: 0, left: 48, right: 48, height: 4, background: 'linear-gradient(90deg, #B45309 0%, #F59E0B 50%, #B45309 100%)' }} />
      <Box style={{ position: 'absolute', bottom: 0, left: 48, right: 48, height: 4, background: 'linear-gradient(90deg, #B45309 0%, #F59E0B 50%, #B45309 100%)' }} />
      <Box style={{ alignItems: 'center', marginBottom: 40 }}>
        <Text style={{ fontSize: 'title', color: '#FFFFFF', bold: true, textAlign: 'center', paddingBottom: 16 }}>{/* {{标题}} */}目录</Text>
        <Box style={{ width: 640, height: 4, background: 'accent', borderRadius: 2, marginTop: 12 }} />
      </Box>
      <Box style={{ gap: 20 }}>
        {[
          ['1', '项目背景'],
          ['2', '核心功能'],
          ['3', '技术架构'],
          ['4', '实施计划'],
        ].map((x, i) => (
          <Box key={i} style={{ flexDirection: 'row', gap: 24, alignItems: 'center', background: 'cardBg', padding: 20, borderRadius: 8, position: 'relative' }}>
            <Box style={{ position: 'absolute', left: 0, top: 0, bottom: 0, width: 4, background: 'accent', borderRadius: 2 }} />
            <Box style={{ width: 64, height: 64, background: 'linear-gradient(135deg, #D97706 0%, #B45309 100%)', borderRadius: 8, alignItems: 'center', justifyContent: 'center', boxShadow: '0 12px 36px rgba(0,0,0,0.22)' }}>
              <Text style={{ fontSize: 'card', color: '#0F172A', bold: true }}>{x[0]}</Text>
            </Box>
            <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>{/* {{章节名}} */}{x[1]}</Text>
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
</Slide>
