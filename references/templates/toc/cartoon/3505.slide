            <Box style={{ background: '#FFFFFF', border: '4px solid #d8b4fe', borderRadius: 24, padding: 20, paddingLeft: 56, boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
              <Text style={{ fontSize: 'card', color: '#374151', bold: true }}>{/* {{章节名}} */}未来展望</Text>
              <Text style={{ fontSize: 'body', color: '#6b7280', marginTop: 4 }}>{/* {{章节副标题}} */}Future Outlook</Text>
