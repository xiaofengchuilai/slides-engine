      <Text style={{ fontSize: 'title', color: '#ff6b9d', bold: true, textAlign: 'center', marginBottom: 40 }}>{/* {{标题}} */}目录 CONTENTS</Text>
      <Box style={{ gap: 24 }}>
        <Box style={{ flexDirection: 'row', gap: 24 }}>
          <Box style={{ flex: 1, position: 'relative' }}>
            <Box style={{ position: 'absolute', top: -8, left: -8, width: 56, height: 56, borderRadius: 28, background: '#f472b6', alignItems: 'center', justifyContent: 'center', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
              <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>{/* {{章节编号}} */}1</Text>
            </Box>
            <Box style={{ background: '#FFFFFF', border: '4px solid #f9a8d4', borderRadius: 24, padding: 20, paddingLeft: 56, boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
              <Text style={{ fontSize: 'card', color: '#374151', bold: true }}>{/* {{章节名}} */}项目介绍</Text>
              <Text style={{ fontSize: 'body', color: '#6b7280', marginTop: 4 }}>{/* {{章节副标题}} */}Project Introduction</Text>
            </Box>
          </Box>
          <Box style={{ flex: 1, position: 'relative' }}>
            <Box style={{ position: 'absolute', top: -8, left: -8, width: 56, height: 56, borderRadius: 28, background: '#60a5fa', alignItems: 'center', justifyContent: 'center', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
              <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>{/* {{章节编号}} */}2</Text>
            </Box>
            <Box style={{ background: '#FFFFFF', border: '4px solid #93c5fd', borderRadius: 24, padding: 20, paddingLeft: 56, boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
              <Text style={{ fontSize: 'card', color: '#374151', bold: true }}>{/* {{章节名}} */}核心内容</Text>
              <Text style={{ fontSize: 'body', color: '#6b7280', marginTop: 4 }}>{/* {{章节副标题}} */}Core Content</Text>
            </Box>
          </Box>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 24 }}>
          <Box style={{ flex: 1, position: 'relative' }}>
            <Box style={{ position: 'absolute', top: -8, left: -8, width: 56, height: 56, borderRadius: 28, background: '#4ade80', alignItems: 'center', justifyContent: 'center', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
              <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>{/* {{章节编号}} */}3</Text>
            </Box>
            <Box style={{ background: '#FFFFFF', border: '4px solid #86efac', borderRadius: 24, padding: 20, paddingLeft: 56, boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
              <Text style={{ fontSize: 'card', color: '#374151', bold: true }}>{/* {{章节名}} */}实施方案</Text>
              <Text style={{ fontSize: 'body', color: '#6b7280', marginTop: 4 }}>{/* {{章节副标题}} */}Implementation</Text>
            </Box>
          </Box>
          <Box style={{ flex: 1, position: 'relative' }}>
            <Box style={{ position: 'absolute', top: -8, left: -8, width: 56, height: 56, borderRadius: 28, background: '#c084fc', alignItems: 'center', justifyContent: 'center', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
              <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>{/* {{章节编号}} */}4</Text>
