<Slide>
  {/* cartoon/3505 卡通风-彩色气泡：黄粉紫渐变底 + 彩色标题 + 2x2 圆角卡（角上圆编号） */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FEF9C3 0%, #FCE7F3 50%, #EDE9FE 100%)', padding: 48 }}>
