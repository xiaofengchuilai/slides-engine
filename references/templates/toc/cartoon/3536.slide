<Slide>
  {/* cartoon/3536 卡通风-云朵漂浮：蓝天渐变底 + 云朵装饰 + 白卡章节（黄橙圆编号） */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(180deg, #93C5FD 0%, #BFDBFE 50%, #CFFAFE 100%)', padding: 48, position: 'relative' }}>
    {/* 云朵装饰（圆组合） */}
    <Box style={{ position: 'absolute', top: 60, left: 48, flexDirection: 'row', alignItems: 'flex-end' }}>
      <Box style={{ width: 48, height: 32, borderRadius: 16, background: '#FFFFFF', opacity: 0.7 }} />
      <Box style={{ width: 64, height: 48, borderRadius: 24, background: '#FFFFFF', opacity: 0.7 }} />
      <Box style={{ width: 40, height: 32, borderRadius: 16, background: '#FFFFFF', opacity: 0.7 }} />
    </Box>
    <Box style={{ position: 'absolute', bottom: 80, right: 48, flexDirection: 'row', alignItems: 'flex-end' }}>
      <Box style={{ width: 40, height: 24, borderRadius: 12, background: '#FFFFFF', opacity: 0.7 }} />
      <Box style={{ width: 56, height: 40, borderRadius: 20, background: '#FFFFFF', opacity: 0.7 }} />
      <Box style={{ width: 32, height: 24, borderRadius: 12, background: '#FFFFFF', opacity: 0.7 }} />
    </Box>
    <Box style={{ height: 624, justifyContent: 'center' }}>
      <Box style={{ alignItems: 'center', marginBottom: 32 }}>
        <Box style={{ background: '#FFFFFF', borderRadius: 999, padding: 20, paddingLeft: 40, paddingRight: 40, boxShadow: '0 16px 48px rgba(0,0,0,0.28)' }}>
          <Text style={{ fontSize: 'title', color: '#1d4ed8', bold: true }}>{/* {{标题}} */}目录</Text>
        </Box>
      </Box>
      <Box style={{ gap: 16 }}>
        {[
          ['1', '项目背景'],
          ['2', '核心功能'],
          ['3', '技术架构'],
          ['4', '实施计划'],
        ].map((x, i) => (
          <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 20, background: '#FFFFFF', borderRadius: 24, padding: 20, boxShadow: '0 12px 36px rgba(0,0,0,0.22)' }}>
            <Box style={{ width: 80, height: 80, background: 'linear-gradient(135deg, #facc15 0%, #fb923c 100%)', borderRadius: 40, alignItems: 'center', justifyContent: 'center', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
              <Text style={{ fontSize: 'kpi', color: '#FFFFFF', bold: true }}>{/* {{章节编号}} */}{x[0]}</Text>
            </Box>
            <Text style={{ fontSize: 'card', color: '#374151', bold: true }}>{/* {{章节名}} */}{x[1]}</Text>
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
</Slide>
