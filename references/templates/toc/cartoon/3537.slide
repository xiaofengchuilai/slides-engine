<Slide>
  {/* cartoon/3537 卡通风-彩虹桥：浅蓝白渐变底 + 彩虹弧 + 2x2 彩虹边章节卡 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(180deg, #BAE6FD 0%, #E0F2FE 50%, #FFFFFF 100%)', padding: 48, position: 'relative' }}>
    {/* 彩虹弧（降级为色带圆环顶部） */}
    <Box style={{ position: 'absolute', top: -180, left: 190, width: 900, height: 360, border: '18px solid #ef4444', borderRadius: 450, opacity: 0.25 }} />
    <Box style={{ height: 624, justifyContent: 'center' }}>
      <Box style={{ alignItems: 'center', marginBottom: 32 }}>
        <Text style={{ fontSize: 'title', color: '#db2777', bold: true }}>{/* {{标题}} */}目录</Text>
      </Box>
      <Box style={{ gap: 24 }}>
        <Box style={{ flexDirection: 'row', gap: 24 }}>
          <Box style={{ flex: 1, background: 'rgba(255,255,255,0.85)', border: '4px solid #fca5a5', borderRadius: 24, padding: 24, boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 20 }}>
              <Box style={{ width: 56, height: 56, background: 'linear-gradient(135deg, #f87171 0%, #fb923c 100%)', borderRadius: 16, alignItems: 'center', justifyContent: 'center', boxShadow: '0 4px 12px rgba(0,0,0,0.15)' }}>
                <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>{/* {{章节编号}} */}1</Text>
              </Box>
              <Text style={{ fontSize: 'card', color: '#374151', bold: true }}>{/* {{章节名}} */}项目背景</Text>
            </Box>
          </Box>
          <Box style={{ flex: 1, background: 'rgba(255,255,255,0.85)', border: '4px solid #fde047', borderRadius: 24, padding: 24, boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 20 }}>
              <Box style={{ width: 56, height: 56, background: 'linear-gradient(135deg, #facc15 0%, #4ade80 100%)', borderRadius: 16, alignItems: 'center', justifyContent: 'center', boxShadow: '0 4px 12px rgba(0,0,0,0.15)' }}>
                <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>{/* {{章节编号}} */}2</Text>
              </Box>
              <Text style={{ fontSize: 'card', color: '#374151', bold: true }}>{/* {{章节名}} */}核心功能</Text>
            </Box>
          </Box>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 24 }}>
          <Box style={{ flex: 1, background: 'rgba(255,255,255,0.85)', border: '4px solid #86efac', borderRadius: 24, padding: 24, boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 20 }}>
              <Box style={{ width: 56, height: 56, background: 'linear-gradient(135deg, #4ade80 0%, #60a5fa 100%)', borderRadius: 16, alignItems: 'center', justifyContent: 'center', boxShadow: '0 4px 12px rgba(0,0,0,0.15)' }}>
                <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>{/* {{章节编号}} */}3</Text>
              </Box>
              <Text style={{ fontSize: 'card', color: '#374151', bold: true }}>{/* {{章节名}} */}技术架构</Text>
            </Box>
          </Box>
          <Box style={{ flex: 1, background: 'rgba(255,255,255,0.85)', border: '4px solid #d8b4fe', borderRadius: 24, padding: 24, boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 20 }}>
              <Box style={{ width: 56, height: 56, background: 'linear-gradient(135deg, #60a5fa 0%, #a855f7 100%)', borderRadius: 16, alignItems: 'center', justifyContent: 'center', boxShadow: '0 4px 12px rgba(0,0,0,0.15)' }}>
                <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>{/* {{章节编号}} */}4</Text>
              </Box>
              <Text style={{ fontSize: 'card', color: '#374151', bold: true }}>{/* {{章节名}} */}实施计划</Text>
            </Box>
          </Box>
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
