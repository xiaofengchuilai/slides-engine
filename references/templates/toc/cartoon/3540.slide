<Slide>
  {/* cartoon/3540 卡通风-冰淇淋：粉紫青浅底 + 四列冰淇淋球章节（圆球+蛋筒三角降级梯形） */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(180deg, #FCE7F3 0%, #FAF5FF 50%, #ECFEFF 100%)', padding: 48, position: 'relative' }}>
    {/* 装饰圆点 */}
    <Box style={{ position: 'absolute', top: 48, right: 64, width: 48, height: 48, borderRadius: 24, background: '#fbcfe8', opacity: 0.6 }} />
    <Box style={{ position: 'absolute', bottom: 64, left: 64, width: 40, height: 40, borderRadius: 20, background: '#a5f3fc', opacity: 0.6 }} />
    <Box style={{ height: 624, justifyContent: 'center' }}>
      <Box style={{ alignItems: 'center', marginBottom: 40 }}>
        <Box style={{ background: '#FFFFFF', border: '4px solid #f9a8d4', borderRadius: 999, padding: 16, paddingLeft: 40, paddingRight: 40, boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
          <Text style={{ fontSize: 'title', color: '#ec4899', bold: true }}>{/* {{标题}} */}目录</Text>
        </Box>
      </Box>
      <Box style={{ flexDirection: 'row', justifyContent: 'center', gap: 48, alignItems: 'flex-start' }}>
        {[
          ['1', '项目背景', 'linear-gradient(135deg, #f9a8d4 0%, #f472b6 100%)'],
          ['2', '核心功能', 'linear-gradient(135deg, #d8b4fe 0%, #c084fc 100%)'],
          ['3', '技术架构', 'linear-gradient(135deg, #67e8f9 0%, #22d3ee 100%)'],
          ['4', '实施计划', 'linear-gradient(135deg, #fde047 0%, #fdba74 100%)'],
        ].map((x, i) => (
          <Box key={i} style={{ alignItems: 'center' }}>
            {/* 冰淇淋球 */}
            <Box style={{ width: 144, height: 144, borderRadius: 72, background: x[2], alignItems: 'center', justifyContent: 'center', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
              <Box style={{ alignItems: 'center' }}>
                <Text style={{ fontSize: 'kpi', color: '#FFFFFF', bold: true, marginBottom: 4 }}>{/* {{章节编号}} */}{x[0]}</Text>
                <Text style={{ fontSize: 'body', color: '#FFFFFF', bold: true }}>{/* {{章节名}} */}{x[1]}</Text>
              </Box>
            </Box>
            {/* 蛋筒（梯形） */}
            <Box style={{ width: 64, height: 56, background: '#d97706', marginTop: -8 }}>
              <Box style={{ width: 64, height: 8, background: '#f59e0b' }} />
              <Box style={{ width: 64, height: 8, background: '#d97706' }} />
              <Box style={{ width: 64, height: 8, background: '#f59e0b' }} />
              <Box style={{ width: 64, height: 8, background: '#d97706' }} />
              <Box style={{ width: 64, height: 8, background: '#f59e0b' }} />
              <Box style={{ width: 64, height: 8, background: '#d97706' }} />
            </Box>
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
</Slide>
