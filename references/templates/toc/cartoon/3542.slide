<Slide>
  {/* cartoon/3542 卡通风-蜡笔涂鸦：黄粉浅底 + 涂鸦线条 + 白卡章节（虚线边框降级实线+黄橙圆编号） */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FEF9C3 0%, #FCE7F3 100%)', padding: 48, position: 'relative' }}>
    {/* 涂鸦装饰线条 */}
    <Box style={{ position: 'absolute', top: 80, left: 40, width: 128, height: 4, background: '#f87171', opacity: 0.4, rotate: 12 }} />
    <Box style={{ position: 'absolute', top: 160, right: 80, width: 160, height: 4, background: '#60a5fa', opacity: 0.4, rotate: -12 }} />
    <Box style={{ position: 'absolute', bottom: 80, left: 160, width: 96, height: 4, background: '#4ade80', opacity: 0.4, rotate: 45 }} />
    <Box style={{ height: 624, justifyContent: 'center' }}>
      <Box style={{ alignItems: 'center', marginBottom: 32 }}>
        <Box style={{ background: '#FFFFFF', border: '4px dashed #c084fc', borderRadius: 16, padding: 20, paddingLeft: 40, paddingRight: 40, boxShadow: '0 12px 36px rgba(0,0,0,0.22)' }}>
          <Text style={{ fontSize: 'title', color: '#7e22ce', bold: true }}>{/* {{标题}} */}目录</Text>
        </Box>
      </Box>
      <Box style={{ gap: 16 }}>
        {[
          ['1', '项目背景'],
          ['2', '核心功能'],
          ['3', '技术架构'],
          ['4', '实施计划'],
        ].map((x, i) => (
          <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 20, background: '#FFFFFF', border: '4px dashed #d8b4fe', borderRadius: 16, padding: 20, boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
            <Box style={{ width: 64, height: 64, background: 'linear-gradient(135deg, #facc15 0%, #fb923c 100%)', borderRadius: 32, alignItems: 'center', justifyContent: 'center', border: '4px solid #FFFFFF', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
              <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>{/* {{章节编号}} */}{x[0]}</Text>
            </Box>
            <Text style={{ fontSize: 'card', color: '#374151', bold: true }}>{/* {{章节名}} */}{x[1]}</Text>
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
</Slide>
