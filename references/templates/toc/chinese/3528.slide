<Slide>
  {/* chinese/3528 中国风-祥云纹：红黄渐变底 + 圆角标题 + 红金章节列表（左侧红条） */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FEF2F2 0%, #FEFCE8 50%, #FEF2F2 100%)', padding: 48, position: 'relative' }}>
    {/* 祥云装饰（降级为圆点云朵） */}
    <Box style={{ position: 'absolute', top: 40, right: 40, flexDirection: 'row', alignItems: 'center', gap: 6 }}>
      <Box style={{ width: 16, height: 16, borderRadius: 8, background: '#fecaca', opacity: 0.6 }} />
      <Box style={{ width: 24, height: 24, borderRadius: 12, background: '#fecaca', opacity: 0.6 }} />
      <Box style={{ width: 16, height: 16, borderRadius: 8, background: '#fecaca', opacity: 0.6 }} />
    </Box>
    <Box style={{ position: 'absolute', bottom: 40, left: 40, flexDirection: 'row', alignItems: 'center', gap: 6 }}>
      <Box style={{ width: 20, height: 20, borderRadius: 10, background: '#fde68a', opacity: 0.6 }} />
      <Box style={{ width: 28, height: 28, borderRadius: 14, background: '#fde68a', opacity: 0.6 }} />
      <Box style={{ width: 20, height: 20, borderRadius: 10, background: '#fde68a', opacity: 0.6 }} />
    </Box>
    <Box style={{ height: 624, justifyContent: 'center' }}>
      <Box style={{ alignItems: 'center', marginBottom: 32 }}>
        <Box style={{ background: 'linear-gradient(90deg, #FEF9C3 0%, #FEE2E2 50%, #FEF9C3 100%)', border: '4px solid #dc2626', borderRadius: 999, padding: 12, paddingLeft: 40, paddingRight: 40 }}>
          <Text style={{ fontSize: 'title', color: '#991b1b', bold: true, fontFamily: 'serif' }}>{/* {{标题}} */}目录</Text>
        </Box>
      </Box>
      <Box style={{ gap: 16 }}>
        {[
          ['1', '项目背景'],
          ['2', '核心功能'],
          ['3', '技术架构'],
          ['4', '实施计划'],
        ].map((x, i) => (
          <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 24, background: '#FFFFFF', borderRadius: 8, border: '1px solid #FDE68A', padding: 20, position: 'relative', boxShadow: '0 4px 12px rgba(0,0,0,0.15)' }}>
            <Box style={{ position: 'absolute', left: 0, top: 0, bottom: 0, width: 8, background: '#dc2626' }} />
            <Box style={{ width: 64, height: 64, background: 'linear-gradient(135deg, #dc2626 0%, #ca8a04 100%)', borderRadius: 8, alignItems: 'center', justifyContent: 'center' }}>
              <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>{/* {{章节编号}} */}{x[0]}</Text>
            </Box>
            <Text style={{ fontSize: 'card', color: '#374151', bold: true }}>{/* {{章节名}} */}{x[1]}</Text>
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
</Slide>
