<Slide>
  {/* chinese/3530 中国风-折扇式：米金底 + 左侧标题（红竖条+印字）+ 右侧四列扇骨竖卡 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FDF6E3 0%, #F5E6C8 100%)', padding: 48 }}>
    <Box style={{ height: 624, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
      {/* 左侧标题 */}
      <Box style={{ flexDirection: 'column' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, marginBottom: 32 }}>
          <Box style={{ width: 4, height: 96, background: '#991b1b' }} />
          <Text style={{ fontSize: 'hero', color: '#111827', bold: true, fontFamily: 'serif' }}>{/* {{标题}} */}目录</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
          <Box style={{ width: 32, height: 32, borderRadius: 16, border: '2px solid #991b1b', alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 'label', color: '#991b1b', bold: true, fontFamily: 'serif' }}>印</Text>
          </Box>
          <Text style={{ fontSize: 'label', color: '#92400e', letterSpacing: 4, fontFamily: 'serif' }}>CONTENTS</Text>
        </Box>
      </Box>
      {/* 右侧四列扇骨竖卡（竖排改横排） */}
      <Box style={{ flexDirection: 'row', gap: 32, alignItems: 'flex-end' }}>
        {[
          ['1', '项目背景'],
          ['2', '核心功能'],
          ['3', '技术架构'],
          ['4', '实施计划'],
        ].map((x, i) => (
          <Box key={i} style={{ width: 96, height: 320, background: 'rgba(255,255,255,0.85)', border: '1px solid rgba(146,64,14,0.15)', borderRadius: 48, alignItems: 'center', paddingTop: 24, position: 'relative', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
            {/* 扇骨 */}
            <Box style={{ position: 'absolute', bottom: 0, left: 48, width: 2, height: 320, background: 'linear-gradient(180deg, rgba(146,64,14,0.4) 0%, rgba(146,64,14,0) 100%)' }} />
            <Box style={{ width: 32, height: 32, background: '#991b1b', alignItems: 'center', justifyContent: 'center', marginBottom: 16 }}>
              <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true, fontFamily: 'serif' }}>{/* {{章节编号}} */}{x[0]}</Text>
            </Box>
            <Text style={{ fontSize: 'card', color: '#374151', fontFamily: 'serif', bold: true, textAlign: 'center' }}>{/* {{章节名}} */}{x[1]}</Text>
            <Box style={{ width: 2, height: 32, background: 'rgba(146,64,14,0.2)', marginTop: 16 }} />
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
</Slide>
