<Slide>
  {/* chinese/3531 中国风-卷轴式：米金渐变底 + 居中标题（印章+下划线）+ 2x2 章节卡 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #F5F1E8 0%, #EDE4D3 50%, #F5F1E8 100%)', padding: 48, position: 'relative' }}>
    {/* 左右卷轴装饰线 */}
    <Box style={{ position: 'absolute', left: 0, top: 60, bottom: 60, width: 2, background: 'linear-gradient(180deg, rgba(146,64,14,0) 0%, rgba(146,64,14,0.2) 50%, rgba(146,64,14,0) 100%)' }} />
    <Box style={{ position: 'absolute', right: 0, top: 60, bottom: 60, width: 2, background: 'linear-gradient(180deg, rgba(146,64,14,0) 0%, rgba(146,64,14,0.2) 50%, rgba(146,64,14,0) 100%)' }} />
    <Box style={{ height: 624, justifyContent: 'center' }}>
      {/* 顶部标题区 */}
      <Box style={{ alignItems: 'center', marginBottom: 40, position: 'relative' }}>
        <Box style={{ position: 'absolute', top: -32, left: 200, width: 48, height: 48, border: '2px solid #b91c1c', opacity: 0.3, rotate: 45 }} />
        <Text style={{ fontSize: 'hero', color: '#111827', bold: true, letterSpacing: 8, fontFamily: 'serif' }}>{/* {{标题}} */}目录</Text>
        <Box style={{ width: 128, height: 3, background: 'linear-gradient(90deg, rgba(185,28,28,0) 0%, #b91c1c 50%, rgba(185,28,28,0) 100%)', marginTop: 12 }} />
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginTop: 24 }}>
          <Box style={{ width: 48, height: 1, background: 'linear-gradient(90deg, rgba(146,64,14,0) 0%, #b45309 100%)' }} />
          <Box style={{ flexDirection: 'row', gap: 4 }}>
            <Box style={{ width: 6, height: 6, borderRadius: 3, background: '#b91c1c' }} />
            <Box style={{ width: 6, height: 6, borderRadius: 3, background: '#b91c1c' }} />
            <Box style={{ width: 6, height: 6, borderRadius: 3, background: '#b91c1c' }} />
          </Box>
          <Box style={{ width: 48, height: 1, background: 'linear-gradient(270deg, rgba(146,64,14,0) 0%, #b45309 100%)' }} />
        </Box>
      </Box>
      {/* 章节网格 */}
      <Box style={{ gap: 24 }}>
        <Box style={{ flexDirection: 'row', gap: 64 }}>
          <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 20, background: 'linear-gradient(120deg, rgba(255,255,255,0.6) 0%, rgba(255,251,235,0.8) 100%)', borderRadius: 12, padding: 20, boxShadow: '0 4px 12px rgba(0,0,0,0.15)' }}>
            <Box style={{ width: 48, height: 48, borderRadius: 24, background: 'linear-gradient(135deg, #b91c1c 0%, #7f1d1d 100%)', alignItems: 'center', justifyContent: 'center' }}>
              <Text style={{ fontSize: 'card', color: '#fef3c7', bold: true, fontFamily: 'serif' }}>{/* {{章节编号}} */}1</Text>
            </Box>
            <Text style={{ flex: 1, fontSize: 'card', color: '#374151', fontFamily: 'serif' }}>{/* {{章节名}} */}项目背景</Text>
          </Box>
          <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 20, background: 'linear-gradient(120deg, rgba(255,255,255,0.6) 0%, rgba(255,251,235,0.8) 100%)', borderRadius: 12, padding: 20, boxShadow: '0 4px 12px rgba(0,0,0,0.15)' }}>
            <Box style={{ width: 48, height: 48, borderRadius: 24, background: 'linear-gradient(135deg, #b91c1c 0%, #7f1d1d 100%)', alignItems: 'center', justifyContent: 'center' }}>
              <Text style={{ fontSize: 'card', color: '#fef3c7', bold: true, fontFamily: 'serif' }}>{/* {{章节编号}} */}2</Text>
            </Box>
            <Text style={{ flex: 1, fontSize: 'card', color: '#374151', fontFamily: 'serif' }}>{/* {{章节名}} */}核心功能</Text>
          </Box>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 64 }}>
          <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 20, background: 'linear-gradient(120deg, rgba(255,255,255,0.6) 0%, rgba(255,251,235,0.8) 100%)', borderRadius: 12, padding: 20, boxShadow: '0 4px 12px rgba(0,0,0,0.15)' }}>
            <Box style={{ width: 48, height: 48, borderRadius: 24, background: 'linear-gradient(135deg, #b91c1c 0%, #7f1d1d 100%)', alignItems: 'center', justifyContent: 'center' }}>
              <Text style={{ fontSize: 'card', color: '#fef3c7', bold: true, fontFamily: 'serif' }}>{/* {{章节编号}} */}3</Text>
            </Box>
            <Text style={{ flex: 1, fontSize: 'card', color: '#374151', fontFamily: 'serif' }}>{/* {{章节名}} */}技术架构</Text>
          </Box>
          <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 20, background: 'linear-gradient(120deg, rgba(255,255,255,0.6) 0%, rgba(255,251,235,0.8) 100%)', borderRadius: 12, padding: 20, boxShadow: '0 4px 12px rgba(0,0,0,0.15)' }}>
            <Box style={{ width: 48, height: 48, borderRadius: 24, background: 'linear-gradient(135deg, #b91c1c 0%, #7f1d1d 100%)', alignItems: 'center', justifyContent: 'center' }}>
              <Text style={{ fontSize: 'card', color: '#fef3c7', bold: true, fontFamily: 'serif' }}>{/* {{章节编号}} */}4</Text>
            </Box>
            <Text style={{ flex: 1, fontSize: 'card', color: '#374151', fontFamily: 'serif' }}>{/* {{章节名}} */}实施计划</Text>
          </Box>
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
