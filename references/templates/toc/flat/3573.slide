<Slide>
  {/* flat/3573 扁平风-彩虹条：上下彩虹色条，白卡+渐变数字块+彩色细条 */}
  <Box style={{ height: 720, width: 1280, background: 'bg', position: 'relative' }}>
    <Box style={{ position: 'absolute', top: 0, left: 0, right: 0, height: 8, background: 'linear-gradient(90deg, #EF4444 0%, #F59E0B 25%, #22C55E 50%, #3B82F6 75%, #A855F7 100%)' }} />
    <Box style={{ position: 'absolute', bottom: 0, left: 0, right: 0, height: 8, background: 'linear-gradient(90deg, #EF4444 0%, #F59E0B 25%, #22C55E 50%, #3B82F6 75%, #A855F7 100%)' }} />
    <Box style={{ height: 720, justifyContent: 'center', padding: 'xxl xl' }}>
      <Text style={{ fontSize: 'title', color: 'text', bold: true, marginBottom: 40, textAlign: 'center' }}>{/* {{替换：标题}} */}目录</Text>
      {[
        ['1', '项目背景', '#EF4444'],
        ['2', '核心功能', '#F59E0B'],
        ['3', '技术架构', '#22C55E'],
        ['4', '实施计划', '#3B82F6'],
      ].map((x, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 'lg', background: '#FFFFFF', borderRadius: 'md', padding: 'md', marginBottom: 20, boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
          <Box style={{ width: 6, height: 64, background: x[2], borderRadius: 3 }} />
          <Box style={{ width: 64, height: 64, background: 'linear-gradient(135deg, #EF4444 0%, #A855F7 100%)', borderRadius: 'md', alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>{x[0]}</Text>
          </Box>
          <Text style={{ fontSize: 'card', color: '#111827', bold: true }}>{/* {{章节名}} */}{x[1]}</Text>
        </Box>
      ))}
    </Box>
  </Box>
</Slide>
