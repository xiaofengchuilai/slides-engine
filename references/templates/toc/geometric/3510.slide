<Slide>
  {/* geometric/3510 几何风-六边形蜂巢：深紫底，六边形(Shape hexagon)章节块蜂巢排布 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #312E81 0%, #581C87 100%)' }}>
    <Box style={{ height: 720, justifyContent: 'center', alignItems: 'center', padding: 'xxl xl' }}>
      <Text style={{ fontSize: 'title', color: '#FFFFFF', bold: true, marginBottom: 48, textAlign: 'center' }}>{/* {{替换：标题}} */}TABLE OF CONTENTS</Text>
      <Box style={{ flexDirection: 'row', justifyContent: 'center' }}>
        {[
          ['01', '开篇', '#7C3AED'],
          ['02', '分析', '#2563EB'],
          ['03', '方案', '#0891B2'],
          ['04', '总结', '#0D9488'],
        ].map((x, i) => (
          <Box key={i} style={{ alignItems: 'center', marginLeft: i === 0 ? 0 : -24, marginTop: i === 0 ? 0 : -56 }}>
            <Box style={{ width: 128, height: 128, alignItems: 'center', justifyContent: 'center' }}>
              <Shape type="hexagon" style={{ position: 'absolute', top: 0, left: 0, width: 128, height: 128, fill: x[2] }} />
              <Box style={{ alignItems: 'center' }}>
                <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>{/* {{章节号}} */}{x[0]}</Text>
                <Text style={{ fontSize: 'body', color: '#FFFFFF', marginTop: 4 }}>{/* {{章节名}} */}{x[1]}</Text>
              </Box>
            </Box>
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
</Slide>
