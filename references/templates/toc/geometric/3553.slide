<Slide>
  {/* geometric/3553 几何风-多边形：深紫底，半透明白行+六边形(Shape hexagon)渐变数字块 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #312E81 0%, #6B21A8 50%, #9D174D 100%)' }}>
    {/* 背景多边形装饰 */}
    <Shape type="pentagon" style={{ position: 'absolute', top: 80, right: 80, width: 128, height: 128, fill: '#EAB308', opacity: 0.15 }} />
    <Shape type="hexagon" style={{ position: 'absolute', bottom: 80, left: 80, width: 160, height: 160, fill: '#06B6D4', opacity: 0.15 }} />
    <Box style={{ height: 720, justifyContent: 'center', padding: 'xxl xl' }}>
      <Text style={{ fontSize: 'title', color: '#FFFFFF', bold: true, marginBottom: 40, textAlign: 'center' }}>{/* {{替换：标题}} */}目录</Text>
      {[
        ['1', '项目背景'],
        ['2', '核心功能'],
        ['3', '技术架构'],
        ['4', '实施计划'],
      ].map((x, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 'lg', background: '#FFFFFF', opacity: 0.12, padding: 'md', marginBottom: 20 }}>
          <Box style={{ width: 64, height: 64, alignItems: 'center', justifyContent: 'center' }}>
            <Shape type="hexagon" style={{ position: 'absolute', top: 0, left: 0, width: 64, height: 64, fill: 'linear-gradient(135deg, #EAB308 0%, #EC4899 100%)', boxShadow: '0 12px 36px rgba(0,0,0,0.22)' }} />
            <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>{x[0]}</Text>
          </Box>
          <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>{/* {{章节名}} */}{x[1]}</Text>
        </Box>
      ))}
    </Box>
  </Box>
</Slide>
