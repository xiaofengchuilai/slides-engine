<Slide>
  {/* geometric/3554 几何风-平行四边形：橙红底，斜切标题 + 平行四边形(Shape)章节行 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FFEDD5 0%, #FEE2E2 100%)' }}>
    <Box style={{ height: 720, justifyContent: 'center', padding: 'xxl xl' }}>
      <Box style={{ alignItems: 'center', marginBottom: 40 }}>
        <Box style={{ background: '#FFFFFF', paddingTop: 20, paddingBottom: 20, paddingLeft: 40, paddingRight: 40, boxShadow: '0 16px 48px rgba(0,0,0,0.28)' }}>
          <Text style={{ fontSize: 'title', color: '#9A3412', bold: true, textAlign: 'center' }}>{/* {{替换：标题}} */}目录</Text>
        </Box>
      </Box>
      {[
        ['1', '项目背景'],
        ['2', '核心功能'],
        ['3', '技术架构'],
        ['4', '实施计划'],
      ].map((x, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 'lg', marginBottom: 20 }}>
          <Box style={{ width: 64, height: 64, alignItems: 'center', justifyContent: 'center' }}>
            <Shape type="parallelogram" style={{ position: 'absolute', top: 0, left: 0, width: 64, height: 64, fill: '#FFFFFF', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }} />
            <Text style={{ fontSize: 'card', color: '#9A3412', bold: true }}>{x[0]}</Text>
          </Box>
          <Box style={{ flex: 1, alignItems: 'center', justifyContent: 'center', paddingTop: 12, paddingBottom: 12 }}>
            <Shape type="parallelogram" style={{ position: 'absolute', top: 0, left: 0, right: 0, bottom: 0, fill: 'linear-gradient(90deg, #F97316 0%, #EF4444 100%)', boxShadow: '0 12px 36px rgba(0,0,0,0.22)' }} />
            <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>{/* {{章节名}} */}{x[1]}</Text>
          </Box>
        </Box>
      ))}
    </Box>
  </Box>
</Slide>
