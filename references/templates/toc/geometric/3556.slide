<Slide>
  {/* geometric/3556 几何风-波浪线条：浅蓝紫粉底，白卡+圆形渐变数字（波浪 SVG 降级为浅色圆点） */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #EFF6FF 0%, #F5F3FF 50%, #FDF2F8 100%)', position: 'relative' }}>
    {/* 波浪装饰降级：浅色圆形色块 */}
    <Shape type="ellipse" style={{ position: 'absolute', top: 120, left: 0, width: 360, height: 140, fill: '#93C5FD', opacity: 0.15 }} />
    <Shape type="ellipse" style={{ position: 'absolute', bottom: 80, right: 0, width: 300, height: 120, fill: '#F0ABFC', opacity: 0.15 }} />
    <Box style={{ height: 720, justifyContent: 'center', padding: 'xxl xl' }}>
      <Text style={{ fontSize: 'title', color: '#6B21A8', bold: true, marginBottom: 40, textAlign: 'center' }}>{/* {{替换：标题}} */}目录</Text>
      {[
        ['1', '项目背景'],
        ['2', '核心功能'],
        ['3', '技术架构'],
        ['4', '实施计划'],
      ].map((x, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 'lg', background: '#FFFFFF', border: '4px solid #E9D5FF', borderRadius: 16, padding: 'md', marginBottom: 20, boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
          <Box style={{ width: 64, height: 64, borderRadius: 999, background: 'linear-gradient(135deg, #2563EB 0%, #7C3AED 50%, #EC4899 100%)', alignItems: 'center', justifyContent: 'center', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
            <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>{x[0]}</Text>
          </Box>
          <Text style={{ fontSize: 'card', color: 'text', bold: true }}>{/* {{章节名}} */}{x[1]}</Text>
        </Box>
      ))}
    </Box>
  </Box>
</Slide>
