<Slide>
  {/* geometric/3557 几何风-网格交错：浅青绿底，白卡+青绿渐变数字块 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #CCFBF1 0%, #DCFCE7 100%)', position: 'relative' }}>
    {/* 网格装饰：细线菱形 */}
    <Shape type="diamond" style={{ position: 'absolute', top: 20, left: 20, width: 80, height: 80, line: { color: '#14B8A6', width: 2 }, fill: 'none', opacity: 0.08 }} />
    <Shape type="diamond" style={{ position: 'absolute', top: 100, left: 100, width: 80, height: 80, line: { color: '#14B8A6', width: 2 }, fill: 'none', opacity: 0.08 }} />
    <Shape type="diamond" style={{ position: 'absolute', top: 180, left: 180, width: 80, height: 80, line: { color: '#14B8A6', width: 2 }, fill: 'none', opacity: 0.08 }} />
    <Box style={{ height: 720, justifyContent: 'center', padding: 'xxl xl' }}>
      <Box style={{ alignItems: 'center', marginBottom: 40 }}>
        <Box style={{ background: '#FFFFFF', paddingTop: 20, paddingBottom: 20, paddingLeft: 40, paddingRight: 40, boxShadow: '0 12px 36px rgba(0,0,0,0.22)' }}>
          <Text style={{ fontSize: 'title', color: '#134E4A', bold: true, textAlign: 'center' }}>{/* {{替换：标题}} */}目录</Text>
        </Box>
      </Box>
      {[
        ['1', '项目背景'],
        ['2', '核心功能'],
        ['3', '技术架构'],
        ['4', '实施计划'],
      ].reduce((rows, item, idx) => {
        if (idx % 2 === 0) rows.push([]);
        rows[rows.length - 1].push(item);
        return rows;
      }, []).map((row, ri) => (
        <Box key={ri} style={{ flexDirection: 'row', gap: 'lg', marginBottom: 24 }}>
          {row.map((x, i) => (
            <Box key={i} style={{ flex: 1, background: '#FFFFFF', padding: 'xl', boxShadow: '0 12px 36px rgba(0,0,0,0.22)' }}>
              <Box style={{ width: 56, height: 56, background: 'linear-gradient(135deg, #0D9488 0%, #16A34A 100%)', alignItems: 'center', justifyContent: 'center', marginBottom: 12 }}>
                <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true }}>{x[0]}</Text>
              </Box>
              <Text style={{ fontSize: 'card', color: 'text', bold: true }}>{/* {{章节名}} */}{x[1]}</Text>
            </Box>
          ))}
        </Box>
      ))}
    </Box>
  </Box>
</Slide>
