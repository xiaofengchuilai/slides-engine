<Slide>
  {/* literary/3559 文艺风-水彩晕染：粉紫蓝渐变底 + 水彩圆斑 + 白卡章节列表 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FCE7F3 0%, #F3E8FF 50%, #DBEAFE 100%)', padding: 48, position: 'relative' }}>
    {/* 水彩晕染装饰 */}
    <Box style={{ position: 'absolute', top: 80, right: 80, width: 256, height: 256, borderRadius: 128, background: '#f9a8d4', opacity: 0.3 }} />
    <Box style={{ position: 'absolute', bottom: 80, left: 80, width: 288, height: 288, borderRadius: 144, background: '#93c5fd', opacity: 0.3 }} />
    <Box style={{ height: 624, justifyContent: 'center' }}>
      <Text style={{ fontSize: 'title', color: '#4c1d95', bold: true, marginBottom: 32, textAlign: 'center', fontFamily: 'serif' }}>{/* {{标题}} */}目录</Text>
      <Box style={{ gap: 16 }}>
        {[
          ['1', '项目背景'],
          ['2', '核心功能'],
          ['3', '技术架构'],
          ['4', '实施计划'],
        ].map((x, i) => (
          <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 24, background: 'rgba(255,255,255,0.85)', border: '2px solid #e9d5ff', borderRadius: 16, padding: 20, boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
            <Box style={{ width: 64, height: 64, background: 'linear-gradient(135deg, #f472b6 0%, #8b5cf6 100%)', borderRadius: 32, alignItems: 'center', justifyContent: 'center', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
              <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true, fontFamily: 'serif' }}>{/* {{章节编号}} */}{x[0]}</Text>
            </Box>
            <Text style={{ fontSize: 'card', color: '#374151', fontFamily: 'serif' }}>{/* {{章节名}} */}{x[1]}</Text>
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
</Slide>
