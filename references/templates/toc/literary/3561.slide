<Slide>
  {/* literary/3561 文艺风-花边装饰：粉紫渐变底 + 四角花饰点 + 虚线框标题 + 粉卡章节 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FFF1F2 0%, #FDF2F8 50%, #FAF5FF 100%)', padding: 48, position: 'relative' }}>
    {/* 四角花饰（降级为圆点组合） */}
    <Box style={{ position: 'absolute', top: 40, left: 40, flexDirection: 'row', gap: 4 }}>
      <Box style={{ width: 12, height: 12, borderRadius: 6, background: '#f9a8d4', opacity: 0.5 }} />
      <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#f9a8d4', opacity: 0.5 }} />
    </Box>
    <Box style={{ position: 'absolute', top: 40, right: 40, flexDirection: 'row', gap: 4 }}>
      <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#d8b4fe', opacity: 0.5 }} />
      <Box style={{ width: 12, height: 12, borderRadius: 6, background: '#d8b4fe', opacity: 0.5 }} />
    </Box>
    <Box style={{ position: 'absolute', bottom: 40, left: 40, flexDirection: 'row', gap: 4 }}>
      <Box style={{ width: 12, height: 12, borderRadius: 6, background: '#fda4af', opacity: 0.5 }} />
      <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#fda4af', opacity: 0.5 }} />
    </Box>
    <Box style={{ position: 'absolute', bottom: 40, right: 40, flexDirection: 'row', gap: 4 }}>
      <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#f9a8d4', opacity: 0.5 }} />
      <Box style={{ width: 12, height: 12, borderRadius: 6, background: '#f9a8d4', opacity: 0.5 }} />
    </Box>
    <Box style={{ height: 624, justifyContent: 'center' }}>
      <Box style={{ alignItems: 'center', marginBottom: 32 }}>
        <Box style={{ border: '4px dashed #f472b6', background: '#FFFFFF', padding: 20, paddingLeft: 40, paddingRight: 40, boxShadow: '0 12px 36px rgba(0,0,0,0.22)' }}>
          <Text style={{ fontSize: 'title', color: '#881337', bold: true, fontFamily: 'serif' }}>{/* {{标题}} */}目录</Text>
        </Box>
      </Box>
      <Box style={{ gap: 16 }}>
        {[
          ['1', '项目背景'],
          ['2', '核心功能'],
          ['3', '技术架构'],
          ['4', '实施计划'],
        ].map((x, i) => (
          <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 24, background: '#FFFFFF', border: '4px solid #fbcfe8', borderRadius: 16, padding: 20, position: 'relative', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
            <Box style={{ width: 64, height: 64, background: 'linear-gradient(135deg, #f43f5e 0%, #ec4899 100%)', borderRadius: 32, alignItems: 'center', justifyContent: 'center' }}>
              <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true, fontFamily: 'serif' }}>{/* {{章节编号}} */}{x[0]}</Text>
            </Box>
            <Box style={{ position: 'absolute', top: -8, right: -8, width: 16, height: 16, borderRadius: 8, background: '#ec4899' }} />
            <Text style={{ fontSize: 'card', color: '#374151', fontFamily: 'serif' }}>{/* {{章节名}} */}{x[1]}</Text>
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
</Slide>
