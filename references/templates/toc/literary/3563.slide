<Slide>
  {/* literary/3563 文艺风-墨迹泼洒：浅灰渐变底 + 墨点装饰 + 白卡章节（编号块+墨点） */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #F1F5F9 0%, #E5E7EB 100%)', padding: 48, position: 'relative' }}>
    {/* 墨迹装饰 */}
    <Box style={{ position: 'absolute', top: 80, right: 80, width: 192, height: 192, borderRadius: 96, background: '#1e293b', opacity: 0.08 }} />
    <Box style={{ position: 'absolute', bottom: 80, left: 80, width: 224, height: 224, borderRadius: 112, background: '#111827', opacity: 0.08 }} />
    <Box style={{ height: 624, justifyContent: 'center' }}>
      <Box style={{ alignItems: 'center', marginBottom: 32 }}>
        <Box style={{ background: '#FFFFFF', padding: 20, paddingLeft: 40, paddingRight: 40, border: '1px solid #E5E7EB', boxShadow: '0 16px 48px rgba(0,0,0,0.28)' }}>
          <Text style={{ fontSize: 'title', color: '#111827', bold: true, fontFamily: 'serif' }}>{/* {{标题}} */}目录</Text>
        </Box>
      </Box>
      <Box style={{ gap: 16 }}>
        {[
          ['1', '项目背景'],
          ['2', '核心功能'],
          ['3', '技术架构'],
          ['4', '实施计划'],
        ].map((x, i) => (
          <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 24, background: '#FFFFFF', borderRadius: 8, border: '1px solid #E5E7EB', padding: 20, position: 'relative', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
            <Box style={{ position: 'relative', width: 64, height: 64 }}>
              <Box style={{ width: 64, height: 64, background: '#111827', alignItems: 'center', justifyContent: 'center', rotate: -6 }}>
                <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true, fontFamily: 'serif' }}>{/* {{章节编号}} */}{x[0]}</Text>
              </Box>
              <Box style={{ position: 'absolute', top: -8, right: -8, width: 16, height: 16, borderRadius: 8, background: '#111827' }} />
              <Box style={{ position: 'absolute', bottom: -4, left: -4, width: 12, height: 12, borderRadius: 6, background: '#374151' }} />
            </Box>
            <Text style={{ fontSize: 'card', color: '#374151', fontFamily: 'serif' }}>{/* {{章节名}} */}{x[1]}</Text>
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
</Slide>
