<Slide>
  {/* literary/3564 文艺风-信纸格纹：黄米浅底 + 横线格纹 + 左侧琥珀条白卡章节 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FEFCE8 0%, #FFFBEB 100%)', padding: 48, position: 'relative' }}>
    {/* 横线格纹背景 */}
    <Box style={{ position: 'absolute', top: 0, left: 0, right: 0, bottom: 0, background: 'repeating-linear-gradient(180deg, rgba(217,119,6,0) 0px, rgba(217,119,6,0) 39px, rgba(217,119,6,0.2) 39px, rgba(217,119,6,0.2) 40px)', opacity: 0.6 }} />
    <Box style={{ height: 624, justifyContent: 'center' }}>
      <Box style={{ alignItems: 'center', marginBottom: 32 }}>
        <Box style={{ background: '#FFFFFF', padding: 12, paddingLeft: 40, paddingRight: 40, boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
          <Text style={{ fontSize: 'title', color: '#78350f', bold: true, fontFamily: 'serif' }}>{/* {{标题}} */}目录</Text>
        </Box>
      </Box>
      <Box style={{ gap: 16 }}>
        {[
          ['1', '项目背景'],
          ['2', '核心功能'],
          ['3', '技术架构'],
          ['4', '实施计划'],
        ].map((x, i) => (
          <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 24, background: 'rgba(255,255,255,0.9)', padding: 20, position: 'relative', border: '1px solid #F5F0E0', boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
            <Box style={{ position: 'absolute', left: 0, top: 0, bottom: 0, width: 4, background: '#b45309' }} />
            <Box style={{ width: 56, height: 56, background: '#b45309', alignItems: 'center', justifyContent: 'center' }}>
              <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true, fontFamily: 'serif' }}>{/* {{章节编号}} */}{x[0]}</Text>
            </Box>
            <Text style={{ fontSize: 'card', color: '#374151', fontFamily: 'serif' }}>{/* {{章节名}} */}{x[1]}</Text>
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
</Slide>
