<Slide>
  {/* literary/3566 文艺风-拼贴画：青绿米浅底 + 纸片装饰 + 2x2 拼贴章节卡 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #F7FEE7 0%, #DCFCE7 50%, #F0FDFA 100%)', padding: 48, position: 'relative' }}>
    {/* 纸片装饰 */}
    <Box style={{ position: 'absolute', top: 80, left: 80, width: 128, height: 128, background: '#fef08a', opacity: 0.4, rotate: 12 }} />
    <Box style={{ position: 'absolute', bottom: 80, right: 80, width: 160, height: 160, background: '#fbcfe8', opacity: 0.4, rotate: -12 }} />
    <Box style={{ height: 624, justifyContent: 'center' }}>
      <Box style={{ alignItems: 'center', marginBottom: 32 }}>
        <Box style={{ background: '#FFFFFF', border: '4px dashed #4ade80', padding: 20, paddingLeft: 40, paddingRight: 40, boxShadow: '0 16px 48px rgba(0,0,0,0.28)' }}>
          <Text style={{ fontSize: 'title', color: '#14532d', bold: true, fontFamily: 'serif' }}>{/* {{标题}} */}目录</Text>
        </Box>
      </Box>
      <Box style={{ gap: 20 }}>
        <Box style={{ flexDirection: 'row', gap: 20 }}>
          <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E5E7EB', padding: 20, position: 'relative', boxShadow: '0 12px 36px rgba(0,0,0,0.22)' }}>
            <Box style={{ position: 'absolute', top: 8, right: 8, width: 24, height: 24, background: '#fde047', opacity: 0.5 }} />
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
              <Box style={{ width: 56, height: 56, background: 'linear-gradient(135deg, #16a34a 0%, #0d9488 100%)', alignItems: 'center', justifyContent: 'center', rotate: -6 }}>
                <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true, fontFamily: 'serif' }}>{/* {{章节编号}} */}1</Text>
              </Box>
              <Text style={{ flex: 1, fontSize: 'body', color: '#374151', fontFamily: 'serif' }}>{/* {{章节名}} */}项目背景</Text>
            </Box>
          </Box>
          <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E5E7EB', padding: 20, position: 'relative' }}>
            <Box style={{ position: 'absolute', top: 8, right: 8, width: 24, height: 24, background: '#bbf7d0', opacity: 0.5 }} />
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
              <Box style={{ width: 56, height: 56, background: 'linear-gradient(135deg, #16a34a 0%, #0d9488 100%)', alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true, fontFamily: 'serif' }}>{/* {{章节编号}} */}2</Text>
              </Box>
              <Text style={{ flex: 1, fontSize: 'body', color: '#374151', fontFamily: 'serif' }}>{/* {{章节名}} */}核心功能</Text>
            </Box>
          </Box>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 20 }}>
          <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E5E7EB', padding: 20, position: 'relative' }}>
            <Box style={{ position: 'absolute', top: 8, right: 8, width: 24, height: 24, background: '#a7f3d0', opacity: 0.5 }} />
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
              <Box style={{ width: 56, height: 56, background: 'linear-gradient(135deg, #16a34a 0%, #0d9488 100%)', alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true, fontFamily: 'serif' }}>{/* {{章节编号}} */}3</Text>
              </Box>
              <Text style={{ flex: 1, fontSize: 'body', color: '#374151', fontFamily: 'serif' }}>{/* {{章节名}} */}技术架构</Text>
            </Box>
          </Box>
          <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E5E7EB', padding: 20, position: 'relative' }}>
            <Box style={{ position: 'absolute', top: 8, right: 8, width: 24, height: 24, background: '#99f6e4', opacity: 0.5 }} />
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
              <Box style={{ width: 56, height: 56, background: 'linear-gradient(135deg, #16a34a 0%, #0d9488 100%)', alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ fontSize: 'card', color: '#FFFFFF', bold: true, fontFamily: 'serif' }}>{/* {{章节编号}} */}4</Text>
              </Box>
              <Text style={{ flex: 1, fontSize: 'body', color: '#374151', fontFamily: 'serif' }}>{/* {{章节名}} */}实施计划</Text>
            </Box>
          </Box>
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
