<Slide>
  {/* minimalist/3522 简约风-极简卡片：标题行 + 4 张白卡 */}
  <Box style={{ height: 720, width: 1280, background: 'cardBg', padding: 48 }}>
    <Box style={{ height: 624, justifyContent: 'center' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', marginBottom: 40 }}>
        <Text style={{ fontSize: 'title', color: 'text', bold: true }}>{/* {{标题}} */}目录</Text>
        <Text style={{ fontSize: 'label', color: 'muted', letterSpacing: 2 }}>Contents</Text>
      </Box>
      <Box style={{ flexDirection: 'row', gap: 20 }}>
        {[
          ['1', '项目背景'],
          ['2', '核心功能'],
          ['3', '技术架构'],
          ['4', '实施计划'],
        ].map((x, i) => (
          <Box key={i} style={{ flex: 1, background: 'bg', padding: 20, boxShadow: '0 8px 24px rgba(0,0,0,0.18)' }}>
            <Box style={{ width: 48, height: 48, background: 'line', alignItems: 'center', justifyContent: 'center', marginBottom: 12 }}>
              <Text style={{ fontSize: 'body', color: 'muted', bold: true }}>{x[0]}</Text>
            </Box>
            <Text style={{ fontSize: 'body', color: 'text', bold: true }}>{/* {{章节名}} */}{x[1]}</Text>
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
</Slide>
