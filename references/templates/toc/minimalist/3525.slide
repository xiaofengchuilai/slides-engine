<Slide>
  {/* minimalist/3525 简约风-左右分栏：左侧深色标题栏 + 右侧圆点编号章节 */}
  <Box style={{ height: 720, width: 1280, background: 'bg', flexDirection: 'row' }}>
    <Box style={{ width: 512, background: 'text', justifyContent: 'center', paddingLeft: 48, paddingRight: 48 }}>
      <Text style={{ fontSize: 'title', color: '#FFFFFF', bold: true, marginBottom: 24 }}>{/* {{标题}} */}目录</Text>
      <Text style={{ fontSize: 'label', color: '#FFFFFF', opacity: 0.6, letterSpacing: 2 }}>CONTENTS</Text>
    </Box>
    <Box style={{ flex: 1, justifyContent: 'center', paddingLeft: 48, paddingRight: 48 }}>
      <Box style={{ gap: 24 }}>
        {[
          ['1', '项目背景'],
          ['2', '核心功能'],
          ['3', '技术架构'],
          ['4', '实施计划'],
        ].map((x, i) => (
          <Box key={i} style={{ flexDirection: 'row', gap: 16, alignItems: 'center' }}>
            <Box style={{ width: 32, height: 32, borderRadius: 16, border: '2px solid line', alignItems: 'center', justifyContent: 'center' }}>
              <Text style={{ fontSize: 'label', color: 'muted' }}>{x[0]}</Text>
            </Box>
            <Text style={{ fontSize: 'card', color: 'text', bold: true }}>{/* {{章节名}} */}{x[1]}</Text>
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
</Slide>
