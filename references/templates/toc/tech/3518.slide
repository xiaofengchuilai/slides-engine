<Slide>
  {/* tech/3518 科技风-全息投影：黑底 + 渐变标题 + 4 列编号方块章节 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #000000 0%, #0a0a2e 100%)', padding: 48 }}>
    <Box style={{ height: 624, alignItems: 'center', justifyContent: 'center' }}>
      {/* 标题区 */}
      <Box style={{ alignItems: 'center', marginBottom: 40 }}>
        <Text style={{ fontSize: 'title', color: '#22d3ee', bold: true, letterSpacing: 2, textAlign: 'center' }}>{/* {{标题}} */}TABLE OF CONTENTS</Text>
        <Box style={{ flexDirection: 'row', gap: 8, marginTop: 16 }}>
          <Box style={{ width: 12, height: 12, borderRadius: 6, background: '#22d3ee' }} />
          <Box style={{ width: 12, height: 12, borderRadius: 6, background: '#3b82f6' }} />
          <Box style={{ width: 12, height: 12, borderRadius: 6, background: '#a855f7' }} />
        </Box>
      </Box>
      {/* 4 列章节 */}
      <Box style={{ flexDirection: 'row', gap: 20 }}>
        {[
          ['01', '#22d3ee', 'System Init', '系统初始化'],
          ['02', '#3b82f6', 'Core Logic', '核心逻辑'],
          ['03', '#a855f7', 'Data Flow', '数据流转'],
          ['04', '#4ade80', 'Output', '结果输出'],
        ].map((x, i) => (
          <Box key={i} style={{ flex: 1, alignItems: 'center', position: 'relative' }}>
            <Box style={{ width: 112, height: 112, border: '2px solid ' + x[1], borderRadius: 8, alignItems: 'center', justifyContent: 'center', marginBottom: 16, background: 'rgba(34,211,238,0.05)' }}>
              <Text style={{ fontSize: 'kpi', color: x[1], bold: true }}>{/* {{章节编号}} */}{x[0]}</Text>
            </Box>
            <Box style={{ position: 'absolute', top: 0, right: 8, width: 8, height: 8, borderRadius: 4, background: x[1] }} />
            <Text style={{ fontSize: 'card', color: x[1], bold: true, marginBottom: 8, textAlign: 'center' }}>{/* {{章节名}} */}{x[2]}</Text>
            <Text style={{ fontSize: 'body', color: '#94a3b8', textAlign: 'center' }}>{/* {{章节副标题}} */}{x[3]}</Text>
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
</Slide>
