<Slide>
  {/* tech/3575 科技风-矩阵代码：深紫黑渐变底 + 绿色标题 + 垂直编号列表 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #0d0208 0%, #1a0f1a 100%)', padding: 48 }}>
    <Box style={{ height: 624, alignItems: 'center', justifyContent: 'center' }}>
      <Box style={{ alignItems: 'center', marginBottom: 32 }}>
        <Text style={{ fontSize: 'title', color: '#00ff41', bold: true, letterSpacing: 4 }}>{/* {{标题}} */}CONTENTS</Text>
        <Box style={{ width: 128, height: 3, background: 'linear-gradient(90deg, rgba(0,255,65,0) 0%, #00ff41 50%, rgba(0,255,65,0) 100%)', marginTop: 16 }} />
      </Box>
      <Box style={{ gap: 16, width: 900 }}>
        {[
          ['1', '项目背景', '了解项目的起源与目标'],
          ['2', '核心功能', '产品的主要功能介绍'],
          ['3', '技术架构', '系统设计与技术选型'],
          ['4', '实施计划', '项目的推进与时间安排'],
        ].map((x, i) => (
          <Box key={i} style={{ flexDirection: 'row', gap: 24, alignItems: 'center', border: '1px solid rgba(0,255,65,0.3)', background: 'rgba(0,255,65,0.05)', padding: 16 }}>
            <Box style={{ width: 56, height: 56, border: '2px solid #00ff41', background: 'rgba(0,255,65,0.2)', alignItems: 'center', justifyContent: 'center' }}>
              <Text style={{ fontSize: 'card', color: '#00ff41', bold: true }}>{/* {{章节编号}} */}{x[0]}</Text>
            </Box>
            <Box style={{ flex: 1 }}>
              <Text style={{ fontSize: 'card', color: '#00ff41', bold: true, marginBottom: 4 }}>{/* {{章节名}} */}{x[1]}</Text>
              <Text style={{ fontSize: 'body', color: '#4ade80' }}>{/* {{章节副标题}} */}{x[2]}</Text>
            </Box>
            <Box style={{ width: 80, height: 2, background: 'repeating-linear-gradient(90deg, #00ff41 0px, #00ff41 8px, rgba(0,0,0,0) 8px, rgba(0,0,0,0) 12px)' }} />
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
</Slide>
