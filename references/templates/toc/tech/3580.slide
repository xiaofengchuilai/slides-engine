<Slide>
  {/* tech/3580 科技风-赛博朋克：紫粉黑底 + 霓虹渐变标题 + 左侧标题/右侧列表 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #1a0a2e 0%, #0f0520 100%)', padding: 48, position: 'relative' }}>
    {/* 霓虹灯条 */}
    <Box style={{ position: 'absolute', top: 72, left: 0, right: 0, height: 2, background: 'linear-gradient(90deg, rgba(255,0,255,0) 0%, #ff00ff 40%, #00ffff 60%, rgba(0,255,255,0) 100%)', opacity: 0.6 }} />
    <Box style={{ position: 'absolute', bottom: 108, left: 0, right: 0, height: 2, background: 'linear-gradient(90deg, rgba(0,255,255,0) 0%, #00ffff 40%, #ff00ff 60%, rgba(255,0,255,0) 100%)', opacity: 0.6 }} />
    <Box style={{ height: 624, flexDirection: 'row' }}>
      {/* 左侧标题区 */}
      <Box style={{ width: 420, justifyContent: 'center', paddingRight: 32 }}>
        <Text style={{ fontSize: 'hero', color: '#f0abfc', bold: true, letterSpacing: 6 }}>{/* {{标题}} */}CYBER</Text>
        <Text style={{ fontSize: 'hero', color: '#22d3ee', bold: true, letterSpacing: 6 }}>{/* {{副标题}} */}PUNK</Text>
        <Box style={{ gap: 4, marginTop: 16 }}>
          <Box style={{ width: 280, height: 3, background: 'linear-gradient(90deg, #d946ef 0%, rgba(217,70,239,0) 100%)' }} />
          <Box style={{ width: 200, height: 3, background: 'linear-gradient(90deg, #22d3ee 0%, rgba(34,211,238,0) 100%)' }} />
          <Box style={{ width: 140, height: 3, background: 'linear-gradient(90deg, #d946ef 0%, rgba(217,70,239,0) 100%)' }} />
        </Box>
      </Box>
      {/* 右侧内容区 */}
      <Box style={{ flex: 1, justifyContent: 'center', gap: 12 }}>
        {[
          ['1', '项目背景', '了解项目的起源与目标'],
          ['2', '核心功能', '产品的主要功能介绍'],
          ['3', '技术架构', '系统设计与技术选型'],
          ['4', '实施计划', '项目的推进与时间安排'],
        ].map((x, i) => (
          <Box key={i} style={{ flexDirection: 'row', gap: 20, alignItems: 'center', border: '1px solid rgba(255,0,255,0.5)', background: 'linear-gradient(135deg, rgba(255,0,255,0.1) 0%, rgba(0,255,255,0.05) 100%)', padding: 16, position: 'relative' }}>
            <Box style={{ width: 48, height: 48, background: 'linear-gradient(135deg, rgba(255,0,255,0.3), rgba(0,255,255,0.3))', border: '2px solid #ff00ff', alignItems: 'center', justifyContent: 'center', borderRadius: 8, boxShadow: '0 0 20px rgba(255,0,255,0.4)' }}>
              <Text style={{ fontSize: 'card', color: '#f0abfc', bold: true }}>{/* {{章节编号}} */}{x[0]}</Text>
            </Box>
            <Box style={{ flex: 1 }}>
              <Text style={{ fontSize: 'card', color: '#e879f9', bold: true, marginBottom: 4 }}>{/* {{章节名}} */}{x[1]}</Text>
              <Text style={{ fontSize: 'body', color: '#67e8f9' }}>{/* {{章节副标题}} */}{x[2]}</Text>
            </Box>
            <Box style={{ width: 60, height: 2, background: 'repeating-linear-gradient(90deg, #ff00ff 0px, #ff00ff 6px, rgba(0,0,0,0) 6px, rgba(0,0,0,0) 10px)' }} />
            <Box style={{ position: 'absolute', top: 0, right: 0, width: 10, height: 10, background: '#ff00ff' }} />
            <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 10, height: 10, background: '#00ffff' }} />
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
</Slide>
