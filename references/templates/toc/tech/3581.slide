<Slide>
  {/* tech/3581 科技风-激光矩阵：纯黑红底 + 红色垂直章节列表 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #000000 0%, #1a0000 100%)', padding: 48 }}>
    <Box style={{ height: 624, alignItems: 'center', justifyContent: 'center' }}>
      <Box style={{ alignItems: 'center', marginBottom: 32 }}>
        <Text style={{ fontSize: 'title', color: '#ef4444', bold: true, letterSpacing: 5 }}>{/* {{标题}} */}LASER MATRIX</Text>
        <Box style={{ flexDirection: 'row', gap: 8, alignItems: 'center', marginTop: 16 }}>
          <Box style={{ width: 10, height: 10, borderRadius: 5, background: '#ef4444', boxShadow: '0 0 15px #ff0000' }} />
          <Box style={{ width: 48, height: 3, background: '#ef4444', boxShadow: '0 0 10px #ff0000' }} />
          <Box style={{ width: 10, height: 10, borderRadius: 5, background: '#ef4444', boxShadow: '0 0 15px #ff0000' }} />
        </Box>
      </Box>
      <Box style={{ gap: 16, width: 960 }}>
        {[
          ['1', '项目背景', '了解项目的起源与目标'],
          ['2', '核心功能', '产品的主要功能介绍'],
          ['3', '技术架构', '系统设计与技术选型'],
          ['4', '实施计划', '项目的推进与时间安排'],
        ].map((x, i) => (
          <Box key={i} style={{ flexDirection: 'row', gap: 24, alignItems: 'center', border: '2px solid #ef4444', background: 'rgba(255,0,0,0.05)', padding: 20, position: 'relative', boxShadow: '0 0 20px rgba(255,0,0,0.3)' }}>
            <Box style={{ width: 60, height: 60, border: '3px solid #ef4444', background: 'rgba(255,0,0,0.15)', borderRadius: 30, alignItems: 'center', justifyContent: 'center', boxShadow: '0 0 25px rgba(255,0,0,0.4)' }}>
              <Text style={{ fontSize: 'card', color: '#ef4444', bold: true }}>{/* {{章节编号}} */}{x[0]}</Text>
            </Box>
            <Box style={{ flex: 1 }}>
              <Text style={{ fontSize: 'card', color: '#ef4444', bold: true, marginBottom: 4 }}>{/* {{章节名}} */}{x[1]}</Text>
              <Text style={{ fontSize: 'body', color: '#fca5a5' }}>{/* {{章节副标题}} */}{x[2]}</Text>
            </Box>
            <Box style={{ width: 100, height: 2, background: 'linear-gradient(90deg, #ef4444 0%, rgba(239,68,68,0) 100%)' }} />
            <Box style={{ position: 'absolute', top: 0, left: 0, width: 6, height: 6, background: '#ef4444' }} />
            <Box style={{ position: 'absolute', top: 0, right: 0, width: 6, height: 6, background: '#ef4444' }} />
            <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 6, height: 6, background: '#ef4444' }} />
            <Box style={{ position: 'absolute', bottom: 0, right: 0, width: 6, height: 6, background: '#ef4444' }} />
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
</Slide>
