<Slide>
  {/* tech/3582 科技风-星际航行：深蓝黑底 + 星球点缀 + 垂直章节行 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #1a1a3e 0%, #0a0a1e 50%, #000000 100%)', padding: 48, position: 'relative' }}>
    {/* 星空点缀 */}
    <Box style={{ position: 'absolute', top: 108, left: 80, width: 2, height: 2, borderRadius: 1, background: '#FFFFFF', opacity: 0.8, boxShadow: '0 0 3px #FFFFFF' }} />
    <Box style={{ position: 'absolute', top: 180, right: 160, width: 3, height: 3, borderRadius: 1.5, background: '#60a5fa', opacity: 0.8, boxShadow: '0 0 5px #60a5fa' }} />
    <Box style={{ position: 'absolute', bottom: 216, left: 120, width: 2, height: 2, borderRadius: 1, background: '#FFFFFF', opacity: 0.8, boxShadow: '0 0 3px #FFFFFF' }} />
    <Box style={{ position: 'absolute', top: 324, right: 96, width: 3, height: 3, borderRadius: 1.5, background: '#fbbf24', opacity: 0.8, boxShadow: '0 0 6px #fbbf24' }} />
    <Box style={{ position: 'absolute', bottom: 144, right: 200, width: 2, height: 2, borderRadius: 1, background: '#FFFFFF', opacity: 0.8, boxShadow: '0 0 3px #FFFFFF' }} />
    <Box style={{ position: 'absolute', top: 432, left: 200, width: 2, height: 2, borderRadius: 1, background: '#c084fc', opacity: 0.8, boxShadow: '0 0 4px #c084fc' }} />
    <Box style={{ height: 624, alignItems: 'center', justifyContent: 'center' }}>
      <Box style={{ alignItems: 'center', marginBottom: 28 }}>
        <Text style={{ fontSize: 'title', color: '#93c5fd', bold: true, letterSpacing: 4 }}>{/* {{标题}} */}STAR VOYAGE</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8, marginTop: 16 }}>
          <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#60a5fa' }} />
          <Box style={{ width: 64, height: 2, background: 'linear-gradient(90deg, #60a5fa 0%, #c084fc 50%, #fbbf24 100%)' }} />
          <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#fbbf24' }} />
        </Box>
      </Box>
      <Box style={{ gap: 16, width: 880 }}>
        {[
          ['1', '项目背景', '了解项目的起源与目标'],
          ['2', '核心功能', '产品的主要功能介绍'],
          ['3', '技术架构', '系统设计与技术选型'],
          ['4', '实施计划', '项目的推进与时间安排'],
        ].map((x, i) => (
          <Box key={i} style={{ flexDirection: 'row', gap: 20, alignItems: 'center', border: '1px solid rgba(96,165,250,0.4)', background: 'linear-gradient(135deg, rgba(96,165,250,0.05) 0%, rgba(139,92,246,0.08) 100%)', borderRadius: 8, padding: 16, position: 'relative' }}>
            <Box style={{ width: 55, height: 55, border: '2px solid #60a5fa', borderRadius: 27.5, background: 'rgba(96,165,250,0.2)', alignItems: 'center', justifyContent: 'center' }}>
              <Text style={{ fontSize: 'card', color: '#93c5fd', bold: true }}>{/* {{章节编号}} */}{x[0]}</Text>
            </Box>
            <Box style={{ position: 'absolute', top: 4, right: 4, width: 6, height: 6, borderRadius: 3, background: '#fbbf24' }} />
            <Box style={{ flex: 1 }}>
              <Text style={{ fontSize: 'card', color: '#93c5fd', bold: true, marginBottom: 4 }}>{/* {{章节名}} */}{x[1]}</Text>
              <Text style={{ fontSize: 'body', color: '#c4b5fd' }}>{/* {{章节副标题}} */}{x[2]}</Text>
            </Box>
            <Box style={{ width: 50, height: 1, background: 'linear-gradient(90deg, #60a5fa 0%, #8b5cf6 100%)' }} />
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
</Slide>
