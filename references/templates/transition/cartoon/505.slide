<Slide>
  {/* transition/cartoon/505 卡通风-彩色爆炸：黄粉紫渐变底 + 装饰圆 + 白卡章节块 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FEF9C3 0%, #FCE7F3 50%, #EDE9FE 100%)', padding: 48, position: 'relative' }}>
    {/* 装饰圆 */}
    <Box style={{ position: 'absolute', top: 24, left: 24, width: 128, height: 128, borderRadius: 64, background: '#f9a8d4', opacity: 0.5 }} />
    <Box style={{ position: 'absolute', bottom: 24, right: 24, width: 160, height: 160, borderRadius: 80, background: '#93c5fd', opacity: 0.5 }} />
    <Box style={{ position: 'absolute', top: 48, right: 64, width: 80, height: 80, borderRadius: 40, background: '#fde047', opacity: 0.5 }} />
    <Box style={{ height: 624, alignItems: 'center', justifyContent: 'center' }}>
      <Box style={{ alignItems: 'center' }}>
        <Box style={{ width: 72, height: 72, borderRadius: 36, background: '#ec4899', alignItems: 'center', justifyContent: 'center', marginBottom: 16 }}>
          <Emoji name="🎯" style={{ width: 44, height: 44 }} />
        </Box>
        <Box style={{ background: '#FFFFFF', border: '4px solid #f472b6', borderRadius: 24, padding: 24, paddingLeft: 40, paddingRight: 40, alignItems: 'center', boxShadow: '0 16px 48px rgba(0,0,0,0.28)' }}>
          <Text style={{ fontSize: 'title', color: '#ec4899', bold: true, marginBottom: 8 }}>{/* {{替换：章序号}} */}第一章</Text>
          <Text style={{ fontSize: 'title', color: '#374151', bold: true, marginBottom: 8 }}>{/* {{替换：章节名}} */}项目背景</Text>
          <Text style={{ fontSize: 'body', color: '#6b7280' }}>{/* {{替换：一句章节导语}} */}了解项目的起源与目标</Text>
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
