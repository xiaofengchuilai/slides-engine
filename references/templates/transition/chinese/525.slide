<Slide>
  {/* transition/chinese/525 中国风-梅花点点：米白底 + 四角梅点 + 居中章节（左右红条章序） */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FDFBF7 0%, #F5F1E8 100%)', padding: 48, position: 'relative' }}>
    {/* 梅花点（左上） */}
    <Box style={{ position: 'absolute', top: 40, left: 56, flexDirection: 'row', gap: 8, opacity: 0.5 }}>
      <Box style={{ width: 16, height: 16, borderRadius: 8, background: '#C41E3A' }} />
      <Box style={{ width: 12, height: 12, borderRadius: 6, background: '#C41E3A' }} />
    </Box>
    <Box style={{ position: 'absolute', top: 70, left: 96, width: 12, height: 12, borderRadius: 6, background: '#C41E3A', opacity: 0.5 }} />
    {/* 梅花点（右下） */}
    <Box style={{ position: 'absolute', bottom: 40, right: 56, flexDirection: 'row', gap: 8, opacity: 0.5 }}>
      <Box style={{ width: 16, height: 16, borderRadius: 8, background: '#C41E3A' }} />
      <Box style={{ width: 12, height: 12, borderRadius: 6, background: '#C41E3A' }} />
    </Box>
    {/* 印章（右侧） */}
    <Box style={{ position: 'absolute', top: 328, right: 40, width: 56, height: 56, background: 'linear-gradient(135deg, #C41E3A 0%, #8B1428 100%)', alignItems: 'center', justifyContent: 'center', opacity: 0.7, rotate: 8 }}>
      <Text style={{ fontSize: 'label', color: '#FFFFFF', bold: true, fontFamily: 'serif' }}>{/* {{印章字}} */}雅</Text>
    </Box>
    <Box style={{ height: 624, alignItems: 'center', justifyContent: 'center' }}>
      <Box style={{ alignItems: 'center' }}>
        <Box style={{ background: 'rgba(139,69,19,0.08)', padding: 8, paddingLeft: 40, paddingRight: 40, marginBottom: 24, position: 'relative' }}>
          <Box style={{ position: 'absolute', left: 0, top: 0, bottom: 0, width: 3, background: '#8b4513' }} />
          <Box style={{ position: 'absolute', right: 0, top: 0, bottom: 0, width: 3, background: '#8b4513' }} />
          <Text style={{ fontSize: 'card', color: '#8b4513', letterSpacing: 8, fontFamily: 'serif' }}>{/* {{替换：章序号}} */}第一章</Text>
        </Box>
        <Text style={{ fontSize: 'title', color: '#2d2d2d', bold: true, fontFamily: 'serif', marginBottom: 24 }}>{/* {{替换：章节名}} */}项目背景</Text>
        <Text style={{ fontSize: 'body', color: '#666666', fontFamily: 'serif' }}>{/* {{替换：一句章节导语}} */}了解项目的起源与目标</Text>
      </Box>
    </Box>
  </Box>
</Slide>
