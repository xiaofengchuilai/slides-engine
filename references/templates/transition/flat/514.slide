<Slide>
  {/* transition/flat/514 分层色带：白底上下青/绿色带，中置"第一章"+章节名+三色圆点 */}
  <Box style={{ height: 720, width: 1280, background: 'bg', position: 'relative' }}>
    <Box style={{ position: 'absolute', top: 0, left: 0, right: 0, height: 48, background: 'linear-gradient(90deg, #3B82F6 0%, #06B6D4 100%)' }} />
    <Box style={{ position: 'absolute', bottom: 0, left: 0, right: 0, height: 48, background: 'linear-gradient(90deg, #22C55E 0%, #10B981 100%)' }} />
    <Box style={{ flex: 1, alignItems: 'center', justifyContent: 'center' }}>
      <Text style={{ fontSize: 'title', color: '#D1D5DB', bold: true, marginBottom: 16 }}>{/* {{替换：章节标识}} */}第一章</Text>
      <Text style={{ fontSize: 'title', color: 'text', bold: true, marginBottom: 12 }}>{/* {{替换：章节名}} */}项目背景</Text>
      <Box style={{ flexDirection: 'row', gap: 12 }}>
        <Box style={{ width: 64, height: 8, borderRadius: 4, background: '#3B82F6' }} />
        <Box style={{ width: 64, height: 8, borderRadius: 4, background: '#22C55E' }} />
        <Box style={{ width: 64, height: 8, borderRadius: 4, background: '#F97316' }} />
      </Box>
    </Box>
  </Box>
</Slide>
