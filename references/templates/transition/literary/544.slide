<Slide>
  {/* transition/literary/544 文艺风-水彩边框：粉米黄渐变底 + 双层圆角边框 + 章序/章节名 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FFF1F2 0%, #FFFBEB 50%, #FEFCE8 100%)', padding: 48 }}>
    <Box style={{ height: 624, alignItems: 'center', justifyContent: 'center', position: 'relative' }}>
      {/* 水彩边框（双层） */}
      <Box style={{ position: 'absolute', top: 24, left: 24, right: 24, bottom: 24, border: '8px solid rgba(252,211,77,0.4)', borderRadius: 24 }} />
      <Box style={{ position: 'absolute', top: 40, left: 40, right: 40, bottom: 40, border: '4px solid rgba(253,164,175,0.3)', borderRadius: 16 }} />
      <Box style={{ alignItems: 'center' }}>
        <Emoji name="🎨" style={{ width: 56, height: 56, marginBottom: 24 }} />
        <Text style={{ fontSize: 'title', color: '#92400e', bold: true, fontFamily: 'serif', marginBottom: 24 }}>{/* {{替换：章序号}} */}第一章</Text>
        <Text style={{ fontSize: 'title', color: '#374151', bold: true, marginBottom: 16, fontFamily: 'serif' }}>{/* {{替换：章节名}} */}项目背景</Text>
        <Text style={{ fontSize: 'body', color: '#b45309', fontFamily: 'serif' }}>{/* {{替换：一句章节导语}} */}了解项目的起源与目标</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, marginTop: 24 }}>
          <Box style={{ width: 80, height: 1, background: '#fbbf24' }} />
          <Box style={{ width: 12, height: 12, border: '1px solid #d97706', borderRadius: 6 }} />
          <Box style={{ width: 80, height: 1, background: '#fbbf24' }} />
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
