<Slide>
  {/* transition/literary/546 文艺风-咖啡主题：琥珀橙浅底 + 虚线白卡 + 章序/章节名 */}
  <Box style={{ height: 720, width: 1280, background: 'linear-gradient(135deg, #FFFBEB 0%, #FFEDD5 100%)', padding: 48 }}>
