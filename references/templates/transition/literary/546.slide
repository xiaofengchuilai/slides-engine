      <Box style={{ background: 'rgba(255,255,255,0.85)', border: '4px dashed #fbbf24', borderRadius: 24, padding: 48, paddingLeft: 96, paddingRight: 96, alignItems: 'center', boxShadow: '0 16px 48px rgba(0,0,0,0.28)' }}>
        <Emoji name="☕" style={{ width: 56, height: 56, marginBottom: 24 }} />
