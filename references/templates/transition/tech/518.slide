<Slide>
  {/* transition/tech/518 科技风-数字矩阵：黑底 + 居中边框块 + 章节号/名/导语 */}
  <Box style={{ height: 720, width: 1280, background: '#000000', padding: 48 }}>
    <Box style={{ height: 624, alignItems: 'center', justifyContent: 'center' }}>
      <Box style={{ alignItems: 'center' }}>
        <Box style={{ border: '4px solid #22d3ee', background: 'rgba(0,0,0,0.6)', padding: 24, paddingLeft: 40, paddingRight: 40, marginBottom: 24 }}>
          <Text style={{ fontSize: 'title', color: '#22d3ee', bold: true, marginBottom: 12 }}>{/* {{替换：章序号}} */}第一章</Text>
          <Text style={{ fontSize: 'title', color: '#FFFFFF', bold: true, marginBottom: 8 }}>{/* {{替换：章节名}} */}项目背景</Text>
          <Text style={{ fontSize: 'body', color: '#22d3ee' }}>{/* {{替换：一句章节导语}} */}了解项目的起源与目标</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
          <Box style={{ width: 48, height: 3, background: 'linear-gradient(90deg, rgba(0,0,0,0) 0%, #22d3ee 100%)' }} />
          <Box style={{ width: 12, height: 12, border: '2px solid #22d3ee', rotate: 45 }} />
          <Box style={{ width: 48, height: 3, background: 'linear-gradient(270deg, rgba(0,0,0,0) 0%, #22d3ee 100%)' }} />
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
