    {/* 全息圆环 */}
    <Box style={{ position: 'absolute', top: 180, left: 470, width: 340, height: 340, borderRadius: 170, border: '2px solid rgba(34,211,238,0.4)' }} />
    <Box style={{ position: 'absolute', top: 210, left: 500, width: 280, height: 280, borderRadius: 140, border: '2px solid rgba(192,132,252,0.5)' }} />
    <Box style={{ position: 'absolute', top: 240, left: 530, width: 220, height: 220, borderRadius: 110, border: '2px solid rgba(244,114,182,0.6)' }} />
    <Box style={{ height: 624, alignItems: 'center', justifyContent: 'center' }}>
      <Box style={{ alignItems: 'center' }}>
        <Text style={{ fontSize: 'hero', color: '#22d3ee', bold: true, marginBottom: 24 }}>{/* {{替换：章节号 01-0N}} */}01</Text>
